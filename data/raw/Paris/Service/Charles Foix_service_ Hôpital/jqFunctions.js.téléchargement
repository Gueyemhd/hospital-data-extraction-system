	function searchOS() {



		var query = $("#qSearch").val();
		if (query == "" || query == "Taper un ou plusieurs mots-clés...")
			return false;
		$("#oResults").html("<span id='enc'>Traitement en cours...</span>").fadeIn(500);
		//var result = "Traitement en cours...";


		if (query.length == 0)
			$("#oResults").html("Veuillez saisir un ou plusieurs mots-clés, svp...").fadeIn(500);
		else if (query.length < 3)
			$("#oResults").html("Veuillez saisir au moins 3 caractères...").fadeIn(500);
		else {
			$("#oResults").html("<a id='closeAllResults' class='button btnWhite' style=''>Fermer</a>");
			$("#oResults").append("<div id='linkConsults' style='padding : 40px 20px;clear:both;float:right' ><a class='leftBox' title=\"Ce lien va s'ouvrir dans une nouvelle fenêtre\" target='_blank' href='"+jqFunctionsi18n.wp_base_url+"/consultations/?mots=" + query + "&s_hopital='>Trouver des consulations avec le terme  <strong>" + query + "</strong> ? </a></div><div class='clr'></div>");
			$("#sStruct a").each(function(i) {

				if ($(this).hasClass("btnGreenChoice")) {

					if ($(this).html() == "Services")
						searchServices(query, 0);
					if ($(this).html() == "Pôles")
						searchPoles(query, 0);
					if ($(this).html() == "Hôpitaux")
						searchHopitaux(query, 0);
					if ($(this).html() == "Médecins")
						searchMedecins(query, 0);


				}

			});


		}
		//$("#oResults").html(result).fadeIn(500);	

	}

