// tooltipinput function, autoload no config
// Home Widget
(function() {
	/* CONFIG */
	var toolWidget_xOffset = 271;
	var toolWidget_yOffset = 0;
	// these 2 variable determine popup's distance from the cursor
	// you might want to adjust to get the right result
	/* END CONFIG */
	jQuery('.widget-search-consultation input').focusin( function() {
		if ( jQuery(this).attr('readonly') == 'readonly' || this.title == '' )
			return false;
			
		var pos = jQuery(this).offset();
		
		this.t = this.title;
		this.title = "";
		jQuery("body").append("<div id='tooltipinput'>" + this.t + "</div>");
		jQuery("#tooltipinput").css({
			"top" : Math.floor( pos.top - toolWidget_yOffset ) + "px",
			"left" : Math.floor( pos.left - toolWidget_xOffset ) + "px",
			'position' : "absolute",
			"z-index" : 100,
			"width": '250px'
		}).fadeIn("fast");
	}).focusout( function(e) {
		this.title = this.t;
		jQuery("#tooltipinput").remove();
	});
} )();

