 694.74)" dx="0 0 0.08 0 -0.11 0.05 0 0 0.05 0 -0.14 0.05 0 0.05 -0.10 0 -0.14 0 0 0 0 0.03 0.05 4.69 0 -0.16 0.05 0 0 0.05 0 -0.06">la rampe de la porte 19(Sergent)</text><text class="ff5 fc1" transform="matrix(1.43 0 0 1.43 134.60 738.07)" dx="0 0 0 0 0.05 0.05 0.05 -0.13 0.05 0 0 -0.07 0.05 0 0 0 0.03 -0.10 0 0 -0.11 0.05 -0.16 0.05 0.10 0.05 0.05 -0.13 -0.13 0.18 0.05 0 0 -0.07 0 0 -0.10 0.05">Des détecteurs de mouvement facilitent </text><text class="ff6 fc1" transform="matrix(1.43 0 0 1.43 541.71 738.07)" dx="0 0 -0.06 0.05 0.05 -0.16 0.05 0 0 0.03 0 0 0 -0.05 0.05 0 0 -0.06 0.05 0 0 0.03">l’ouverture des portes</text><text class="ff5 fc1" transform="matrix(1.43 0 0 1.43 767.29 738.07)" dx="0 0.05 0.05 -0.13 -0.10 0.10 0.05 0 0 -0.10 0.05 0.05 0.14 -0.13">automatiques. </text><text class="ff3 fc2" transform="matrix(1.43 0 0 1.43 168.80 781.62)" dx="0 0.29 7.71 0.40 0.11 0.34 0.35 0.26">D.WC PMR</text><text class="ff5 fc1" transform="matrix(1.43 0 0 1.43 134.60 809.22)" dx="0 0 0 -0.57 0.56">Un WC</text><text class="ff6 fc1" transform="matrix(1.43 0 0 1.43 213.95 809.22)" dx="0 0.03 -0.05 0 -0.32 -0.16 0 0 -0.06 0 0.08 0.05 0 -0.34 0.05 0 0 -0.26 0 0 0 0.05 0.05 -0.29 0.05 -0.29 0.05 0 0 -0.14 0 0.06 0 0 0.05 -0.29 0.05 0.05 -0.45 0.05 0.05 0 0 -0.08 0.05 -0.29 0.05 0.05 -0.29 0 -0.06 0.05 0 0 0 0 0 -0.10 0.05 0 0.08 -0.45 0 0.05">PMR visiteur est situé à proximité du bureau de l’assistante sociale</text><text class="ff5 fc1" transform="matrix(1.43 0 0 1.43 892.09 809.22)" dx="0 0 0 0.06 0 0 0.03 -0.29 -0.10 0.05">(porte 16).</text><text class="ff3 fc2" transform="matrix(1.43 0 0 1.43 168.80 852.77)" dx="0 0.37 8.51 0 0.33 0.37 0.37 0.29 0.21 0.37 0.13 0.32">E.Ascenseurs</text><text class="ff6 fc1" transform="matrix(1.43 0 0 1.43 134.60 880.14)" dx="0 0.05 0.05 0 0 0.08 0 -0.16 0.05 0.05 0 -0.10 0.05 0 0 0 -0.11 0.05 0 0.05 -0.10 -0.10 0 0.08 0.05 -0.10 0 0.08 0.05 -0.10 0 0 0 0.10 -0.19 0.05 0 0 0.05 0 0 0 0 0 -0.19 0 0 0.05 0 0 0.03 0 -0.08 0.05 0.05 0 0 0 0.