// import ModeDefault from './modes/mode-default.js'
// import ModeSearch from './modes/mode-search.js'
// import ModeDetails from './modes/mode-details.js'
// import ModeDirection from './modes/mode-direction.js'
// import ModeSimulation from './modes/mode-simulation.js'


class ModeManager {

    constructor(viewer){
        this.viewer = viewer;
        this.modes = {};
        this.history = [];
        this.mode = undefined;

        new ModeDefault(this);
        this.modeSearch = new ModeSearch(this);
        new ModeDetails(this);
        this.modeDirection = new ModeDirection(this);
        new ModeSimulation(this);
        new ModeSettings(this);

        this.defaultMode = this.modes['default'];

    }

    setMode(modeName, datas = {},history = true, ignorePrevious = false){

        this._clearCurrentMode();
        if(ignorePrevious) this.history.pop(); //ignorePrevious means don't store the currentMode as "previous"
        this._setMode(modeName,datas,history);
    }

    previousMode(datas = {}){
        if (typeof datas !== 'object' || datas === null) {
            datas = {};
        }
        let previousMode = this._getPreviousMode();
        if(previousMode == undefined) previousMode = this.defaultMode;
        this._clearCurrentMode();
        this.history.pop();
        if (Object.keys(datas).length === 0) {
            datas.previous = true;
        }
        this._setMode(previousMode.name,datas,false);
    }

    _clearCurrentMode(){
        if(this._getCurrentMode() != undefined){
            this.viewer.sidePanelManager.sp.removeClass('mode-'+this._getCurrentMode().name);
            $('body').removeClass('mode-'+this._getCurrentMode().name);
            this._getCurrentMode()._modeManager_closeMode_event();
        }
    }

    _getCurrentMode(){
        if(this.history.length >= 1){
            return this.history.slice(-1).pop();
        }else{
            return this.defaultMode;
        }
    }
    _getPreviousMode(){
        if(this.history.length >= 2){
            return this.history.slice(-2).shift();
        }else{
            return undefined;
        }
    }
    _getMode(modeName){
        if(!this.modes[modeName]){
            console.error(`The mode ${modeName} doesn't exists`);
        }
        return this.modes[modeName];
    }
    _setMode(modeName,datas, history){
        // set the targeted mode as the last mode in history if it's not an "previous event"
        if(history && (this._getCurrentMode() == undefined || this._getCurrentMode().name != modeName)){
            this.history.push(this._getMode(modeName));
        }
        $('body').addClass('mode-'+this._getCurrentMode().name);
        this.viewer.sidePanelManager.sp.addClass('mode-'+this._getCurrentMode().name);
        this.mode = this._getCurrentMode();
        this._getCurrentMode()._modeManager_setMode_event(datas);
        // console.log('current mode: '+(this._getCurrentMode() == undefined ? undefined : this._getCurrentMode().name)+"    -----    previous mode: "+(this._getPreviousMode() == undefined ? undefined : this._getPreviousMode().name));
        $(window).trigger('resize');
    }
}

'use strict';


class PanelManager {

    constructor(viewer){
        this.viewer = viewer;
        this.disabled = false;

        this.sp = $("#sp"); /** Main **/
        this.spContainer = $("#sp-container"); /** Main container **/
        this.spHeader = $("#sp-header"); /** Header container **/
        this.spContainerHeader = $("#sp-container-header"); /** Header of the container (only used for drag) **/
        this.spContainerConstraint = $("#sp-container-constraint"); /** Used for constraint the height **/
        this.spContainerConstraintContent = $("#sp-container-constraint-content"); /** Container constraint content **/
        this.spContainerContent = $("#sp-container-content"); /** Container content **/
        this.spContainerFooter = $("#sp-container-footer"); /** Container content **/
        this.position = "anchored";

        this.main();
    }

    main(){
        this.hammer_init();
        this.bind_resizeEvents();
        this.bind_clickEvents();
    }

    hammer_init(){
        this.hammerContainer = new Hammer(this.spContainer[0]);
        this.hammerContainer.add( new Hammer.Pan({ direction: Hammer.DIRECTION_VERTICAL, threshold: 10 }) );

        this.hammer_handlePanStart();
        this.hammer_handlePanVertical();
        this.hammer_handlePanEnd();
        this.hammer_handleTap();
    }

    hammer_handleTap(){
        let _this = this;

        _this.hammerContainer.on('click',function(e){
            e.trigger('click');
        });
    }

    hammer_handlePanStart(){
        let _this = this;
        _this.hammerContainer.on("panstart", function(e){
            if(_this.disabled){
                return true;
            }
            _this.lastHeight = _this.spContainer.height();
            _this.spContainer.css({"maxHeight":"inherit"});
            _this.hammer_setAnchorHeight();
            // _this.anchorHeight = _this.anchorHeight < _this.spContainerConstraintContent.height() * 0.33 ? _this.anchorHeight : _this.spContainerConstraintContent.height() * 0.33;
        });
    }
    hammer_setAnchorHeight(){
        this.anchorHeight = window.innerHeight * 0.35;
        this.anchorHeight = this.anchorHeight - this.spContainerHeader.height();
        this.anchorHeight = this.anchorHeight < this.spContainerConstraintContent.height() ? this.anchorHeight : this.spContainerConstraintContent.height();
    }

    hammer_handlePanVertical(){
        let _this = this;
        _this.hammerContainer.on("panup pandown", function(e) {
            if(_this.disabled){
                return true;
            }
            let newHeight = (e.deltaY*-1) + _this.lastHeight - _this.spContainerHeader.height();
            _this.spContainerConstraint.height( newHeight );
            _this.hammer_handlePanVertical_preventVerticalPanIssues(e);
        });
    }

    hammer_handlePanEnd(){
        let urlParams = new URLSearchParams(window.location.search);

        let _this = this;
        _this.hammerContainer.on("panend", function(e)
        {
            if (_this.disabled)
            {
                return true;
            }

            _this.hammer_handlePanEnd_event(e);
        });
    }

    hammer_handlePanVertical_preventVerticalPanIssues(e){
        let _this = this;
        /** Condition if we reached the maximum height of the content **/
        if(_this.spContainerConstraint.height() > _this.spContainerConstraintContent.height()){
            _this.spContainerConstraint.height( _this.spContainerConstraintContent.height());
        }
    }

    hammer_handlePanEnd_event(e){
        let _this = this;
        let direction = _this.spContainerConstraint.height() >= (_this.lastHeight - _this.spContainerHeader.height()) ? 'up' : 'down';
        let height = _this.spContainerConstraint.height();
        let velocity = Math.abs(e.velocity);

        /** Case drag direction up, height is less than "anchored height"  **/
        /** In this case, we set the height to the "anchored" height **/
        if(direction == 'up' && height < _this.anchorHeight){
            _this.hammer_setPosition("anchored");
        }

        /** Case drag direction up, height is more than "anchored height"  **/
        /** In this case, we don't change the height **/
        if(direction == 'up' && height >= _this.anchorHeight){
            _this.hammer_setPosition("expanded");
        }

        /** Case drag direction down, height is less than "anchored height"  **/
        /** In this case, we set the height to the "collapsed" height **/
        if(direction == 'down' && height < _this.anchorHeight - 50){
            _this.hammer_setPosition("collapsed");
        }

        /** Case drag direction down, height is more than "anchored height"  **/
        /** In this case, we set the height to the "anchored" height **/
        if(direction == 'down' && height > _this.anchorHeight - 50){
            _this.hammer_setPosition("anchored");
        }

        /** Case drag direction down, velocity is "fast" **/
        /** In this case, we set the height to the "collapsed" height **/
        if(direction == 'down' && velocity > 0.5){
            _this.hammer_setPosition("collapsed");
        }
    }

    hammer_setPosition(position = this.position, duration = 200)
    {

        this.previousPosition = this.spContainerHeader.attr('class');
        this.spContainerHeader.removeClass();
        this.position = position;
        this.spContainerHeader.addClass(position);

        switch (this.position)
        {
            case "expanded":
                this.spContainerConstraint.animate( { height: this.spContainerConstraintContent.height()}, { queue:false, duration: duration });
                break;
            case "anchored":
                this.spContainerConstraint.animate( { height: this.anchorHeight }, { queue:false, duration: duration });
                break;
            case "collapsed":
                this.spContainerConstraint.animate( { height:0 }, { queue:false, duration: duration });
                break;
            case "auto":
                this.spContainerConstraint.animate( { height:0 }, { queue:false, duration: duration });
                break;
        }
    }

    bind_resizeEvents(){
        let _this = this;
        $( window ).resize(function() {
            _this.hammer_setAnchorHeight();
            _this.hammer_setPosition();
        });
    }

    bind_clickEvents(){
        let _this = this;
        this.spContainerHeader.on('click',function(e){
            switch ($(this).attr('class')) {
                case 'expanded':
                    _this.hammer_setPosition("collapsed");
                    break;
                case 'collapsed':
                    _this.hammer_setPosition("anchored");
                    break;
                case 'anchored':
                    _this.hammer_setPosition("expanded");
                    break;
            }
        });
    }

    setHeader($element = null){
        let html = $element ? $element.html() : '';
        this.spHeader.html(html);
    }
    setContent($element = null){
        let html = $element ? $element.html() : '';
        this.spContainerContent.html(html);
    }
    setFooter($element = null){
        let html = $element ? $element.html() : '';
        this.spContainerFooter.html(html);
    }
    setPosition(position){
        if(this.previousPosition) this.sp.removeClass(this.previousPosition);
        this.sp.addClass(position);
        this.previousPosition = position;
    }
    unsetPosition(position){
        this.sp.removeClass(position);
    }

    disable(){
        this.disabled = true;
    }
    enable(){
        this.disabled = false;
    }

    clear(){
        this.setHeader();
        this.setContent();
        this.setFooter();
    }

}

