    _display_results(results, openPanel = true) {

        // If the search if for the "from" variable, we should only display ipsTriggersInfo with only one ipsTrigger
        // if(this.varName === 'from'){
        //
        //     let res = [];
        //     $.each(results['ips'], function (key,value) {
        //         if(value.ipsTriggers.length == 1){
        //             res.push(value);
        //         }
        //     });
        //     results['ips'] = res;
        // }


        // get favorites from localstorage
        let favorites = JSON.parse(localStorage.getItem('user_favorites'));
        if (favorites == null) favorites = [];
        // find all ips trigger info in results[ips] and in favorites and add them to the top of results[ips]
        if (favorites && favorites.length > 0) {
            // Create a set of favorite triggerInfoIds for quick lookup
            let favoriteTriggerInfoIds = new Set();

            // Extract triggerInfoIds from favorites
            favorites.forEach(favorite => {
                if (favorite && favorite.triggerInfoId) {
                    favoriteTriggerInfoIds.add(favorite.triggerInfoId);
                }
            });

            // If we have any favorites with triggerInfoIds
            if (favoriteTriggerInfoIds.size > 0) {
                // Create new array to store reordered results
                let reorderedResults = [];
                let remainingResults = [];

                // Split results into favorites and non-favorites
                for (let [key, ipsTriggerInfo] of Object.entries(results['ips'])) {

                    let favoriteData = null
                    favorites.forEach(favorite => {
                        if (favorite && favorite.triggerInfoId === ipsTriggerInfo.id) {
                            favoriteData = favorite;
                        }
                    });

                    if (favoriteTriggerInfoIds.has(ipsTriggerInfo.id) && ipsTriggerInfo.alias === '') {
                        // This is a favorite, add it to the top
                        ipsTriggerInfo.isFavorite = true;
                        ipsTriggerInfo.favoriteNodes = new Set(favoriteData?.idMapping?.split(',') ?? []);
                        reorderedResults.push(ipsTriggerInfo);

                    } else {
                        // Not a favorite, keep for later
                        ipsTriggerInfo.isFavorite = false;
                        remainingResults.push(ipsTriggerInfo);

                    }
                }

                // Combine favorites (now at the top) with remaining results
                results['ips'] = [...reorderedResults, ...remainingResults];
            }
        }

        this._display_results_viewer_partner(results, true);
    }

