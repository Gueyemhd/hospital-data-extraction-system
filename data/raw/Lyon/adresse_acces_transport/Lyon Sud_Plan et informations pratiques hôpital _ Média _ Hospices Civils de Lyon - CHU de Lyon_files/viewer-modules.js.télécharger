	_split_ipsTriggersInfos(json){
		let _this = this;

		$.each(json.ipsTriggersInfos, function( k, v ) {

			if(v.ipsTriggerInfoIcon != null){
				v.ipsTriggerInfoIcon.icon = _this.site+v.ipsTriggerInfoIcon.icon;

				if(v.ipsTriggerInfoIcon.name === 'building') v.type="building";
				// Store the list of IpsTriggersInfoIcons.
				_this.ipsTriggersInfoIcons[v.ipsTriggerInfoIcon.id] = v.ipsTriggerInfoIcon;
			}
			_this._extractAndStore_ipsTriggersInfosAndIpsTriggers(k,v);
		});
	}
	getShortcuts(){
        let shortcuts = {};
		$.each( this.ipsTriggersInfos, function( key, value ) {
			if(value.shortcut == 1){
                shortcuts[value.id] = value
            }
        });
        return shortcuts;
	}
	getBuildings(){
        let buildings = {};
		$.each( this.ipsTriggersInfos, function( key, value ) {
			if(value.type === "building"){
                buildings[value.id] = value
            }
        });
        return buildings;
	}

	_extractAndStore_ipsTriggersInfosAndIpsTriggers(key,ipsTriggerInfo){
		let _this = this;

		ipsTriggerInfo.levels = {};
		ipsTriggerInfo.displayLevels = [];
		ipsTriggerInfo.revertdisplayLevels = [];
		ipsTriggerInfo.geometry = [];

		ipsTriggerInfo.poi = this.pois[ipsTriggerInfo.poi.id];

		let childrens = {};
		$.each(ipsTriggerInfo.childrens, function( k, v ) {childrens[v.id] = v.id;});
		ipsTriggerInfo.childrens = childrens;

		let parents = {};
		$.each(ipsTriggerInfo.parents, function( k, v ) {parents[v.id] = v.id;});
		ipsTriggerInfo.parents = parents;

		// console.log(this)
		$.each(ipsTriggerInfo.ipsTriggers, function( k, ipsTrigger ) {

			// If the ipsTrigger doesn't have a level, we consider it as an "all" level
			if(ipsTrigger.level === undefined || ipsTrigger.level == null || ipsTrigger.level === '') ipsTrigger.level = 'all';

			// We keep only "all" levels or levels in the level list of the poi
			if(ipsTrigger.level ==='all' || ipsTriggerInfo.poi.levels[ipsTrigger.level] !== undefined ){


				// We set the ipsTrigger display level to the one corresponding of the poi
				ipsTrigger.displayLevel = ipsTriggerInfo.poi.levels[ipsTrigger.level];
				// We create the geoJsonPoint from ipsTrigger datas
				let feature = _this._create_geoJsonPoint_from_ipsTrigger(ipsTrigger,ipsTriggerInfo);

				feature.properties['max-zoom'] = feature.properties['ipsTriggerInfo']['detailedView'] ?  24 : _this.globalViewZoom;
				feature.properties['min-zoom'] = feature.properties['ipsTriggerInfo']['globalView'] ?  0 : _this.globalViewZoom;

				feature.properties['priority'] = feature.properties['ipsTriggerInfo']['type']  == 'common' ?  1 : 0;

				feature.properties['interactive'] = feature.properties['ipsTriggerInfo']['search']  ?  1 : 0;

				// We create the level if it doesn't already exist in the ipsTriggerInfo
				if(!ipsTriggerInfo.levels[ipsTrigger.level]) ipsTriggerInfo.levels[ipsTrigger.level] = [];
				// We add the id (idMapping) to the correct level of the ipsTriggerInfo
				ipsTriggerInfo.levels[ipsTrigger.level].push(ipsTrigger.idMapping);

				// We create the displayLevel if it doesn't already exist
				if(ipsTriggerInfo.displayLevels[feature.properties.displayLevel] == undefined) ipsTriggerInfo.displayLevels[feature.properties.displayLevel] = [];
				if(ipsTriggerInfo.geometry[feature.properties.displayLevel] == undefined) ipsTriggerInfo.geometry[feature.properties.displayLevel] = [];
				if(ipsTriggerInfo.geometries == undefined) ipsTriggerInfo.geometries = [];
				if(ipsTriggerInfo.geometries[feature.properties.displayLevel] == undefined) ipsTriggerInfo.geometries[feature.properties.displayLevel] = [];

				if(ipsTriggerInfo.geometriesLevels == undefined) ipsTriggerInfo.geometriesLevels = [];
				if(ipsTriggerInfo.geometriesLevels[feature.properties.displayLevel] == undefined) ipsTriggerInfo.geometriesLevels[feature.properties.displayLevel] = [];
				// We add the id (idMapping) to the correct displayLevel of the ipsTriggerInfo
				ipsTriggerInfo.displayLevels[feature.properties.displayLevel].push(ipsTrigger.idMapping);

				let lngLat = [ipsTrigger.longitude,ipsTrigger.latitude];
				ipsTriggerInfo.geometries[feature.properties.displayLevel].push(lngLat);
				let geometryLevel = feature.properties.level == 'all' ? 'ext' : feature.properties.level;
				ipsTriggerInfo.geometriesLevels[feature.properties.displayLevel].push(geometryLevel);
