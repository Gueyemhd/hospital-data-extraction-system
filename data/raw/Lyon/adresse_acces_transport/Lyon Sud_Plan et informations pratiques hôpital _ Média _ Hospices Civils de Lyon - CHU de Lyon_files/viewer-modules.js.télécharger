    let milestoneInstructionsTable = $(this.instructionsMilestonesTemplate.html());

    if (direction.routeOrder === 'outdoor_first') {
      _this._create_direction_milestone_render_instructions_outdoor(direction, milestoneInstructionsTable);
      _this._create_direction_milestone_render_instructions_indoor(direction, milestoneInstructionsTable);
    } else {
      _this._create_direction_milestone_render_instructions_indoor(direction, milestoneInstructionsTable);
      _this._create_direction_milestone_render_instructions_outdoor(direction, milestoneInstructionsTable);
    }

    if (direction.indoorInstructions.length > 0 || direction.outdoorInstructions.length > 0) {
      milestoneCard.find(`#milestone-instructions-${milestoneCard[0].classList[1].split('-')[1]}`).empty();
      milestoneCard.find(`#milestone-instructions-${milestoneCard[0].classList[1].split('-')[1]}`).append(milestoneInstructionsTable);
