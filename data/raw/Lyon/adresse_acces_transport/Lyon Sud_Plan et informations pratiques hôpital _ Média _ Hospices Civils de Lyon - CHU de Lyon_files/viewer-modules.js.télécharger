                resultGrpPoiBuilding = resultGrpPoiBuilding[0].outerHTML;
                resultGrpPoiBuilding = resultGrpPoiBuilding.replaceAll('building_accordion_id', 'accordion_' + key + '_' + k)
                resultGrpPoiBuilding = resultGrpPoiBuilding.replaceAll('building_heading_id', 'heading_' + key + '_' + k)
                resultGrpPoiBuilding = resultGrpPoiBuilding.replaceAll('building_collapse_id', 'collapse_' + key + '_' + k)

                resultGrpPoi.find('.card-body:first').append(resultGrpPoiBuilding);
            });


            // Add ipsTriggersInfos
            poi['results'].forEach((res) => {
                resultGrpPoi.find('.card-body:first').append(res[0].outerHTML);
            });


            if (poi['all'] && poi['all']['results'].length > 0) {
                let resultGrpPoiBuilding = $(_this.resultBuildingGroupTemplate.html());
                resultGrpPoiBuilding.find('.group-name').html(poi['all']['name']);

                // Add building ipsTriggersInfos
                poi['all']['results'].forEach((res) => {
                    resultGrpPoiBuilding.find('.card-body:first').append(res[0].outerHTML);
                });
                resultGrpPoiBuilding = resultGrpPoiBuilding[0].outerHTML;
                resultGrpPoiBuilding = resultGrpPoiBuilding.replaceAll('building_accordion_id', 'accordion_' + key + '_all')
                resultGrpPoiBuilding = resultGrpPoiBuilding.replaceAll('building_heading_id', 'heading_' + key + '_all')
                resultGrpPoiBuilding = resultGrpPoiBuilding.replaceAll('building_collapse_id', 'collapse_' + key + '_all')

                resultGrpPoi.find('.card-body:first').append(resultGrpPoiBuilding);

            }

            if (this.viewer.type === 'viewer-poi') {
                resultGrpPoi.find('.card-header:first').attr('style', 'display:none !important');
            }
            resultGrpPoi = resultGrpPoi[0].outerHTML;
            resultGrpPoi = resultGrpPoi.replaceAll('accordion_id', 'accordion_' + key)
            resultGrpPoi = resultGrpPoi.replaceAll('heading_id', 'heading_' + key)
            resultGrpPoi = resultGrpPoi.replaceAll('collapse_id', 'collapse_' + key)


            // hospital
            _this.resultsList.append(resultGrpPoi);

        }


        if (results['google'].length > 0) {
            let resultGrpGoogle = $(_this.resultGroupTemplate.html());
            resultGrpGoogle.find('.group-name').html(translations['viewers_mode_search_google-groupe-title']);
            resultGrpGoogle.find('.fa-h-square').hide();
            resultGrpGoogle.find('.card').find('h5').css('height', 'inherit');
            resultGrpGoogle.find('.card').find('h5').find('.infos').removeClass('d-flex justify-content-between align-items-center');

            if (this.viewer.type != 'viewer-partner') resultGrpGoogle.find('.card').find('h5').css('background-color', '#007bff');

            $.each(results['google'], function (key, googleResult) {
                let result = $(_this.resultTemplate.html());
                result.attr({
                    'data-google-place-id': googleResult.place_id,
                    'data-name': googleResult.structured_formatting.main_text + ' ' + googleResult.structured_formatting.secondary_text
                });
                result.find('img').attr('src', _this.site + '/ressources/front/js/viewers/icons/google-maps.svg');
                result.find('.infos .title').html(googleResult.structured_formatting.main_text);
                result.find('.infos .text').html(googleResult.structured_formatting.secondary_text);

                resultGrpGoogle.find('.card-body').append(result[0].outerHTML);

            });

            resultGrpGoogle = resultGrpGoogle[0].outerHTML;
            resultGrpGoogle = resultGrpGoogle.replaceAll('accordion_id', 'accordion_google')
            resultGrpGoogle = resultGrpGoogle.replaceAll('heading_id', 'heading_google')
            resultGrpGoogle = resultGrpGoogle.replaceAll('collapse_id', 'collapse_google')
            _this.resultsList.append(resultGrpGoogle);
        }

        if (openPanels) {
            $('#search-results .collapse').collapse('show');
        }

    }

}

