            'appId': this.viewerParameters['appId'],
            'geoJson': this.viewerParameters['geoJson'],
            'ipsTriggersInfos': this.viewerParameters['ipsTriggersInfos']
        }
    }

    initVoiceManagerParameters(){
        this.viewerParameters['voice-instructions'] = viewerParameters['voice-instructions'] ?? 1;
        this.voiceManagerParameters = {
            'enabled': this.viewerParameters['voice-instructions']
        }
    }

    initlocationManagerParameters(){
        this.locationManagerParameters = {
            'enabled': this.mode !== 'kiosk'
        }
    }

    initQueryParameters(){

        /** Viewer parameters set from URL dynamic parameters **/
        let urlParams = new URLSearchParams(window.location.search);

        // Map override parameters
        this.disableRotate = urlParams.get('rotate'); // Map rotation (pitch/bearing) capabilty
        this.pitch = urlParams.get('pitch') !== null ? urlParams.get('pitch') : this.pitch; // default pitch map overriding
        this.bearing = urlParams.get('bearing') !== null ? urlParams.get('bearing') : this.bearing;

        // show-coordinates is used to display coordinates on click on the map, and disabled pitch, bearing and rotation of the map
        this.showCoordinates = urlParams.has('show-coordinates');
        if(this.showCoordinates){
            this.mapManagerParameters['pitch'] = this.pitch = 0;
            this.mapManagerParameters['bearing'] = this.bearing = 0;
            this.disableRotate = true;
        }

        //to enter the viewer on details mode on an existing ips trigger info
        if(!this.ipsTriggerId){
            this.ipsTriggerId = urlParams.get('ips-trigger-id') !== null ? urlParams.get('ips-trigger-id') : undefined;
        }

        //to enter the viewer on direction mode on an existing route
        //stores a from ips trigger id and a to ips trigger id
        this.fromIpsTriggerId = urlParams.get('from-ips-trigger-id') !== null ? urlParams.get('from-ips-trigger-id') : undefined;
        this.toIpsTriggerId = urlParams.get('to-ips-trigger-id') !== null ? urlParams.get('to-ips-trigger-id') : undefined;

        //to enter the viewer on direction mode on an existing route
        //from user position=lat,lng,lvl
        this.fromUserPosition = urlParams.get('from-user-position') !== null ? urlParams.get('from-user-position') : undefined;

        //to enter the viewer on direction mode on an indoor outdoor, or outdoor indoor, or outdoor outdoor route
        //stores googlePlaceId
        this.fromOutdoor = urlParams.get('from-outdoor') !== null ? urlParams.get('from-outdoor') : undefined;
        this.toOutdoor = urlParams.get('to-outdoor') !== null ? urlParams.get('to-outdoor') : undefined;

        //to share routing profile in a link
        //can be car, walk or bike
        this.routingProfile = urlParams.get('routing-profile') !== null ? urlParams.get('routing-profile') : undefined;

        //to share routing settings in a link
        //can be parking=true or false, and wheelchair=true or false
        this.parking = urlParams.get('parking') !== null ? urlParams.get('parking') : undefined;
        this.wheelchair = urlParams.get('wheelchair') !== null ? urlParams.get('wheelchair') : undefined;

        // show-style is used to allow update map style (display button update style), it also disable the rendering of ips-triggers
        this.doNotRenderIpsTriggers = this.showStyle = urlParams.has('show-style');
        this.doNotRenderIpsTriggers= urlParams.has('do-not-render-ips-triggers') ? true : this.doNotRenderIpsTriggers;
        // reload-data force the reload of the datas
        this.reloadData = urlParams.has('reload-data');

        // Parameters for inital location (lat/lng/lvl)
        this.fromLat = urlParams.get('from-lat');
        this.fromLng = urlParams.get('from-lng');
        this.fromLvl = urlParams.get('from-lvl');

        // Parameters for inital location oriented scan of QR (lat/lng)
        this.qrLat = urlParams.get('qr-lat');
        this.qrLng = urlParams.get('qr-lng');

        // Parameters for destination location, calculated server side, passed as an viewer parameter (lat/lng/lvl)

        if(this.fromLat && this.fromLng && this.mode === 'kiosk'){
            this.location = {
                'lat' : +this.fromLat,
                'lng' : +this.fromLng,
                'lvl' : +this.fromLvl ?? 'all'
            }
            this.lvl = this.fromLvl ?? 'all';
            this.mapManagerParameters['zoom'] = 22;
            this.mapManagerParameters['pitch'] = 60;
            this.mapManagerParameters['lat'] = parseFloat(this.fromLat);
            this.mapManagerParameters['lng'] = parseFloat(this.fromLng);

            if(this.qrLat && this.qrLng){
                let bearing = turf.bearing(turf.point([this.fromLng,this.fromLat]), turf.point([this.qrLng,this.qrLat]));
                this.mapManagerParameters['bearing'] = bearing;
            }
        }
        this.qr = urlParams.get('qr');
        this.fromKiosk = urlParams.get('kiosk');

    }

    initComponents(){
        this.ipsApi = new IpsApi(this);
        this.mapManager = new MapManager(this,this.mapManagerParameters);
        this.dataManager = new DataManager(this,this.dataManagerParameters);
        this.sidePanelManager = new PanelManager(this);
        this.modeManager = new ModeManager(this);
        this.searchManager = new SearchManager(this);
        this.voiceManager = new VoiceManager(this,this.voiceManagerParameters);
        this.locationManager = new LocationManager(this,this.locationManagerParameters);
    }

    initViewer(){
        /** Depending on viewer parameters, some actions should be done **/

        let _this = this;
        let datas = {};

        if(this.fromIpsTriggerId !== undefined && this.dataManager.ipsTriggers[this.fromIpsTriggerId]) {
            let fromIpsTrigger = this.dataManager.ipsTriggers[this.fromIpsTriggerId];
            let fromIpsTriggerInfo = this.dataManager.ipsTriggersInfos[fromIpsTrigger.ipsTriggerInfoId];

            datas.from = {
                display: fromIpsTriggerInfo.display,
                displayLvl: fromIpsTrigger.displayLevel,
                featureId: fromIpsTrigger.id,
                featuresIds: fromIpsTriggerInfo.ipsTriggersFeaturesIds[fromIpsTrigger.displayLevel].toString(),
                idMapping: fromIpsTrigger.idMapping,
                lat: fromIpsTrigger.latitude,
                lng: fromIpsTrigger.longitude,
                lvl: fromIpsTrigger.level,
                name: fromIpsTriggerInfo.name,
                triggerInfoId: fromIpsTriggerInfo.id
            }
        }

        if(this.toIpsTriggerId !== undefined && this.dataManager.ipsTriggers[this.toIpsTriggerId]) {
            let toIpsTrigger = this.dataManager.ipsTriggers[this.toIpsTriggerId];
            let toIpsTriggerInfo = this.dataManager.ipsTriggersInfos[toIpsTrigger.ipsTriggerInfoId];

            datas.to = {
                display: toIpsTriggerInfo.display,
                displayLvl: toIpsTrigger.displayLevel,
                featureId: toIpsTrigger.id,
                featuresIds: toIpsTriggerInfo.ipsTriggersFeaturesIds[toIpsTrigger.displayLevel].toString(),
                idMapping: toIpsTrigger.idMapping,
                lat: toIpsTrigger.latitude,
                lng: toIpsTrigger.longitude,
                lvl: toIpsTrigger.level,
                name: toIpsTriggerInfo.name,
                triggerInfoId: toIpsTriggerInfo.id
            }
        }

        if(this.fromUserPosition !== undefined) {
            let latLngLvl = this.fromUserPosition.split(',');
            let lat = parseFloat(latLngLvl[0]);
            let lng = parseFloat(latLngLvl[1]);
            let level = latLngLvl[2];

            datas.from = {
                position: true,
                lat: lat,
                lng: lng,
                lvl: level === "null" ? null : level,
                name: translations['viewers_mode_search_your-location']
            }
        }

        if(this.fromOutdoor !== undefined) {
            let fromOutdoorPOI = this.searchManager.search_google_details(this.fromOutdoor);
            let latlng = fromOutdoorPOI.result.geometry.location;

            datas.from = {
                googlePlaceId: this.fromOutdoor,
                lat: latlng.lat,
                lng: latlng.lng,
                name: fromOutdoorPOI.result.name
            }
        }

        if(this.toOutdoor !== undefined) {
            let toOutdoorPOI = this.searchManager.search_google_details(this.toOutdoor);
            let latlng = toOutdoorPOI.result.geometry.location;

            datas.to = {
                googlePlaceId: this.toOutdoor,
                lat: latlng.lat,
                lng: latlng.lng,
                name: toOutdoorPOI.result.name
            }
        }

        if(this.ipsTriggerId !== undefined && this.dataManager.ipsTriggers[this.ipsTriggerId] !== undefined) {
            let ipsTrigger = this.dataManager.ipsTriggers[this.ipsTriggerId];
            let ipsTriggerInfo = this.dataManager.ipsTriggersInfos[ipsTrigger.ipsTriggerInfoId];

            datas.ipsTriggerInfo = {
                featureId: ipsTrigger.id,
                featuresIds: ipsTriggerInfo.ipsTriggersFeaturesIds[ipsTrigger.displayLevel].toString(),
                idMapping: ipsTrigger.idMapping,
                lvl: ipsTrigger.level,
                displayLvl: ipsTrigger.displayLevel,
                name: ipsTriggerInfo.name,
                triggerInfoId: ipsTriggerInfo.id,
                lat: ipsTrigger.latitude,
                lng: ipsTrigger.longitude
            };
        }

        if(datas.from && datas.to) {
            datas.settings = datas.settings || {};
            if(this.routingProfile !== undefined) {
                if(this.routingProfile !== 'car' && this.routingProfile !== 'walk' && this.routingProfile !== 'bike') {
                    console.error("Unknown value for routing profile key");
                    return;
                }
                datas.settings.routingProfile = this.routingProfile;
            }

            if(this.parking !== undefined) {
                datas.settings.parking = this.parking;
            }

            if(this.wheelchair !== undefined) {
                datas.settings.wheelchair = this.wheelchair;
            }

            this.modeManager.setMode('direction', datas);
        }
        else if(datas.ipsTriggerInfo) {
            this.modeManager.setMode('details', datas);
        } else {
            this.modeManager.setMode('default');


            /** If location provided **/
            if(this.location){
                this.mapManager.goTo(this.location.lvl,this.mapManager.lngLat,false,this.zoom);
            }else if (this.destination && this.datas.to){
                this.mapManager.goTo(this.datas.to.lvl,[this.datas.to.lng,this.datas.to.lat],true,22);
            }


            if (Object.keys(this.datas).length !== 0){
                this.modeManager.setMode('direction',this.datas);
                if (!this.origin || !this.destination){
                    if (!this.destination){
                        this.modeManager._getCurrentMode().toInput.attr('placeholder',translations['viewers_mode_search_to-placeholder']);
                        this.modeManager._getCurrentMode().toInput.click();
                        this.modeManager._getCurrentMode().spHeader.find('span').html(translations['viewers_mode_search_to_header']);
                        this.modeManager._getCurrentMode().spHeader.find('span').addClass('font-weight-bold text-primary text-uppercase');
                    } else {
                        this.locationManager.getLocation(this,this.locationCallback.name);
                    	// this.modeManager._getCurrentMode().fromInput.attr('placeholder',translations['viewers_mode_direction_from-placeholder']);
                    	// this.modeManager._getCurrentMode().fromInput.click();
                    }
                }

            }

            // ?from-lat=48.87852353436526&from-lng=2.3779140839230593&qr-lat=48.87854295765439&qr-lng2.3778887264094237&from-lvl=1&mode=kiosk
        }
    }

    locationCallback(position){
      if (!position){
        this.mapManager.goTo(this.datas.to.lvl,[this.datas.to.lng,this.datas.to.lat],true,18);
      }
    }

    logQr(){
        if (this.qr) {
            let url = this.site+'/qr';
            $.ajax({
                url: url,
                method: 'post',
                data: {
                    'uniqueId':this.qr
                },
                success: function(){
                }
            });
        }
    }

    async loader(show = 0){
        if(show === 1){
            $('#loader').css( "zIndex", 10 );
        }else{
            $('#loader').css( "zIndex", -10 );
        }
    }
}

