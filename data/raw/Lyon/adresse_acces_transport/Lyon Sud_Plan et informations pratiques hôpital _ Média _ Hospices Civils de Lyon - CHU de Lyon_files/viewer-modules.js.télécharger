  _create_milestone_spContent() {
    let _this = this;
    this.routeInstructionsContainer.empty();
    // this.spContainerHeader.show();

    let milestonesContainer = document.createElement('div');
    milestonesContainer.className = "milestones-container";

    // Check if a milestone corresponds to start
    for (let i = 0; i < this.milestones.length; i++) {
      if (_this._buildMilestoneObj(_this.milestones[i]).idMapping == _this.from.idMapping) {
        for (let index = i; index >= 0; index--) {
          _this.milestones.splice(index, 1);
        }
        i = 0;
      }
    }

    // Create cards for milestones
    for (let i = 1; i <= this.milestones.length; i++) {
      $.each(this.viewer.dataManager.ipsTriggers, function (index, ipsTrigger) {
        if (ipsTrigger.idMapping == _this.milestones[i - 1].milestones[0].idMapping) {
          let milestoneCard = _this._create_milestone_card(i, _this.viewer.dataManager.ipsTriggersInfos[ipsTrigger.ipsTriggerInfoId]);
          milestonesContainer.innerHTML += milestoneCard;
        }
      });
    }

    // Create card for destination
    $.each(this.viewer.dataManager.ipsTriggers, function (index, ipsTrigger) {
      if (ipsTrigger.idMapping == _this.to.idMapping) {
        let destinationCard = _this._create_milestone_card(_this.milestones.length + 1, _this.viewer.dataManager.ipsTriggersInfos[ipsTrigger.ipsTriggerInfoId], true);
        milestonesContainer.innerHTML += destinationCard;
      }
    });

    this.routeInstructionsContainer.append(milestonesContainer);

    this._create_milestone_spContent_bindEvents();
  }

  _create_milestone_spContent_bindEvents() {
    let _this = this;
    let body = $('body');

    body.on('click', '.toggle-milestones-instructions', function () {
      if ($(this).siblings('.collapse')[0].classList.contains('show')) {
        $(this).find('i')[0].classList.replace('fa-angle-up', 'fa-angle-down');
      } else {
        $(this).find('i')[0].classList.replace('fa-angle-down', 'fa-angle-up');
      }
    });

    let isAnimating = false;
    body.on('click', '.enable-milestone', function () {
      if (isAnimating) return;

      isAnimating = true;

      let toggleInstructionsButton = $(this).parent().parent().siblings('.toggle-milestones-instructions');
      let instructions = $(this).parent().parent().siblings('[id*=milestone-instructions]');
      let disabledHover = $(this).parent().parent().siblings('.milestone-disabled');

      if ($(this).parent().parent().siblings('.milestone-disabled')[0].classList.contains('d-none')) {
        _this._milestone_spContent_event_milestoneDisabled(this, toggleInstructionsButton, instructions, disabledHover);
      } else {
        _this._milestone_spContent_event_milestoneEnabled(this, toggleInstructionsButton, instructions, disabledHover);
      }

      setTimeout(function () {
        isAnimating = false;
      }, 500);
    });
  }

  _milestone_spContent_event_getMilestoneId(element) {
    element = element.id.split('-');
