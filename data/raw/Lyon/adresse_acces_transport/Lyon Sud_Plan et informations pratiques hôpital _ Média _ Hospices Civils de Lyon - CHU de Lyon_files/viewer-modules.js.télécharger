'use strict';

class ModeSearch extends Mode {

    constructor(modeManager) {
        super(modeManager, 'search');
        this.layers = ['ips-triggers'];
        this.results = {};
        this.type = 'list';
        this._handleMapMove = this._handleMapMove.bind(this); // Lier `this`
        this.tooltip = $('#map-tooltip');
        this.tooltipFirst = true;

        this.multiPoiDirection = this.viewer.viewerParameters['multi-poi'];
    }

    _modeManager_setMode_event(datas) {
        this.targetMode = datas.targetMode == undefined ? this.modeManager._getPreviousMode() : datas.targetMode;
        this.varName = datas.varName;
        this.google = datas.google == undefined ? false : datas.google;
        this.google = this.viewer.qr == undefined ? this.google : false;
        this.placeholder = datas.placeholder == undefined ? false : datas.placeholder;


        this.poiId = undefined;
        if (datas.from && datas.from.triggerInfoId && datas.varName != 'from') {
            this.poiId = this.viewer.dataManager['ipsTriggersInfos'][datas.from.triggerInfoId]['poi']['id'];
        }
        if (datas.to && datas.to.triggerInfoId && datas.varName != 'to') {
            this.poiId = this.viewer.dataManager['ipsTriggersInfos'][datas.to.triggerInfoId]['poi']['id'];
        }

        if (this.multiPoiDirection == true) this.poiId = undefined;

        this.viewer.sidePanelManager.disable();

        if (this.varName === 'from' && !this.viewer.locationManager.positionDenied) {
            this.viewer.locationManager.getLocation(this, this._locationManager_getLocation_event.name, (error)=>{
                console.error('Error getting location:', error);
                this._hide_find_location_views();
                this._buildSidePanel();
            });
        } else {
            this._buildSidePanel();
        }

        this._defaultState();

    }

    _hide_find_location_views() {
        $('#map-center-container').hide();
        $('#findPositionValidateContainer').remove();
        $('.level-control')?.popover('dispose');
        this.mapManager.map.off('move', this._handleMapMove);
        this.tooltipFirst = true;
    }

    _handleMapMove() {
        const center = this.mapManager.map.getCenter();
        const point = turf.point([center.lng, center.lat]);

        if(this.tooltipFirst) {
            this.tooltipFirst = false;
        }

        if (!this.viewer.locationManager.isPointInHospital(point)) {
            this.tooltip.html(translations['viewers_mode_search_firstPos_tooltip_out']);
        } else {
            this.tooltip.html(translations['viewers_mode_search_firstPos_tooltip_in']);
        }
    }

    _locationManager_getLocation_event() {
        const position = this.viewer.locationManager.position;
        const _this = this;
        if ($(window).width() < 768 && position && this.viewer.locationManager.isUserInHospital()) {
            _this.viewer.mapManager.renderManager.removeDirection();

            let isUserOutdoor = (() => {
                // 20m
                const threshold = 20;
                const point = turf.point([position.coords.longitude, position.coords.latitude]);
                let isUserOutdoor = true;
                for (const indoor of this.viewer.dataManager.indoors) {
                    if (indoor.geometry.type === "Polygon") {
                        try {
                            const inside = turf.booleanPointInPolygon(point, turf.polygon(indoor.geometry.coordinates));
                            if (inside) {
                                isUserOutdoor = null;
                                break;
                            }
                            const distance = turf.pointToPolygonDistance(point, indoor, {units: 'meters'});
                            if (distance < threshold) {
                                isUserOutdoor = false;
                            }
                        } catch (e) {
                            console.error('Error calculating distance:', indoor, e);
                        }
                    }
                }
                return isUserOutdoor;
            })();

            // si inbox indoor
            if (!isUserOutdoor) {

                setTimeout(() => {
                    _this.mapManager.map.off('movestart');
                    _this.mapManager.map.on('movestart', () => {
                        $('#findPositionValidateButton')?.popover('dispose');
                        _this.tooltip.stop(true, true).fadeIn(300);
                    });

                    _this.tooltip.stop(true, true).fadeIn(300);
                    _this.tooltip.html(translations['viewers_mode_search_firstPos_tooltip_first']);

                    _this.mapManager.map.off('move', _this._handleMapMove);
                    _this.mapManager.map.on('move', _this._handleMapMove);

                    _this.mapManager.map.off('moveend');
                    _this.mapManager.map.on('moveend', () => {
                        let isInside = false;
                        const point = turf.point(this.mapManager.map.getCenter().toArray());
                        for (const indoor of this.viewer.dataManager.indoors) {
                            if (indoor.geometry.type === "Polygon") {
                                try {
                                    const inside = turf.booleanPointInPolygon(point, turf.polygon(indoor.geometry.coordinates));
                                    if (inside) {
                                        isInside = true;
                                        break;
                                    }
                                } catch (e) {
                                    console.error('Error checking point in polygon:', indoor, e);
                                }
                            }
                        }
                        isUserOutdoor = isInside ? null : true;
                        _this.tooltip.stop(true, true).fadeOut(300);
                    });

                }, 1000);

                $('.level-control').popover({
                    content: isUserOutdoor === null ? translations['viewers_mode_search_firstPos_popover_user_in'] : translations['viewers_mode_search_firstPos_popover_user_out'],
                    placement: 'top',
                    html: true,
                    trigger: 'manual'
                });
                $('.level-control').popover('show');

                $(document).off('click', '.close-popover');
                $(document).on('click', '.close-popover', function () {
                    $('.level-control').popover('dispose');
                });

                $(document).off('click', '#OutBtnPopOver');
                $(document).on('click', '#OutBtnPopOver', function () {
                    isUserOutdoor = true;
                });

                const template = $('#template-find_position_validation').html()
                $('#sp-container').append(template);

                this.mapManager.goTo(0, [position.coords.longitude, position.coords.latitude], false, 18, null, null, 0);

                $('#findPositionListButton').off('click').on('click', function (e) {
                    e.preventDefault();
                    _this._hide_find_location_views();
                    _this._buildSidePanel();
                });

                $('#map-center-container').show();
                $('#findPositionValidateButton').off('click').on('click', function () {
                    const center = _this.viewer.mapManager.map.getCenter();
                    const point = turf.point([center.lng, center.lat]);

                    let params = _this.viewer.ipsApi.parameters;
                    _this.viewer.ipsApi.parameters = params;

                    _this._hide_find_location_views();
                    const res = {
                        name: translations['viewers_mode_search_your-location'],
                        lvl: isUserOutdoor ? null : _this.mapManager.level,
                        lat: center.lat,
                        lng: center.lng,
                        position: true,
                        customPositionFn: () => {
                            if (_this.viewer.locationManager.distanceBetweenHospitalAndPoint(point) < 1) {
                                params.outdoor_profile = 'walk';
                            } else {
                                params.outdoor_profile = 'car_drop';
                            }
                        }
                    }
                    _this.modeManager.modeDirection.from = res;
                    _this.modeManager.setMode(_this.targetMode.name, {from: res}, true, true);
                });

                _this.viewer.sidePanelManager.hammer_setPosition('expanded');

            } else {
                // si inbox outdoor
                this._buildSidePanel();
            }
        } else {
            // si outdoor
            this._buildSidePanel();
        }
    }

