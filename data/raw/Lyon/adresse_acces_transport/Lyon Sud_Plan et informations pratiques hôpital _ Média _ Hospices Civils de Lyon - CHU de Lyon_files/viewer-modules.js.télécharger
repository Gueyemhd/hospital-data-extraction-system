// import DiacriticsRemoval from '/ressources/front/js/viewers/search-manager/diacritics-removal.js'

class SearchManager {

    constructor(viewer){
        this.viewer = viewer;
        this.site = this.viewer.site == undefined ? '' : this.viewer.site;
        this.diacriticsRemoval = new DiacriticsRemoval();
        this.init_fuse_search();
    }

    init_fuse_search(){
        let _this = this;
        let options = {
            shouldSort: true,
            includeScore: true,
            threshold: 0.1,
            location: 0,
            distance: 500,
            maxPatternLength: 320,
            minMatchCharLength: 1,
            keys: [
                "name",
                "keywords",
                "fuseSearch"
            ]
        };
        this.fuseArray = [];
        Object.keys(_this.viewer.dataManager.ipsTriggersInfos).forEach(function(key) {
            let ipsTriggerinfo = Object.assign({}, _this.viewer.dataManager.ipsTriggersInfos[key]);
            ipsTriggerinfo['fuseSearch'] = _this.diacriticsRemoval.removeDiacritics(ipsTriggerinfo.name.trimStart());
            if(ipsTriggerinfo.search){
                let keywords = ipsTriggerinfo['keywords'].split(';');

                $.each(keywords,function (k,keyword) {
                    ipsTriggerinfo['keywords'] = keyword.trimStart();
                    ipsTriggerinfo['fuseSearch'] = _this.diacriticsRemoval.removeDiacritics(keyword.trimStart());
                    _this.fuseArray.push(Object.assign({}, ipsTriggerinfo));
                });

                let alias = ipsTriggerinfo['alias'].length > 0 ? ipsTriggerinfo['alias'].split(';') : [];

                if(alias.length === 0){
                    if(ipsTriggerinfo.type == 'building' && _this.viewer.type == 'viewer-partner'){
                        let aliasIpsTriggerInfo = Object.assign({}, ipsTriggerinfo);
                        aliasIpsTriggerInfo['parents'] = {};
                        aliasIpsTriggerInfo['parents'][ipsTriggerinfo.id] = ipsTriggerinfo;
                        aliasIpsTriggerInfo['name'] = translations['viewers_mode_search_destination'];
                        aliasIpsTriggerInfo['alias'] = "";
                        aliasIpsTriggerInfo['fuseSearch'] = _this.diacriticsRemoval.removeDiacritics(ipsTriggerinfo.name);
                        _this.fuseArray.push(Object.assign({}, aliasIpsTriggerInfo));
                    }
                } else {
                    $.each(alias,function (k,value) {
                        let aliasIpsTriggerInfo = Object.assign({}, ipsTriggerinfo);
                        aliasIpsTriggerInfo['childrens'] = {};
                        aliasIpsTriggerInfo['parents'] = {};
                        aliasIpsTriggerInfo['parents'][ipsTriggerinfo.id] = ipsTriggerinfo;
                        aliasIpsTriggerInfo['name'] = `${value.trimStart()}<br/>( ${ipsTriggerinfo['name']} )`;
                        aliasIpsTriggerInfo['alias'] = "";
                        aliasIpsTriggerInfo['fuseSearch'] = _this.diacriticsRemoval.removeDiacritics(value.trimStart());
                        _this.fuseArray.push(Object.assign({}, aliasIpsTriggerInfo));
                    });
                }
            }
        });
        this.fuse = new Fuse(this.fuseArray, options);
    }

    search(str,google){
        let results = {};
        results['ips'] = this.search_ips(str);
        results['google'] = google ? this.search_google(str) : [];

        return results;
    }
    search_ips(str){
        let _this = this;
        let results = null;

        if(str == ""){
            results = this.fuseArray.map(val => ({
                item: Object.assign(val, {}),
                matches: [],
                score: 1
            }));
        }else{
            str = removeDiacritics(str);
            results = this.fuse.search(str);
        }

        let res = {};
        let arr = [];
        $.each(results,function (key,result) {

            let filter = true;
            if(result.item.ipsProfiles.length != 0){
                filter = false;
                $.each(result.item.ipsProfiles,function (k,ipsProfile) {
                    if(ipsProfile.id === _this.viewer.dataManager.ipsProfile.id){
                        filter = true
                    }
                });
            }
            if(res[result.item.id+result.item.name] === undefined && filter === true){
                result.item.score = result.score;
                res[result.item.id+result.item.name] = result.item;
                arr.push(result.item);
            }
        });

        arr.sort(function (a,b) {
            return (a.score - b.score) || (a.name.localeCompare(b.name));
        });

        return arr;
    }

    search_google(str){

        let res = [];
        let url = `/viewers/get-google-autocomplete?input=${str}`;
        $.ajax({
            url: this.site+url,
            method: 'GET',
            dataType: 'json',
            async: false,
            success: function(data){
                res = data['predictions'];
            }
        });

        return res;
    }

    search_google_details(googlePlaceId){

        let res = [];
        let url = `/viewers/get-google-place-details?place_id=${googlePlaceId}`;
        $.ajax({
            url: this.site+url,
            method: 'GET',
            dataType: 'json',
            async: false,
            success: function(data){
                res = data;

            }
        });

        return res;
    }

}


