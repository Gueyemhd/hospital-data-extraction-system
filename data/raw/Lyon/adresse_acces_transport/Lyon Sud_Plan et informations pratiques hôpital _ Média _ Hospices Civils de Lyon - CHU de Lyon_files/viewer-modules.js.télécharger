    toggleInstructionsButton.find('a')[0].classList.add('text-dark');
    disabledHover[0].classList.replace('d-none', 'd-block');

    if (instructions[0].classList.contains('show')) {
      instructions.collapse('hide');
      toggleInstructionsButton.find('i')[0].classList.replace('fa-angle-up', 'fa-angle-down');
    }

    let instruction = instructions[0];
    let milestoneId = this._milestone_spContent_event_getMilestoneId(instruction);

    if (milestoneId != null) {
      this._milestone_spContent_event_ignoreMilestone(milestoneId, true);
    }
  }

  _milestone_spContent_event_milestoneEnabled(currentElement, toggleInstructionsButton, instructions, disabledHover) {
    currentElement.classList.replace('text-white', 'text-danger');
    toggleInstructionsButton.find('a')[0].classList.remove('text-dark');
    $(currentElement).find('i')[0].classList.replace('fa-plus', 'fa-times');
    disabledHover[0].classList.replace('d-block', 'd-none');

    let instruction = instructions[0];
    let milestoneId = this._milestone_spContent_event_getMilestoneId(instruction);

    if (milestoneId != null) {
      this._milestone_spContent_event_ignoreMilestone(milestoneId, false);
    }
