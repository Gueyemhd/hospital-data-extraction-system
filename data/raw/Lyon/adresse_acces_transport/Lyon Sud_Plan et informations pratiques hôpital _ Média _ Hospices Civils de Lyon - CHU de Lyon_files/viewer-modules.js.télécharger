  _create_direction_milestones_all() {
    let _this = this;

    this.navigationMilestones = [];

    // Get non ignored milestones
    $.each(this.milestones, function (index, milestone) {
      if (milestone.ignore == null || !milestone.ignore) {
        _this.navigationMilestones.push(_this._buildMilestoneObj(milestone));
      }
    });

    let directions = [];
    let finalDirection;

    if (this.navigationMilestones.length > 0) {
      // If there are milestones, create a direction for each
      $.each(_this.navigationMilestones, function (index, milestone) {
        let from = milestone;
        let to = _this.to;

        if (index === 0) {
          directions.push(_this.mapManager.viewer.ipsApi.getDirection(_this.from, milestone, false));
        }

        if (_this.navigationMilestones[index + 1] !== undefined) {
          to = _this.navigationMilestones[index + 1]
        }

        directions.push(_this.mapManager.viewer.ipsApi.getDirection(from, to, false));
      });

      // Create a direction that goes to all milestones
      finalDirection = _this._buildDirectionWithMilestones(directions);
    } else {
      // If there is no milestone, create a direction with this.from and this.to
      finalDirection = _this.mapManager.viewer.ipsApi.getDirection(this.from, this.to);
      let milestoneCard = $('.card[class*=milestone-]').last();
      _this._create_direction_milestone_render_instructions(finalDirection['data'], milestoneCard);
    }

    this.direction = finalDirection['data'];
    _this.renderManager.createDirection(finalDirection['data']);
    _this.mapManager.simulationManager.simulateDirection(finalDirection, _this.from);
  }

  /**
   * Returns a milestone formatted like the original destination object.
   * @param milestone to format
   * @returns {{textDialog: string, textMilestone: string, idMapping: string, name: string, skip: boolean, type: number, featuresIds: (*|string)}}
   * @private
   */
  _buildMilestoneObj(milestone) {
    let featureId = milestone.milestones[0];
    featureId = featureId.idMapping.split('/');
    if (featureId[1] !== undefined) {
      featureId = featureId[1];
    }
    return {
      featuresIds: featureId,
      idMapping: milestone.milestones[0].idMapping,
      name: milestone.milestones[0].name,
      type: milestone.type,
      textDialog: milestone.textDialog,
      textMilestone: milestone.textMilestone,
      lat: milestone.milestones[0].latitude,
      lng: milestone.milestones[0].longitude,
      lvl: milestone.milestones[0].level,
      skip: false
    };
  }

  _buildDirectionWithMilestones(directions) {
    let _this = this;
    let finalDirection = Object.assign({}, directions[0]);

    $.each(directions, function (index, direction) {
      let milestoneCard = $(`.card.milestone-${index + 1}`);

      if (!milestoneCard[0].classList.contains('enabled')) {
        milestoneCard = milestoneCard.next('.card[class*=milestone-].enabled');
      } else if ($(`.card.milestone-${index}`).length > 0 && !$(`.card.milestone-${index}`)[0].classList.contains('enabled')) {
        milestoneCard = milestoneCard.next('.card[class*=milestone-].enabled');
      }

      _this._create_direction_milestone_render_instructions(direction['data'], milestoneCard);

      // Build final direction object
      if (index !== 0) {

        /* ----------- Data ----------- */

        // geojson
        finalDirection['data'].geojson.geometries = [].concat(finalDirection['data'].geojson.geometries, direction['data'].geojson.geometries);

        // indoorEnd
        finalDirection['data'].indoorEnd = direction['data'].indoorEnd == null ? finalDirection['data'].indoorEnd : direction['data'].indoorEnd;

        // indoorInstructions
        finalDirection['data'].indoorInstructions = [].concat(finalDirection['data'].indoorInstructions, direction['data'].indoorInstructions);

        // indoorRoute
        if (direction['data'].indoorRoute && direction['data'].indoorRoute.length !== 0) {
          if (finalDirection['data'].indoorRoute.length !== 0) {
            finalDirection['data'].indoorRoute.legs = [].concat(finalDirection['data'].indoorRoute.legs, direction['data'].indoorRoute.legs);
            finalDirection['data'].indoorRoute.routeLegs = [].concat(finalDirection['data'].indoorRoute.routeLegs, direction['data'].indoorRoute.routeLegs);
          } else {
            finalDirection['data'].indoorRoute = direction['data'].indoorRoute;
          }

          finalDirection['data'].indoorRoute.distance += direction['data'].indoorRoute.distance;
          finalDirection['data'].indoorRoute.duration += direction['data'].indoorRoute.duration;
        }

        // outdoorInstructions
        finalDirection['data'].outdoorInstructions = [].concat(finalDirection['data'].outdoorInstructions, direction['data'].outdoorInstructions);

        // outdoorRoute
        if (direction['data'].outdoorRoute && direction['data'].outdoorRoute.length !== 0) {
          if (finalDirection['data'].outdoorRoute.length !== 0) {
            finalDirection['data'].outdoorRoute.legs = [].concat(finalDirection['data'].outdoorRoute.legs, direction['data'].outdoorRoute.legs);
            finalDirection['data'].outdoorRoute.routeLegs = [].concat(finalDirection['data'].outdoorRoute.routeLegs, direction['data'].outdoorRoute.routeLegs);
          } else {
            finalDirection['data'].outdoorRoute = direction['data'].outdoorRoute;
          }

          finalDirection['data'].outdoorRoute.distance += direction['data'].outdoorRoute.distance;
          finalDirection['data'].outdoorRoute.duration += direction['data'].outdoorRoute.duration;
        }

        /* --------- Direction --------- */

        // indoorRoute
        if (direction['direction'].indoorRoute && direction['direction'].indoorRoute.length !== 0) {
          if (finalDirection['direction'].indoorRoute.length !== 0) {
            finalDirection['direction'].indoorRoute.legs = [].concat(finalDirection['data'].indoorRoute.legs, direction['data'].indoorRoute.legs);
          } else {
            finalDirection['direction'].indoorRoute = direction['direction'].indoorRoute;
          }

          finalDirection['direction'].indoorRoute.distance += direction['direction'].indoorRoute.distance;
          finalDirection['direction'].indoorRoute.duration += direction['direction'].indoorRoute.duration;
        }

        // outdoorRoute
        if (direction['direction'].outdoorRoute && direction['direction'].outdoorRoute.length !== 0) {
          if (finalDirection['direction'].outdoorRoute.length !== 0) {
            finalDirection['direction'].outdoorRoute.legs = [].concat(finalDirection['data'].outdoorRoute.legs, direction['data'].outdoorRoute.legs);
          } else {
            finalDirection['direction'].outdoorRoute = direction['direction'].outdoorRoute;
          }

          finalDirection['direction'].outdoorRoute.distance += direction['direction'].outdoorRoute.distance;
          finalDirection['direction'].outdoorRoute.duration += direction['direction'].outdoorRoute.duration;
        }
      }
    });

    return Object.assign({}, finalDirection);
  }

  _create_direction_milestone_render_instructions(direction, milestoneCard) {
