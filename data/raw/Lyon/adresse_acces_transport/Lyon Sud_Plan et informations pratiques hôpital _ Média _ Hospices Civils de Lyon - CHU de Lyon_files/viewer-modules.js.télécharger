    _update_simulation_instructions(){
        let instr = this.mapManager.simulationManager.get_instruction();

        let distance = parseInt(instr.distance);
        let objective = instr.objective;
        let instruction = instr.instruction;

        let txt = translations['viewer_mode_simulation_instruction'];
        txt = txt.replace("#distance#", distance);

        txt = distance > 3 ? txt + instruction.mainVoiceInstruction : instruction.mainVoiceInstruction;
        txt = txt.charAt(0).toUpperCase() + txt.slice(1);

        if(instruction.firstInstruction !== undefined){
            // if(instruction.modifier !== 'straight'){
                this.sidePanelManager.sp.addClass('first-instruction');
                txt = instruction.mainVoiceInstruction;
                this.spHeader_instructions.find('.first-instruction-objective .instruction').text(instruction.firstObjective);
            // }
        }

        // console.log(instr.voice+' - '+distance+' - '+txt)

        if( distance < 3) instruction.identifier = instruction.identifier+'-close';
        this.viewer.voiceManager.speak(txt,instruction.identifier);

        // Spotlight the current step of the simulation for the desktop part
        let latLng = instruction.location;
        latLng = latLng.replace('POINT (','');
        latLng = latLng.split(")").join("");
        latLng = latLng.split(' ');
        let selectedClass = 'current-leg';
        let doneClass = 'leg-done';
        let last = this.routeInstructionsContainer.find('tr[class*="' + selectedClass + '"]').first();
        let current = this.routeInstructionsContainer.find('tr[data-lat="' + latLng[0] + '"][data-lng="' + latLng[1] + '"]').first();

        // If direction contains milestones, show the current milestone
        if (this.directionType === 'milestones') {
            this.currentMilestoneInstructionsContainer = $(current).closest('[id*=milestone-instructions-]');
        }

        if ($(last).length > 0 && last[0] !== current[0]) {
            last.removeClass(selectedClass);
            last.addClass(doneClass);
        }
        current.addClass(selectedClass);

        // main objective instruction
        this.spHeader_instructions.find('.main-objective .instruction').text(txt);
        // this.spContent_instructions.find('.main-objective .instruction').text(txt);

        // main objective icon
        // this.spHeader_instructions.find('.main-objective .icon').attr('src', this.site + "/vendors/mapbox/svg/" + instruction.icon + ".svg");
        this.spHeader_instructions.find('.main-objective .icon').attr('class','icon '+instruction.icon);
        // this.spContent_instructions.find('.main-objective .icon').attr('src',this.site+"/vendors/mapbox/svg/"+instruction.icon+".svg");

        // next objective instruction
        txt = objective.instruction;
        if(objective.type.startsWith("arrive")){
            this.spHeader_instructions.find('.next-objective span b').text(translations['viewer_mode_simulation_goal']);
            // this.spContent_instructions.find('.next-objective span b').text('Objectif');
        }
        this.spHeader_instructions.find('.next-objective .instruction').text(txt);
        // this.spContent_instructions.find('.next-objective .instruction').text(txt);

        // next objective icon
        // this.spHeader_instructions.find('.next-objective .icon').attr('src', this.site + "/vendors/mapbox/svg/" + objective.type + ".svg");
        this.spHeader_instructions.find('.next-objective .icon').attr('class','icon '+objective.type);
        // this.spContent_instructions.find('.next-objective .icon').attr('src',this.site+"/vendors/mapbox/svg/"+objective.type+".svg");

    }
    _simulation_finished(){
        let _this = this;
        let data = {};

