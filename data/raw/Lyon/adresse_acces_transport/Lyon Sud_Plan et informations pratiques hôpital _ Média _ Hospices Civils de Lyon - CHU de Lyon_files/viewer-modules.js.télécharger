    manageDisplayLevelAreas(){
        let _this = this;


        let displayLevelAreaChanged = _this.viewer.dataManager.manageDisplayLevel(_this.map.getCenter());

        if(displayLevelAreaChanged){
            _this.controls['level-control']._generateOptions();
            _this.viewer.modeManager.mode._map_displayLevelChanged_event();
