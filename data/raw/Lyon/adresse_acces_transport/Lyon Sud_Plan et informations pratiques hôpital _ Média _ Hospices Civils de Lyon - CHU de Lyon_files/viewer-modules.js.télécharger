  _create_direction_render_instructions_indoor(direction) {
    let _this = this;

    let indoorInstructionsTable = $(this.instructionsIndoorTemplate.html());
    if (direction.indoorRoute === undefined) return;
    Object.keys(direction.indoorInstructions).forEach(function (key) {
