  /**
   * Transform the select into a select2 with image.
   * @private
   */
  _bindEvents_spContent_languageSelect_init() {
    let _this = this;
    let cookieLang = Cookies.get('lang');

    // If a lang cookie exists, set it as selected option if there is one
    if (cookieLang != null && this.spContent_languageSelect.find(`option[value="${cookieLang}"]`).length > 0) {
      this.spContent_languageSelect.val(cookieLang);
    }

    this.spContent_languageSelect.select2({
      // Display when options are showed
      templateResult: function (element) {
        let elementArr = element.text.split(' ');
        return $(`<span style="display: flex; align-items: center; justify-content: left;"><img class="mr-1" width="20px" height="20px" src="${_this.viewer.site}${elementArr.shift()}" alt="${elementArr.join(' ')}"/> ${elementArr.join(' ')}</span>`);
      },
      // Display of the selected option
      templateSelection: function (element) {
        let elementArr = element.text.split(' ');
        return $(`<span style="display: flex; align-items: center; justify-content: center;"><img class="mr-1" width="20px" height="20px" src="${_this.viewer.site}${elementArr.shift()}" alt="${elementArr.join(' ')}"/> ${elementArr.join(' ')}</span>`);
      }
    });

    // Remove tooltip that append on mouse enter event
    $(document).on('mouseenter', '.select2-selection__rendered', function () {
      $(this).removeAttr('title');
    });
  }

  /**
   * When value changes, the viewer's text must change.
   * @private
   */
  _bindEvents_spContent_languageSelect_change() {
    let _this = this;
    // Update cookies on language change
    this.spContent_languageSelect.on('change', function () {
      // Search for a "lang" cookie
      let cookie = Cookies.get('lang');

      if (cookie == null || cookie !== this.value) {
        if (this.value !== _this.lang) {

          // Set new lang cookie
          Cookies.set('lang', this.value);

          let url = new URL(window.location);

          url.searchParams.set('language', this.value)

          // Reload page
          location.replace(url.href);
        }
      }
    });

    // If there is no lang cookie, create it
    if (Cookies.get('lang') == null) {
      Cookies.set('lang', this.spContent_languageSelect.val());
      _this.lang = this.spContent_languageSelect.val();
    }

    this.spContent_languageSelect.trigger('change');
  }

  _defaultState() {
    // If there's a selectedFeature, we need to trigger the feature_selected_event of the map with no feature
    // So the map will clear hovers, etc (this case happens when a feature is selected, and the user came back by using the sidePane)
    if (this.map.selectedFeature) {
      this.mapManager._feature_selected_event();
    }

    this.searchInput.val("");

    // this.sidePanelManager.spContainerHeader.hide();

    if (this.from) {
      if (this.from.triggerInfoId) {
        this.from.name = this.viewer.dataManager.ipsTriggersInfos[this.from.triggerInfoId].name;
      }
      this.fromInput.val(this.from.name);
    }
    if (this.to) {
      if (this.to.triggerInfoId) {
        this.to.name = this.viewer.dataManager.ipsTriggersInfos[this.to.triggerInfoId].name;
      }
      this.toInput.val(this.to.name);
    }

    if (this.profile) {
      this.settingsProfileMenu.find('.btn').removeClass('active');
      $("input[data-value='" + this.profile + "']").closest('.btn').addClass('active');
      $("input[data-value='" + this.profile + "']").attr('checked', true)
    }

    if (this.parkingDrop === 'true') {
      this.parkingDropCheckbox.attr('checked', true);
    } else {
      this.parkingDropCheckbox.attr('checked', false);
    }

    if (this.wheelchairAccess === 'true') {
      this.wheelchairAccessCheckbox.attr('checked', true).closest('label').addClass('active');
    } else {
      this.wheelchairAccessCheckbox.attr('checked', false).closest('label').removeClass('active');
    }

    this._manageSettings();

    this.routeInstructionsContainer.empty();

    if (this.askForFrom) this.fromInput.trigger('click');

    if (this.autoFillFrom && this.viewer.location === undefined) {
      this.viewer.locationManager.getLocation(this, this.getLocationCallBack.name)
    }

    this.generateNewUrl();
  }

  generateNewUrl() {
    if(this.from !== undefined && this.to !== undefined) {

      let url = new URL(window.location);
      [
        'from-user-position',
        'from-outdoor',
        'from-ips-trigger-id',
        'to-outdoor',
        'to-ips-trigger-id',
        'ips-trigger-id',
        'routing-profile',
        'parking',
        'wheelchair'
      ].forEach(p => url.searchParams.delete(p));

      if(this.profile !== undefined) {
        url.searchParams.append('routing-profile', this.profile);
      }

      if(this.parkingDrop !== undefined) {
        url.searchParams.append('parking', this.parkingDrop);
      }

      if(this.wheelchairAccess !== undefined) {
        url.searchParams.append('wheelchair', this.wheelchairAccess);
      }

      if(this.from !== undefined) {
        if(this.from.position === true) {
          let currentLvl;
          if(this.from.lvl === null) {
            currentLvl = null;
          } else {
            currentLvl = this.mapManager.level;
          }

          url.searchParams.append('from-user-position', this.from.lat + ',' + this.from.lng + ',' + currentLvl);
        } else if(this.from.googlePlaceId) {
          url.searchParams.append('from-outdoor', this.from.googlePlaceId);
        } else {
          url.searchParams.append('from-ips-trigger-id', this.from.featureId);
        }
      }

      if(this.to !== undefined) {
        if(this.to.googlePlaceId) {
          url.searchParams.append('to-outdoor', this.to.googlePlaceId);
        } else {
          url.searchParams.append('to-ips-trigger-id', this.to.featureId);
        }
      }

      history.replaceState({}, '', url.toString());
      this.newUrl = url;

      this.spContent_InputIpsTriggerUrl.val(this.newUrl);
    }
  }

