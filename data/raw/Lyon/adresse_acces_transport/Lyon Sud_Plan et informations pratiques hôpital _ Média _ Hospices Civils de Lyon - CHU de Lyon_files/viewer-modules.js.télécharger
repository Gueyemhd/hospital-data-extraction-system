'use strict';

class ModeDirection extends Mode {

  constructor(modeManager) {
    let urlParams = new URLSearchParams(window.location.search);
    super(modeManager, 'direction');
    this.mode = this.viewer.mode;
    this.layers = [];
    this.from = undefined;
    this.to = undefined;
    this.profile = undefined;
    this.parkingDrop = this.viewer.viewerParameters['parkingDrop'] == undefined ? undefined : this.viewer.viewerParameters['parkingDrop'];
    this.wheelchairAccess = false;
    this.milestones = null;
    this.currentMilestone = null;
    this.precedentMilestone = null;
    this.ipsLog = null;
    this.directions = [];
    this.directionType = 'classic';
    this.position = undefined;

    this.legs = [];
    this.selectedStep = null;
    this.mapManager.viewer.ipsApi.addDirectionsListener(data => {
      this.selectedStep = null;
      const indoor = this.get_indoor_route(data) ?? []
      const outdoor = this.get_outdoor_route(data) ?? []
      if (data.data?.routeOrder === 'outdoor_first') {
        this.legs = outdoor.concat(indoor)
      } else {
        this.legs = indoor.concat(outdoor)
      }
      this.on_get_direction(data)
    });
  }

  // parse et recupere les legs de la route en indoor
  get_indoor_route(data) {
    return data.data.indoorRoute?.legs.map(leg => {
      return {
        type: 'indoor',
        cluster: leg.cluster,
        coordinates: leg.geojson.geometries.map(geometry => geometry.coordinates),
        labelText: () => {
          if (leg.cluster.level === 'all') {
            return translations['viewers_step-bar-label-indoor']['outdoor']
          } else {
            return `${translations['viewers_step-bar-label-indoor']['indoor']} ${leg.cluster.details.displayLevel}`
          }
        }
      }
    });
  }

  // parse et recupere les legs de la route en outdoor
  get_outdoor_route(data) {
    return data.data.outdoorRoute?.mapboxDirections?.routes[0].legs.map(leg => {
      return {
        cluster: {
          level: null
        },
        coordinates: leg.steps.map(step => {
          return [step.maneuver.location[0], step.maneuver.location[1]]
        }),
        labelText: () => {
          return translations["viewers_step-bar-label-outdoor"]
        }
      }
    });
  }

  get stepsContainer() {
    return document.getElementById('steps-container');
  }

  // au click d'une step dans la step bar
  stepOnClick(index) {
    if (this.selectedStep === index) {
      this.selectedStep = null;
      this.renderManager.initialZoom();
    } else {
      this.selectedStep = index;
      const leg = this.legs[this.selectedStep];
      const bounds = new mapboxgl.LngLatBounds();
      leg.coordinates.forEach(function (coordinates) {
        bounds.extend(coordinates);
      });
      const lvl = leg.cluster.level === 'all' ? 0 : leg.cluster.level;
      this.mapManager.controls['level-control']._setLevel(lvl);
      if ($(window).width() <= 768) {
        this.mapManager.map.fitBounds(bounds, {
          padding: { top: $('#map').height()/2.5, bottom: $('#map').height()/2.5 + 50, left: $('#map').width()/3, right: $('#map').width()/3 },
          animate: true,
        });
      } else {
        this.mapManager.map.fitBounds(bounds, { padding: { top: $('#map').height()/2.5, bottom: $('#map').height()/2.5, left: $('#map').width()/2.5, right: $('#map').width()/2.5 }, animate: true });
      }
    }
    this.updateSteps();

    // Scroll the step bar to the next step (n+1) if available.
    setTimeout(() => {
      if (this.selectedStep !== null &&
          this.selectedStep + 1 < this.legs.length &&
          this.stepsContainer &&
          this.stepsContainer.children[this.selectedStep + 1]) {
          this.stepsContainer.children[this.selectedStep + 1].scrollIntoView({
            behavior: 'smooth',
            inline: 'center'
          });
      }
    }, 250);
  }

  // creation des step et ajout dans la step bar
  updateSteps() {
    if(!this.stepsContainer) return
    this.stepsContainer.innerHTML = '<div class="leg-steps-progress-line"></div>';

    // observer pour observer la width du container parent pour que la ligne ai la meme width
    const myObserver = new ResizeObserver(entries => {
      let width = Math.max($('#steps-container').width(), this.legs.length * 90);
      $('.leg-steps-progress-line').css('width', width + 'px');
    });

    myObserver.observe(document.getElementById('steps-container'));

    this.legs.forEach((leg, index) => {

      const template = $('#leg-step-template').html();
      const newElement = $(template);
      const div = newElement[0];
      const button = $(div).find('button')[0];
      const text = $(button).find('span')[0];
      const label = $(button).find('span')[1];

      if (index === 0 && this.selectedStep === null && this.legs.length > 1) {
        button.classList.add('leg-step-animation');
      }

      if (this.selectedStep === index) {
        button.classList.add('active');
      }

      text.innerHTML = index + 1;
      $(button).on('click', () => this.stepOnClick(index));

      label.innerText = leg.labelText();
      button.appendChild(text);
      button.appendChild(label);

      this.stepsContainer.appendChild(div);
    });
  }


  // creation de la step bar, fn appelé lor de la reception de la route
  on_get_direction(data) {
    $('.leg-steps-container').remove()
    const template = $('#leg-steps-template').html();
    const newElement = $(template);
    newElement.insertAfter('#start-simulation');
    this.updateSteps()
  }

  _modeManager_setMode_event(data) {
    this._init_data(data);
    this._buildSidePanel();
    this._defaultState();
  }

  _init_data(data) {
    this.autoFillFrom = data['auto-fill-from'] ? true : false;
    this.askForFrom = data['ask-for-from'] ? true : false;

    if (data.from !== undefined) {
      this.from = data.from;
    }

    if (data.to !== undefined) {
      this.to = data.to;
    }

    if(data.settings !== undefined) {
      if(data.settings.routingProfile !== undefined) {
        this.profile = data.settings.routingProfile;
      }

      if(data.settings.parking !== undefined) {
        this.parkingDrop = data.settings.parking;
      }

      if(data.settings.wheelchair !== undefined) {
        this.wheelchairAccess = data.settings.wheelchair;
      }
    }

    this.milestones = this.currentMilestone = this.precedentMilestone = null;
    this.directions = [];

    if (this.viewer.mode == 'kiosk') {
      this.from = {
        'lat': this.viewer.kiosk['lat'],
        'lng': this.viewer.kiosk['lng']
      }
    }
  }

  _buildSidePanel() {
    this._buildSidePanel_header();
    this._buildSidePanel_header_bindEvents();

    this._buildSidePanel_content();
    this._buildSidePanel_bindEvents();

  }

  _buildSidePanel_header() {
    this.headerTemplate = $('template#template-direction_header');
    this.sidePanelManager.setHeader(this.headerTemplate);
    this.spHeader = $("#sp-header-direction");

    this.searchInput = this.spHeader.find("input[name='from'],input[name='to']");
    /** Input Search **/
    this.fromInput = this.spHeader.find("input[name='from']");
    /** Input Search **/
    this.toInput = this.spHeader.find("input[name='to']");
    /** Input Search **/
    this.returnBtn = this.spHeader.find(".return");
    /** Button return **/
    this.reverseBtn = this.spHeader.find(".reverse"); /** Button reverse **/

    this.settingsDropDownMenu = this.spHeader.find(".settings.dropdown-menu");
    /** Menu settings **/
    /** Checkbox parking drop**/
    this.parkingDropCheckbox = this.settingsDropDownMenu.find('#parking-drop');

