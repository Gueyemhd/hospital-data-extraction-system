'use strict';

new class Main {
    constructor(){

        this.notificationsHandler();
    }

    notificationsHandler(previousCookie = null) {
        let _this = this;
        // 1- Get the cookie containing the notifications
        let notifications = Cookies.get('notifications');
        Cookies.remove('notifications');

        // 2- Check if the cookie is set and is different from the previous time this fuction was called (loop/recursive function)
        if(notifications && previousCookie != notifications){
            previousCookie = notifications;
            notifications = window.atob(notifications); // unserialize cookie
            notifications = JSON.parse(notifications); // unserializr cookie

            // for each notifications in the cookie
            $.each(notifications.notifications, function( type, notificationsGroup ) {
                type = $.inArray( type, [ 'error','info','success','warning']) == -1 ? 'info' : type;
                $.each(notificationsGroup, function( key, notification) {
                    _this.sendNotyNotification(type, notification.title, notification.body, {});
                });
            });
        }
        setTimeout(function(){
            _this.notificationsHandler(previousCookie)
        }, 3000);
    }
    sendNotyNotification(type,title, body, options = {}) {

        new Noty({
            text: title+' <br/>'+body,
            theme: 'bootstrap-v4',
            type:type,
            timeout:8000,
        }).show();

    }
}
'use strict';

class IpsApi{
 
    constructor(viewer){
        this.viewer = viewer;
        this.viewer.ipsApi = this;
        this.directionsListener = []
        
        this.ipsId = viewerParameters['ipsId'];
        this.appId = viewerParameters['appId'];
		this.site = this.viewer.site == undefined ? '' : this.viewer.site;
        this.useProfile = viewerParameters['useProfiles'] == true;

        // console.log(viewerParameters)
        this.parameters = {
            "outdoor_profile":'car_drop',
            "indoor_profile":'public',
        };


        this.cache={};

        if(this.useProfile == 1 && this.viewer.viewerParameters['mobile']){
            // this._manageProfile()
        }
    }

    addDirectionsListener(listener){
        this.directionsListener.push(listener);
    }


    _manageProfile(){
        let profile = Cookies.get('ips-profile');

        if(!profile){
            let modalContent = $('#template-ips-profile-modal').html();
            $('body').append(modalContent);
            let $ipsProfileModal = $('#ips-profile-modal');
            $ipsProfileModal.modal()


            $ipsProfileModal.on('click','button',function () {
                $ipsProfileModal.modal("hide");
                Cookies.set('ips-profile', $(this).data('profile'));
            });
        }else{
            console.log('profile: '+profile)
        }

    }


    getMilestones(from,to) {
        let results = [];
        let _this = this;
        
        $.ajax({
            url: this.site + '/ips-api/milestones?appId=' + this.appId + '&endTriggerMapping=' + to.idMapping,
            data:{
              'appId':this.appId,
              'endTriggerMapping':to.idMapping
            },
            method: 'GET',
            dataType: 'json',
            async: false,
            success: function(data){
                try {
                    results = data;
                } catch (e) {
                    _this._showNotification(translations['viewers_direction-error']);
                }
            }
        });

        return results;
    }


//    /pois/<poiId>/find-v3/?start_trigger_mapping=...&end_trigger_mapping=...
//    /pois/<poiId>/find-v3/?start_position=...&end_trigger_mapping=...
//    /pois/<poiId>/find-v3/?start_position=...&end_trigger_mapping_array=...,...
//    /pois/<poiId>/find-v3/?start_trigger_mapping=...&end_position=...
    getDirection(from, to, enableCache = true) {

      // si itineraire depuis un ipsTrigger ou une po indoor
      if(!from.position && !from.googlePlaceId){
          this.parameters.outdoor_profile = 'walk'
      }
      from?.customPositionFn?.();

        let urlParams = new URLSearchParams(window.location.search);
        let indoor_profile = urlParams.get('indoor_profile');
        this.parameters['indoor_profile'] = indoor_profile != undefined ? indoor_profile : this.parameters['indoor_profile'];


        let str = JSON.stringify(from)+JSON.stringify(to)+this.parameters.indoor_profile+this.parameters.outdoor_profile;

        if(enableCache && this.cache[str] != null){
            this.viewer.loader(0);
            return this.cache[str];
        }

        this.viewer.loader(1);
        let _this = this;
        let url = '/ips-api/find-v4';

        let queryParameters = {};
        queryParameters['appId'] = this.appId;
        queryParameters['ipsId'] = this.ipsId;
        if(this.viewer.type === 'viewer-poi'){
            queryParameters['current-poi-id'] = this.ipsId;
        }else{
            queryParameters['multi-poi'] = 'yes';
        }


        if(from.lat != undefined){

            if(from.geometries != undefined){
                queryParameters['start_position_array'] = '['+from.geometries+']';
                queryParameters['start_level'] = from.geometriesLevels;
                queryParameters['start_level'] = JSON.parse(JSON.stringify(queryParameters['start_level']).replace("ext","null"));
            }else{
                queryParameters['start_position'] = from.lng+','+from.lat;
                if(from.lvl != undefined && from.lvl != 'all'){
                    queryParameters['start_level'] = from.lvl;
                }
            }
        }else{
            let arr = from.idMapping.split('/');
            if(arr.length > 1){
                queryParameters['start_trigger_mapping_array'] = `[${from.idMapping}]`;
            }else{
                queryParameters['start_trigger_mapping'] = from.idMapping;
            }
        }
        if(to.lat != undefined){
            if(to.geometries != undefined){
                queryParameters['end_position_array'] = '['+to.geometries+']';
                queryParameters['end_level'] = to.geometriesLevels;
                queryParameters['end_level'] = JSON.parse(JSON.stringify(queryParameters['end_level']).replace("ext","null"));
            }else{
                queryParameters['end_position'] = to.lng+','+to.lat;
                if(to.lvl != undefined && to.lvl != 'all'){
                    queryParameters['end_level'] = to.lvl;
                }
            }
        }else{
            let arr = to.idMapping.split('/');
            if(arr.length > 1){
                queryParameters['end_trigger_mapping_array'] = `[${to.idMapping}]`;
            }else{
                queryParameters['end_trigger_mapping'] = to.idMapping;
            }
        }

        queryParameters['indoor_profile'] = this.parameters.indoor_profile;
        if(this.useProfile){
            queryParameters['indoor_profiles'] = this.parameters.indoor_profiles;
        }
        queryParameters['outdoor_profile'] = this.parameters.outdoor_profile;

        url = url+'?'+$.param(queryParameters);

        var result = [];
        $.ajax({
            url: this.site+url,
            method: 'GET',
            dataType: 'json',
            async: false,
            success: function(data){
                try {
                    if(!data || data.message) {
                        _this._showNotification(translations['viewers_direction-private']);
                    } else {
                      if(data?.statusCode === 404){
                        _this._showNotification(translations['viewers_direction-error']);
                      }else{
                        result['direction'] = JSON.parse(JSON.stringify(data));
                        _this._formatDirection(data);
                        result['data'] = data;
                      }
                    }
                } catch (e) {
                    _this._showNotification(translations['viewers_direction-error']);
                }
            },
            complete: function(){
                _this.viewer.loader(0);
            }
        });

        if (enableCache) {
            // this.cache[str] = result;
        }
        this.directionsListener.forEach(function(listener){
            listener(result);
        });
        return result;
    }

    _showNotification(message) {
        new Noty({
            text: message,
            theme: 'bootstrap-v4',
            type:'warning',
            timeout:8000,
        }).show();
    }



    _formatDirection(data){
        data.geojson = {"type": "GeometryCollection", "geometries": []};
        this._formatDirection_indoorRoute(data);
        this._formatDirection_outdoorRoute(data);

        this._formatDirection_startRoute(data);
        this._formatDirection_middleRoute(data);
        this._formatDirection_endRoute(data);

        this._formatDirection_outdoorInstructions(data);
        this._formatDirection_indoorInstructions(data);

        this._formatDirection_startLevel(data);
    }

    _formatDirection_indoorRoute(datas){
        let _this = this;

        if(datas.indoorRoute === undefined) return;

        let routeLegs = datas.indoorRoute.legs;

        for (var i = 0; i <= routeLegs.length-1; i++) {
            routeLegs[i].geojson = JSON.parse(routeLegs[i].geojson);

            datas.geojson.geometries = datas.geojson.geometries.concat(routeLegs[i].geojson.geometries);
            if(routeLegs[i].cluster.level == null){
                routeLegs[i].cluster.level = 'all';
            }

            // If it's not the last routeLeg, remove the last geometry in the dir.geoJson (it's a "transition")
            // if(i < routeLegs.length-1) routeLegs[i].geojson.geometries.pop();


            // 1-We determine if the first point of the first geometry is "really" the first otherwise we invert it with the last of the first geometry
            let firstPointOfFirstGeometries = routeLegs[i].geojson.geometries[0].coordinates[0];
            if(routeLegs[i].geojson.geometries[0].type =='Point'){
                firstPointOfFirstGeometries = routeLegs[i].geojson.geometries[0].coordinates;
            }
            let lastPointOfFirstGeometries = routeLegs[i].geojson.geometries[0].coordinates[routeLegs[i].geojson.geometries[0].coordinates.length-1];
            if(routeLegs[i].geojson.geometries[1] && _this.searchInArray(firstPointOfFirstGeometries ,routeLegs[i].geojson.geometries[1].coordinates)){
                firstPointOfFirstGeometries = lastPointOfFirstGeometries;
            }
            // 2-We determine if the last point of the last geometry is "really" the last otherwise we invert it with the first of the last geometry
            let firstPointOfLastGeometries = routeLegs[i].geojson.geometries[routeLegs[i].geojson.geometries.length-1].coordinates[0];
            let lastPointOfLastGeometries = routeLegs[i].geojson.geometries[routeLegs[i].geojson.geometries.length-1].coordinates[routeLegs[i].geojson.geometries[routeLegs[i].geojson.geometries.length-1].coordinates.length-1];
            if(routeLegs[i].geojson.geometries[routeLegs[i].geojson.geometries.length-2] && _this.searchInArray(lastPointOfLastGeometries ,routeLegs[i].geojson.geometries[routeLegs[i].geojson.geometries.length-2].coordinates)){
                lastPointOfLastGeometries = firstPointOfLastGeometries;
            }

            // If the routeLeg is an indoor
            if(routeLegs[i].cluster.level != 'all'){

                // If it's not the first routeLeg, get the previous routeLeg, and set his "go-to-lvl" var which represent the stair/elevator
                // And also, set the var 'go-from-lvl' which is the previous level
                if(i > 0){
                    routeLegs[i-1]['go-to-lvl'] = routeLegs[i].cluster.level;
                    routeLegs[i-1]['go-to-lvl-lat-lng'] = firstPointOfFirstGeometries;
                    routeLegs[i]['go-from-lvl'] = routeLegs[i-1].cluster.level;
                    routeLegs[i]['go-from-lvl-lat-lng'] = firstPointOfFirstGeometries;
                }
                // If it's not the last routeLeg, get the next routeLeg, and set his "go-from-lvl" var which represent the stair/elevator
                // And also, set the var 'go-to-lvl' which is the next level
                if(i<routeLegs.length-1){
                    routeLegs[i+1]['go-from-lvl'] = routeLegs[i].cluster.level;
                    routeLegs[i+1]['go-from-lvl-lat-lng'] = lastPointOfLastGeometries;
                    routeLegs[i]['go-to-lvl'] = routeLegs[i+1].cluster.level;
                    routeLegs[i]['go-to-lvl-lat-lng'] = lastPointOfLastGeometries;
                }
            }

            if(i == 0){
                routeLegs[i]['start'] = firstPointOfFirstGeometries;
                datas.indoorStart = {'coordinates':firstPointOfFirstGeometries,'level':routeLegs[i].cluster.level};
            }
            if(i == routeLegs.length-1){
                routeLegs[i]['end'] = lastPointOfLastGeometries;
                datas.indoorEnd = {'coordinates':lastPointOfLastGeometries,'level':routeLegs[i].cluster.level};
            }
        }

        datas.indoorRoute.routeLegs = routeLegs;

        return datas;
    }

    searchInArray(needle,stack){
        let result = false;
        $.each(stack, function( index, value ) {
            if(value[0] == needle[0] && value[1] == needle[1]){
                result = true;
            }
        });
        return result;
    }

    _formatDirection_outdoorRoute(datas){
        if(undefined != datas.outdoorRoute){
            let encodedGeoJson = datas.outdoorRoute.mapboxDirections.routes[0].geometry;

            let geojson = polyline.toGeoJSON(encodedGeoJson);
            datas.geojson.geometries.push(geojson);
            geojson.coordinates = geojson.coordinates.map(function(e) {
              e[0] = e[0]/10;
              e[1] = e[1]/10;
              return e;
            });


            datas.outdoorStart = {'coordinates':geojson.coordinates[0],'level':'all'};
            datas.outdoorEnd = {'coordinates':geojson.coordinates[geojson.coordinates.length-1],'level':'all'};
            datas.outdoorRoute.geojson = geojson;
        }
    }
    _formatDirection_startRoute(datas){
        try{
            let geojson = JSON.parse(datas.startLinestring);
            datas.startLinestring = {};
            datas.startLinestring.geojson = geojson;
        }catch(e){
            datas.startLinestring = undefined;
        }
    }
    _formatDirection_middleRoute(datas){
        try{
            let geojson = JSON.parse(datas.middleLinestring);
            datas.middleLinestring = {};
            datas.middleLinestring.geojson = geojson;
        }catch(e){
            datas.middleLinestring = undefined;
        }
    }
    _formatDirection_endRoute(datas){
        try{
            let geojson = JSON.parse(datas.endLinestring);
            datas.endLinestring = {};
            datas.endLinestring.geojson = geojson;
        }catch(e){
            datas.endLinestring = undefined;
        }
    }

    _formatDirection_outdoorInstructions(datas){
        let instructions = [];
        if(undefined != datas.outdoorRoute){

            let steps = datas.outdoorRoute.mapboxDirections.routes[0].legs[0].steps;
            Object.keys(steps).forEach(function(key) {

                if(steps[key].maneuver.type.includes('exit')) return;

                let newStep = {};

                newStep.location = steps[key].maneuver.location;
                newStep.level = 'all';
                newStep.type = steps[key].maneuver.type;
                newStep.instruction = steps[key].maneuver.instruction;
                newStep.direction = steps[key].maneuver.modifier;
                newStep.icon = newStep.type;
                if(newStep.direction != undefined){
                    newStep.icon += '_'+newStep.direction.replace(/ /g,'_');
                }
                newStep.icon = newStep.icon.replace(/ /g,'_');
                newStep.icon = newStep.icon.replace('roundabout_turn','roundabout');

                // Object.keys(steps[key].maneuver).forEach(function(k) {
                //     newStep.location = steps[key].maneuver[k].location;
                //     newStep.type = steps[key].maneuver[k].type;
                //     newStep.instruction = steps[key].maneuver[k].instruction;
                //     newStep.direction = steps[key].maneuver[k].modifier;
                // });
                instructions.push(newStep);
            });
        }
        datas.outdoorInstructions = instructions;
    }
    _formatDirection_indoorInstructions(datas){

        if(datas.indoorRoute === undefined) return;

        let legs = datas.indoorRoute.routeLegs;
        let instructions = [];
        Object.keys(legs).forEach(function(k) {
            let steps = legs[k].steps;
            Object.keys(steps).forEach(function(key) {
                let newStep = {};

                newStep.location = steps[key].maneuver.location;
                newStep.location = newStep.location.replace('POINT (','');
                newStep.location = newStep.location.split(")").join("");
                newStep.location = newStep.location.split(' ');

                newStep.level = legs[k].cluster.level;

                newStep.type = steps[key].maneuver.type;
                newStep.modifier = steps[key].maneuver.modifier;
                newStep.instruction = steps[key].maneuver.farInstruction == undefined ? steps[key].maneuver.closeInstruction : steps[key].maneuver.farInstruction;
                newStep.direction = steps[key].maneuver.direction;

                newStep.icon = newStep.type+"_"+newStep.modifier;
                // if(newStep.direction != undefined){
                //     newStep.icon += '_'+newStep.direction.replace(/ /g,'_');
                // }
                newStep.icon = newStep.icon.replace(/ /g,'_');
                newStep.icon = newStep.icon.toLowerCase();


                // Object.keys(steps[key].maneuver).forEach(function(k) {
                //     newStep.location = steps[key].maneuver[k].location;
                //     newStep.type = steps[key].maneuver[k].type;
                //     newStep.instruction = steps[key].maneuver[k].instruction;
                //     newStep.direction = steps[key].maneuver[k].modifier;
                // });
                instructions.push(newStep);

                legs[k].steps[key].maneuver['icon'] = newStep.icon;
            });
        });
        datas.indoorInstructions = instructions;
    }
    _formatDirection_startLevel(datas){
        datas.startLevel = null;
        if(datas.indoorRoute === undefined) return;
        $.each(datas.indoorRoute.routeLegs, function( index, value ) {
			if(value.cluster.level != 'all' && datas.startLevel == null){
				datas.startLevel = value.cluster.level;
			}
        });

    }

}

'use strict';

class Control{
 
    constructor(mapManager,mustBestShowedAfterInit,position,name){
    	this.mapManager = mapManager;
        this.map = mapManager.map;
        this.control = null;
        this.name = name;
        this.position = position;
        this.init();
        this.add();
        if(!mustBestShowedAfterInit) this.hide();
    }

    // GENERIC FUNCTIONS
    add(){
        if(this.mapManager.controls[this.name]){
            console.error(`The control ${this.name} already exists`);
        }else{
            this.mapManager.controls[this.name] = this;
        }
        if(this.control){
		    this.map.addControl(this.control,this.position);
            this._add();
        }else{
            console.error(`'this.control' variable of the control named ${this.name} is null and must be set during the 'init' function`);
        }
    }

    remove(){
        if(this.control){
            this.map.removeControl(this.control);
        }else{
            console.error(`'this.control' variable of the control named ${this.name} is null and must be set during the 'init' function`);
        }
    }

    show(){
        $(this.control._container).show();
    }

    hide(){
        $(this.control._container).hide();
    }



    // ABSTRACT FUNCTIONS
    init(){
        console.warn(`init function of control named '${this.name}' is not implemented`);
    }

    _add(){
        console.warn(`_add function of control named '${this.name}' is not implemented`);
    }
}
