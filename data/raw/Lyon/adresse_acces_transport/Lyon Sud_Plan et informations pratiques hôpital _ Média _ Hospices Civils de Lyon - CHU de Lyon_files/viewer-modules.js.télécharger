'use strict';

class LevelControl extends Control{

    constructor(mapManager,mustBeShowedAfterInit = true,position = 'bottom-right'){
        super(mapManager,mustBeShowedAfterInit,position,'level-control');
    }

    init(){
		this.site = this.mapManager.viewer.site == undefined ? '' : this.mapManager.viewer.site;

        if(this.mapManager.activateMapLibre){
            this.control = new MapLibreCustomControl(this)
        }else{
		    this.control = new MapBoxCustomControl(this);
        }
        this._bindClickEvents();
    }

    _add(){

    }

    _bindClickEvents(){
        let _this = this;
        // Up button
        $('body').on('click','.level-control .level-down',function(){
          $('.level-control')?.popover('dispose');
          let nextElement = $(this).closest('.level-control').find('option:selected').next('option');
            if (nextElement.length > 0) {
                $(this).closest('.level-control').find('select').val($('select option:selected').next().val());
            }
            _this._setLevel($(this).closest('.level-control').find('select').val(),true);
        });

        // Middle button
        $('body').on('change','.level-control .level-select',function(){
          _this._setLevel($(this).val(),true);
        });

        // Down button
        $('body').on('click','.level-control .level-up',function(){
          $('.level-control')?.popover('dispose');
          let prevElement = $(this).closest('.level-control').find('option:selected').prev('option');
            if (prevElement.length > 0) {
                $(this).closest('.level-control').find('select').val($('select option:selected').prev().val());
            }
            _this._setLevel($(this).closest('.level-control').find('select').val(),true);
        });

    }


    _setLevel(level,refresh = false){
        // console.log('_setLevel: '+level+" refresh: "+refresh);
        level = (level === undefined || level === null || level === 'all') ? this.mapManager.level : level;

        if(this.mapManager.level !== level || refresh){
            // $(this.map._container).find('.level-control .level-select option[value="'+level+'"]').attr('selected','selected');
            $("body").find('.level-control .level-select').val(level);
            this.mapManager.level = parseInt(level);
            this.mapManager.levelChangedEvent();
        }
    }

    _generateOptions(){
        let _this = this;
        $(this.map._container).find('.level-control .level-select').empty();

        let min_level = null;
        let max_lvl = null;
        $.each(this.mapManager.viewer.dataManager.levels, function (key,lvl) {
            lvl = parseInt(lvl);
            if(min_level === null || min_level > lvl) min_level = lvl;
            if(max_lvl === null || max_lvl < lvl) max_lvl = lvl;

            $(_this.map._container).find('.level-control .level-select').prepend('<option value="'+lvl+'" >' + _this.mapManager.viewer.dataManager.displayLevels[lvl] + '</option>');
        });


        let lvl = this.mapManager.level ? this.mapManager.level : 0;
        min_level = parseInt(min_level);
        max_lvl = parseInt(max_lvl);

        if(lvl < min_level) lvl = min_level;
        if(lvl > max_lvl) lvl = max_lvl;

        if(!this.mapManager.viewer.dataManager.levels.includes(lvl)){
            lvl = this.mapManager.viewer.dataManager.levels.includes(0) ? 0 : this.mapManager.viewer.dataManager.levels[0];
        }

        $(this.map._container).find(`.level-control .level-select`).val(lvl);
        this._setLevel(lvl,true);
    }
}






/* MAPBOX CUSTOM CONTROL */
class MapBoxCustomControl{
    constructor(levelControl){
        this.site = levelControl.site;
    }
    onAdd(map){
        // console.log(this)
        this._map = map;
        this._container = document.createElement('div');
        this._container.className = 'level-control mapboxgl-ctrl';

        this._container.innerHTML =
            '<div class="mapboxgl-ctrl-group">'+
            '   <button class="mapboxgl-ctrl-icon level-up tooltipstered w-100" type="button" title="'+translations['viewers_controls-level-up']+'">'+
            '       <div class="fas fa- fa-lg fa-chevron-up"/>'+
            '   </button>'+
            '   <select class="mapboxgl-ctrl-icon level-select no-select2 tooltipstered" type="select" title="'+translations['viewers_controls-level-selected']+'"></select>'+
            '   <button class="mapboxgl-ctrl-icon level-down tooltipstered w-100" type="button" title="'+translations['viewers_controls-level-down']+'">'+
            '       <div class="fas fa- fa-lg fa-chevron-down"/>'+
            '   </button>'+
            '</div>';
        return this._container;

    }

