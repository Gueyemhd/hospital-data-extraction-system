    /**
     * Transform the select into a select2 with image.
     * @private
     */
    _bindEvents_spContent_languageSelect_init()
    {
        let _this = this;
        let cookieLang = Cookies.get('lang');

        // If a lang cookie exists, set it as selected option if there is one
        if (cookieLang != null && this.spContent_languageSelect.find(`option[value="${cookieLang}"]`).length > 0)
        {
            this.spContent_languageSelect.val(cookieLang);
        }

        this.spContent_languageSelect.select2({
            // Display when options are showed
            templateResult: function (element)
            {
                let elementArr = element.text.split(' ');
                return $(`<span style="display: flex; align-items: center; justify-content: left;"><img class="mr-1" width="20px" height="20px" src="${_this.viewer.site}${elementArr.shift()}" alt="${elementArr.join(' ')}"/> ${elementArr.join(' ')}</span>`);
            },
            // Display of the selected option
            templateSelection: function (element)
            {
                let elementArr = element.text.split(' ');
                return $(`<span style="display: flex; align-items: center; justify-content: center;"><img class="mr-1" width="20px" height="20px" src="${_this.viewer.site}${elementArr.shift()}" alt="${elementArr.join(' ')}"/> ${elementArr.join(' ')}</span>`);
            }
        });

        // Remove tooltip that append on mouse enter event
        $(document).on('mouseenter', '.select2-selection__rendered', function ()
        {
            $(this).removeAttr('title');
        });
    }

    /**
     * When value changes, the viewer's text must change.
     * @private
     */
    _bindEvents_spContent_languageSelect_change()
    {
        let _this = this;
        // Update cookies on language change
        this.spContent_languageSelect.on('change', function ()
        {
            // Search for a "lang" cookie
            let cookie = Cookies.get('lang');

            if (cookie == null || cookie !== this.value)
            {
                if(this.value !== _this.lang){

                    // Set new lang cookie
                    Cookies.set('lang', this.value);

                    let url = new URL(window.location);

                    url.searchParams.set('language',this.value)

                    // Reload page
                    location.replace(url.href);
                }
            }
        });

        // If there is no lang cookie, create it
        if (Cookies.get('lang') == null)
        {
            Cookies.set('lang', this.spContent_languageSelect.val());
            _this.lang = this.spContent_languageSelect.val();
        }

        this.spContent_languageSelect.trigger('change');
    }

