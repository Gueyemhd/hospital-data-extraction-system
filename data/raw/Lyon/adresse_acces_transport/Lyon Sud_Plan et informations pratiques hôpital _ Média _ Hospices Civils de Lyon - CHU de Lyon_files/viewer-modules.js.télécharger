class VoiceManager {

    constructor(viewer, parameters){
        this.viewer = viewer;
        this.parameters = parameters;
		this._init();
	}

	_init(){
		this.speech = new SpeechSynthesisUtterance();
        this.enabled = this.parameters.enabled ?? false; // disabled for the moment
		this.previousText = undefined;
		this.previousIdentifier = undefined;
		this.speech.lang = this.viewer.language;
    }

    speak(text, identifier = undefined){
        if(this.enabled){
            let sameText = this.previousText == text;
            let sameIdentifier = (identifier != undefined && this.previousIdentifier == identifier);
            let alreadySpeaking = window.speechSynthesis.speaking;

            if(!sameText && !sameIdentifier && !alreadySpeaking){
                this.previousText = text;
                this.previousIdentifier = identifier;
                this.speech.text = text;
                //console.error('Speak: (identifier:'+identifier+') '+text)
                window.speechSynthesis.speak(this.speech);
            }
        }
    }

    enableVoice(){
        this.enabled = true
    }
    disableVoice(){
        this.enabled = false;
    }
}
