class LocationManager {

  constructor(viewer, parameters) {
    this.parameters = parameters;
    this.viewer = viewer;
    this.position = undefined;   // undefined == no one asked for position yet , null == position rejected or not supported, position = {...} position object
    this.processing = false; // undefined == no location were asked yet, true == an location is processing
    this.positionDenied = false;
    this.isPositionDeniedInit = false;
    this.enabled = this.parameters.enabled ?? false; // disabled for the moment
  }


  getLocation(caller, callback, errorCallback) {
    let _this = this;

    if (this.enabled === false) {
      if (typeof caller[callback] === 'function') caller[callback]();
      return;
    }
    if (_this.processing === true) return; // if processing is on true, it means that the location is already on processing

    _this.viewer.loader(1); //Block UI
    // If navigation API is available
    if (navigator.geolocation) {
      function success(position) {
        //console.log("position", position);
        _this.processing = false;
        _this.position = position;
        _this.viewer.loader(0); //Free UI
        if (typeof caller[callback] === 'function') caller[callback]();

      }

      function error(error) {
        _this.processing = false;
        switch (error.code) {
          case error.PERMISSION_DENIED:
            _this.positionDenied = true;
            console.error("User denied the request for Geolocation.");
            break;
          case error.POSITION_UNAVAILABLE:
            console.error("Location information is unavailable.");
            break;
          case error.TIMEOUT:
            console.error("The request to get user location timed out.");
            break;
          default:
            console.error("An unknown error occurred.");
            break;
        }
        if (_this.position === undefined) {
          _this.position = null;
          _this.viewer.loader(0); //Free UI
          if (typeof caller[callback] === 'function') caller[callback]();
        }else {
          if(_this.position === null){
            _this.viewer.loader(0); //Free UI
          }
        }
          errorCallback?.(error);
      }
      _this.isPositionDeniedInit = true;

      let options = {'enableHighAccuracy': true, 'timeout': 10000};
      navigator.geolocation.getCurrentPosition(success, error, options);
      _this.processing = true;

      _this.timeOutFunction = setTimeout(function (e) {
        if (_this.position === undefined) {
          _this.position = null;
          _this.viewer.loader(0); //Free UI
          if (typeof caller[callback] === 'function') caller[callback]();
        }
      }, options.timeout);
    } else {
      console.error("Geolocation is not supported by this browser.");
      _this.position = null;
      _this.viewer.loader(0); //Free UI
      if (typeof caller[callback] === 'function') caller[callback]();
    }
  }

  isUserInHospital(){
    if(this.position === null || this.position === undefined) return false;
    const pos = this.position.coords;
    const user = [pos.longitude, pos.latitude];
    const point = turf.point(user);
    return this.isPointInHospital(point);
  }

  isPointInHospital(point){
    return turf.booleanPointInPolygon(point, this.viewer.dataManager.inBoxMaster);
  }

  distanceBetweenHospitalAndPoint(point) {
    // Vérifier si le point est à l'intérieur du polygone
    if (turf.booleanPointInPolygon(point, { type: 'Polygon', coordinates: this.viewer.dataManager.inBoxMaster.geometry.coordinates })) {
      return 0;
    }

    let minDistance = Infinity;
    // Chaque polygone peut comporter plusieurs anneaux (le premier correspond à la bordure extérieure, les autres à des éventuels trous)
    this.viewer.dataManager.inBoxMaster.geometry.coordinates.forEach(function (ring) {
      // Créer une ligne correspondant à l'anneau
      const line = turf.lineString(ring);
      // Calculer la distance du point à cette ligne
      const distance = turf.pointToLineDistance(point, line, { units: 'kilometers' });
      if (distance < minDistance) {
        minDistance = distance;
      }
    });

    return minDistance;
  }

}

class MobileAppPopup {
  constructor() {
    this.overlay = document.getElementById('mappOverlay');
    this.closeBtn = document.getElementById('mappCloseBtn');
    this.downloadBtn = document.getElementById('mappDownloadBtn');
    this.continueWebBtn = document.getElementById('mappContinueBtn');

    this.init();
  }

  init() {
    // Détecter si c'est un mobile
    this.isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

    // Vérifier si l'utilisateur a déjà fait un choix (simulation avec sessionStorage)
    this.hasSeenPopup = sessionStorage.getItem('mobileAppPopupSeen') === 'true';

    // Afficher automatiquement sur mobile si pas encore vu
    if (this.isMobile && !this.hasSeenPopup && viewerParameters['mobileAppPopup'] === 'true' && window.location.search.length === 0) {
      setTimeout(() => this.show(), 1000);
    }

    this.bindEvents();
    this.setupAppStoreLinks();
  }

  bindEvents() {
    // Fermer avec le bouton X
    this.closeBtn.addEventListener('click', () => this.hide());

    // Fermer en cliquant sur l'overlay
    this.overlay.addEventListener('click', (e) => {
      if (e.target === this.overlay) {
        this.hide();
      }
    });

    // Continuer sur le web
    this.continueWebBtn.addEventListener('click', () => {
      this.markAsSeen();
      this.hide();
    });

    // Échapper pour fermer
