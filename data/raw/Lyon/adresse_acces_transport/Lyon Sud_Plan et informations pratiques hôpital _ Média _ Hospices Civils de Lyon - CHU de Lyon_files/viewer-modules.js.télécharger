	_create_geoJsonPoint_from_ipsTrigger(ipsTrigger,ipsTriggerInfo){

		// Function for handle displayLevel areas for managing displayLevel
		this.getIpsTriggerDisplayLevel(ipsTrigger);

		if(ipsTriggerInfo.ipsTriggersFeaturesIds === undefined) ipsTriggerInfo.ipsTriggersFeaturesIds = [];
		if(ipsTriggerInfo.ipsTriggersFeaturesIds[ipsTrigger.displayLevel] === undefined) ipsTriggerInfo.ipsTriggersFeaturesIds[ipsTrigger.displayLevel] = [];

		let properties = {};

		if(ipsTriggerInfo.properties && ipsTriggerInfo.properties.length > 0) properties = JSON.parse(ipsTriggerInfo.properties);

		if(ipsTriggerInfo.displayName) properties['displayName'] = ipsTriggerInfo.displayName;
		if(ipsTriggerInfo.ipsTriggerInfoIcon == null){
			properties['icon'] = 'default';
		}else{
			properties['icon'] = ipsTriggerInfo.ipsTriggerInfoIcon.id + '-' + ipsTriggerInfo.ipsTriggerInfoIcon.name;
			properties['ipsTriggerInfoIcon'] = ipsTriggerInfo.ipsTriggerInfoIcon;
		}

		properties['name'] = ipsTriggerInfo.name;
		properties['displayLevel'] = ipsTrigger.displayLevel;
		properties['level'] = ipsTrigger.level;
		properties['lvl'+ipsTrigger.level] = true;
		properties['id_sweepin'] = ipsTrigger.id;
		properties['idMapping'] = ipsTrigger.idMapping;
		properties['id'] = ipsTrigger.idMapping;
		properties['id'] = properties['id'].split('/')[1];
		properties['ipsTriggerInfo'] = ipsTriggerInfo;
		properties['ipsTriggerInfoId'] = ipsTriggerInfo.id;

		properties['ipsProfiles'] = [];

		$.each(ipsTriggerInfo.ipsProfiles, function(index, value){
			properties['ipsProfiles'].push(value.ref);
		})

		if (properties['ipsProfiles'].length < 1) properties['ipsProfiles'] = '';


		ipsTriggerInfo.ipsTriggersFeaturesIds[ipsTrigger.displayLevel].push(properties['id']);

		if(ipsTrigger.displayLongitude !== 0){
			ipsTrigger.longitude = ipsTrigger.displayLongitude;
			ipsTrigger.latitude = ipsTrigger.displayLatitude;
		}

		let newGeoJsonPoint =
			{
				"id": properties['id'],
				"type": "Feature",
				"geometry": {
					"type": "Point",
					"coordinates": [ipsTrigger.longitude,ipsTrigger.latitude]
				},
				"properties": properties
			};

		return newGeoJsonPoint;

	}



	manageDisplayLevel(center){
		let _this = this;

        let centerLngLat = [center.lng,center.lat];
        let point = turf.point(centerLngLat);

        // Get nearest "pois"

		let closestPoi = null;
		let distance = null;
		$.each(_this.pois,function(id,poi){
			let poiPoint = turf.point([poi.longitude,poi.latitude]);

			let dist = turf.distance(point,poiPoint);
			if(distance === null || dist < distance ){
				distance = dist;
				closestPoi = poi;
			}
		});

        // By default we load the default levels
        let newDisplayLevels = closestPoi.levels;
        let newDisplayLevelsId = closestPoi.id;

        // Parse levelAreas to find if there's a corresponding levelArea
        $.each(_this.levelAreas,function(id,feature){
		 	if(turf.booleanWithin(point, feature.geometry)){
                newDisplayLevels = feature.properties.displayLevels;
        		newDisplayLevelsId = id;
            }
		});

        let displayLevelsChanged =  _this.displayLevelsId !== newDisplayLevelsId;
        if(displayLevelsChanged === true){
        	_this.previousDisplayLevels = _this.displayLevelsId;
        	_this.displayLevelsId = newDisplayLevelsId;
        	_this.displayLevels = newDisplayLevels;
        	_this.levels = [];

        	$.each(_this.displayLevels,function(key,value){
        		_this.levels.push(parseInt(key));
			});
        	_this.levels.sort((a,b)=>a-b);
        }

        return displayLevelsChanged;
	}
}

