  _create_direction_milestone_one() {
    let _this = this;
    if (this.currentMilestone == null) {
      // If this is the first milestone, we use as start this.from
      this.precedentMilestone = this.from;

      $.each(this.milestones, function (i, milestone) {
        if (_this._buildMilestoneObj(milestone).idMapping == _this.from.idMapping) {
          _this.currentMilestone = _this._buildMilestoneObj(milestone);
        }
      })

      this._nextMilestone();
    }

    let direction = this.mapManager.viewer.ipsApi.getDirection(this.precedentMilestone, this.currentMilestone);
    this.direction = direction['data'];

    this.renderManager.createDirection(direction['data']);
    this.mapManager.simulationManager.simulateDirection(direction, this.precedentMilestone);
  }

  _nextMilestone() {
    // If there are milestones, we will use them as directions
    if (this.currentMilestone == null) {
      let firstMilestone = this.milestones[0];
      this.currentMilestone = this._buildMilestoneObj(firstMilestone);
    } else {
      // If this is not the first milestone, we will use the current milestone as start and the next milestone as destination
      for (let index = 0; index < this.milestones.length; index++) {
        if (this.currentMilestone.idMapping == this.milestones[index].milestones[0].idMapping) {
          if (this.currentMilestone.skip == false) {
            // Use the current milestone as the precedent one
            this.precedentMilestone = this.currentMilestone;
          }

          // Define the new current milestone
          if (this.milestones[index + 1] != null) {
            // If we can find a milestone, we will use the precedent milestone as start and current one as destination
            let nextMilestone = this.milestones[index + 1];
            this.currentMilestone = this._buildMilestoneObj(nextMilestone);
          } else {
            // If there is no more milestone, use this.to as destination
            this.currentMilestone = this.to;
          }
          break;
        }
      }
    }
  }

