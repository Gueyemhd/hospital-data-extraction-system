    /** INSTRUCTIONS DESKTOP */
    _render_instructions() {
        let direction = this.direction;

        this.routeInstructionsContainer.empty();

        if (this.directionType === 'classic') {
            if (direction.routeOrder === 'outdoor_first'){
                this._render_instructions_outdoor(direction);
                this._render_instructions_indoor(direction);
            } else {
                this._render_instructions_indoor(direction);
                this._render_instructions_outdoor(direction);
            }
        } else {
            $(this.milestoneInstructionsContainer).find('.milestones-container').detach().appendTo(this.routeInstructionsContainer);
            $(this.milestoneInstructionsContainer).find('#route-instructions-milestones').detach().appendTo(this.routeInstructionsContainer);

            $.each($('.enable-milestone'), function (index, element) {
                element.classList.add('disabled');
            });
        }

        this.spContent_simulationDestinationTxt.text(this.to.name);
        this.spHeader_instructions.find(".destination .destination-text").text(this.to.name)
    }

    _render_instructions_indoor(direction) {
        let _this = this;

        let indoorInstructionsTable = $(this.instructionsIndoorTemplate.html());
        if (direction.indoorRoute === undefined) return;
        Object.keys(direction.indoorInstructions).forEach(function(key,i) {
            let instruction = direction.indoorInstructions[key];
            let row = $(_this.instructionsIndoorTemplateRow.html());
            row.attr('data-lat', instruction.location[0]);
            row.attr('data-lng', instruction.location[1]);
            row.attr('data-lvl', instruction.level);
            row.attr('data-in', true);
            // row.find('img').attr('src', _this.site + "/vendors/mapbox/svg/" + instruction.icon + ".svg");
            row.find('img').addClass(instruction.icon)
            let txt = instruction.instruction.charAt(0).toUpperCase() + instruction.instruction.slice(1);
            row.find('.title').text(txt);
            indoorInstructionsTable.find('table').append(row);
        });

        if (direction.indoorInstructions.length > 0) {
            this.routeInstructionsContainer.append(indoorInstructionsTable);
        }
    }

    _render_instructions_outdoor(direction) {
        let _this = this;

        let outdoorInstructionsTable = $(this.instructionsOutdoorTemplate.html());

        Object.keys(direction.outdoorInstructions).forEach(function(key) {
            let instruction = direction.outdoorInstructions[key];

            let row = $(_this.instructionsOutdoorTemplateRow.html());

            row.attr('data-lat',instruction.location[0]);
            row.attr('data-lng',instruction.location[1]);
            row.attr('data-lvl',instruction.level);
            // row.find('img').attr('src', _this.site + "/vendors/mapbox/svg/" + instruction.icon + ".svg");
            row.find('img').addClass(instruction.icon)

            let txt = instruction.instruction.charAt(0).toUpperCase() + instruction.instruction.slice(1);
