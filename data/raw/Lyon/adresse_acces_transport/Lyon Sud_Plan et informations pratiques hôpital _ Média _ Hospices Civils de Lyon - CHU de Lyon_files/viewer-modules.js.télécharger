  _bindEvents_simulationBtn() {
    // On click of the start navigation button
    let _this = this;
    this.spContent.on('click', 'button.start-direction', (e) =>{
      e.stopImmediatePropagation();
      // si mobile et l'utilisateur loin de l'hopital et utilise sa pos comme point de depart
      const copyFrom = {... this.from};
      if ($(window).width() <= 768 && copyFrom?.position === true) {

          let point;
          try{
              const tmp = ()=> { return {lat : _this.viewer.locationManager.position.coords.latitude, lng : _this.viewer.locationManager.position.coords.longitude}};
              const center = _this.viewer.locationManager?.position?.coords ? tmp() : {lat : _this.viewer.fromUserPosition.split(',')[0] , lng : _this.viewer.fromUserPosition.split(',')[1]} ;
              point = turf.point([center.lng, center.lat]);
          }
          catch (e){}


          if (point && _this.viewer.locationManager.distanceBetweenHospitalAndPoint(point) > 1 && ((!_this.viewer.locationManager.positionDenied && _this.viewer.locationManager.isPositionDeniedInit) || _this.viewer.location !== null)) {

          $('#DirectionModalStartGuidance').modal('show');

          $('#DirectionModalStartGuidance').find('.btn-primary').off('click').on('click', function () {

            var ua = navigator.userAgent.toLowerCase();
            var isAndroid = ua.indexOf("android") > -1;
            if (isAndroid) {
              // Utilise le schéma google.navigation pour démarrer la navigation sur Android
              window.location = `google.navigation:q=${_this.mapManager.lat},${_this.mapManager.lng}`;
            } else {
              // Utilise le paramètre daddr pour définir la destination dans Apple Maps
              window.location = `http://maps.apple.com/?daddr=${_this.mapManager.lat},${_this.mapManager.lng}`;
            }
          });


          $('#DirectionModalStartGuidance').find('.btn-secondary').off('click').on('click', function () {
              if(!_this.viewer.fromUserPosition) {
                _this.viewer.locationManager.getLocation(this, null)
              }
          });

          return
        }


      }
      let data = {
        'from': _this.from,
        'to': _this.to,
        'direction': _this.direction,
        'directionType': _this.directionType,
        'currentMilestone': _this.currentMilestone,
        'milestones': _this.milestones
      }
      if (_this.directionType === 'milestones') data.routeInstructionsContainer = _this.routeInstructionsContainer;
      _this.modeManager.setMode('simulation', data);
    });
  }

  _manageIpsLog() {

    let _this = this;
    // Create IpsLog
    let data = {'direction': 1};
    let directionStr = JSON.stringify(this.direction);

    // Get Qr
    if (this.from.qr) {
      data.qr = this.from.qr;
    }

    // Get origin
    if (this.from.idMapping) {
      data.originIpsTriggerInfo = this.from.triggerInfoId;
      let idsMapping = this.from.idMapping.split(',');
      if (idsMapping.length > 1) {
        let geometries = this.from.geometries.match(/[^,]+,[^,]+/g);
        // Find which geometry is used
        $.each(geometries, function (key, value) {
          let lngLat = value.split(",");
          if (directionStr.includes(lngLat[0])) {
            data.originIpsTrigger = idsMapping[key];
            data.originLongitude = lngLat[0];
            data.originLatitude = lngLat[1];
          }
        });
      } else {
        data.originIpsTrigger = this.from.idMapping;
        data.originLatitude = this.from.lat;
        data.originLongitude = this.from.lng;
      }
    } else {
      data.originLatitude = this.from.lat;
      data.originLongitude = this.from.lng;
    }


    // Get destination
    if (this.to.idMapping) {
      data.destinationIpsTriggerInfo = this.to.triggerInfoId;
      let idsMapping = this.to.idMapping.split(',');
      if (idsMapping.length > 1 && this.to.geometries) {
        let geometries = this.to.geometries.match(/[^,]+,[^,]+/g);
        // Find which geometry is used
        $.each(geometries, function (key, value) {
          let lngLat = value.split(",");

          if (directionStr.includes(lngLat[0])) {
            data.destinationIpsTrigger = idsMapping[key];
            data.destinationLongitude = lngLat[0];
            data.destinationLatitude = lngLat[1];
          }
        });

      } else {
        data.destinationIpsTrigger = this.to.idMapping;
        data.destinationLatitude = this.to.lat;
        data.destinationLongitude = this.to.lng;
      }
    } else {
      data.destinationLatitude = this.to.lat;
      data.destinationLongitude = this.to.lng;
    }


    if (this.ipsLog == null || this.fromDetail === false) {
      this._createIpsLog(data);
    } else {
      this._updateIpsLog(data);
    }

    this.fromDetail = false;
  }

  _createIpsLog(data, fromDetail = false) {
    this.fromDetail = fromDetail;
    let _this = this;
    let url = `/viewers/create-ips-log`;
    data.poi = this.viewer.poiId;
    data.partner = this.viewer.partnerId;
    data.apiId = this.viewer.apiId;

    if (this.viewer.kiosk) {
      data.deviceType = 'kiosk';
      data.kiosk = this.viewer.kiosk.id;
    }
    if (this.viewer.fromKiosk) {
      data.kiosk = this.viewer.fromKiosk;
    }
    data = JSON.stringify(data);
    $.ajax({
      url: this.viewer.site + url,
      type: 'POST',
      async: true,
      data: data,
      success: function (data) {
        data = JSON.parse(data);
        _this.ipsLog = data.id;
      }
    });
  }

  _updateIpsLog(data) {
    let _this = this;
    let url = `/viewers/update-ips-log/` + this.ipsLog;
    data = JSON.stringify(data);
    $.ajax({
      url: this.viewer.site + url,
      type: 'PATCH',
      async: false,
      data: data,
      success: function (data) {
        data = JSON.parse(data);
      }
    });
  }

  _bindEvents_directionInstructionHoover() {
    // On hoover of a direction line => go to level and create point
    let _this = this;
    this.routeInstructionsContainer.on('click', 'tr', function (e) {
      _this.routeInstructionsContainer.find('tr.selected').removeClass('selected');
      $(this).addClass('selected');
      let latLng = [$(this).data('lat'), $(this).data('lng')];

      _this.mapManager.goTo($(this).data('lvl'), latLng, false)
      _this.sidePanelManager.hammer_setPosition("collapsed");
    });
  }

  _clear_direction() {
    if (this.mode != 'kiosk') this.from = undefined;
    this.to = undefined;
    this.milestones = null;
    this.currentMilestone = null;
    this.precedentMilestone = null;
    this.renderManager.previousDirection = undefined;
    this.renderManager.removeDirection();
  }

  _reverse_direction() {
    let a = this.from;
    this.from = this.to;
    this.to = a;
    this._defaultState();
  }

  _manageQr() {
    this._displayQr();
    this.qr_generation();
  }

  _displayQr() {
    this.showQrContainer.empty();
    let showQr = $(this.qrTemplate.html());
    this.showQrContainer.append(showQr);
    $('.qr-viewer, .card-title').hide()
    if ($(window).width() >= 768) {
      $('.generate-qr').on('click', function () {
        $('.card-title, .qr-viewer').show();
        $(this).hide();
      })
    }
    if (this.mode == 'kiosk') {
      $('.generate-qr').click();
      this.downloadDirectionContainer.show();
    }

  };

  qr_generation() {

    let url = new URL(this.viewer.viewerParameters['qr-url']);

    // From part
    if (this.from.idMapping) {
      url.searchParams.append('from-id-mapping', this.from.idMapping);
      url.searchParams.append('from-ips-trigger-info-id', this.from.triggerInfoId);
    } else {
      url.searchParams.append('from-lat', this.from.lat);
      url.searchParams.append('from-lng', this.from.lng);
    }

    if (this.from.lvl) {
      url.searchParams.append('from-lvl', this.from.lvl);
    }

    // To part
    if (this.to.idMapping) {
      url.searchParams.append('dir-id-mapping', this.to.idMapping);
      url.searchParams.append('dir-ips-trigger-info-id', this.to.triggerInfoId);
    } else {
      url.searchParams.append('dir-lat', this.to.lat);
      url.searchParams.append('dir-lng', this.to.lng);
    }

    if (this.to.lvl) {
      url.searchParams.append('dir-lvl', this.to.lvl);
    }

    if (this.viewer.qrLat && this.viewer.qrLng) {
      url.searchParams.append('qr-lat', this.viewer.qrLat);
      url.searchParams.append('qr-lng', this.viewer.qrLng);
    }

    if (this.viewer.kiosk) {
      url.searchParams.append('kiosk', this.viewer.kiosk.id);
      url.searchParams.append('from-name', this.viewer.kiosk.name);
    }

    $('.qr-viewer').qrcode({
      "render": 'image',
      "size": 200,
      "text": url.toString(),
      "radius": 0.5
    });
  }

  //</editor-fold>

}


jQuery.fn.swapWith = function(to) {
    return this.each(function() {
        var copy_to = $(to).clone(true);
        var copy_from = $(this).clone(true);
        $(to).replaceWith(copy_from);
        $(this).replaceWith(copy_to);
    });
};

