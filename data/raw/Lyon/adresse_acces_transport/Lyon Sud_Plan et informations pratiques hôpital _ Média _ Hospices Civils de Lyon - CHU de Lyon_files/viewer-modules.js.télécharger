        });
        this.map.on('dragstart', function (e) {
            _this.viewer.modeManager.mode._map_drag_event(e);
        });
    }


    /** Move event listener, propagated to the mode **/
    _bind_moveEvent(){
        let _this = this;
        this.map.on('move', () => {
            _this.manageDisplayLevelAreas();
