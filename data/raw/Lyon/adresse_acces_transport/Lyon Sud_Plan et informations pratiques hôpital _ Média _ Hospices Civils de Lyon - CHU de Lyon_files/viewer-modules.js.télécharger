    /** Get feature from the mode layers list **/
    /** Triggered from a map event (mousemove, mouseleave, click, ...) **/
    _map_event_get_feature(e){
        let _this = this;
        let features = _this.map.queryRenderedFeatures(e.point);
        let feature = undefined;
        let i = 0;
        if(features.length > 0 && _this.layers.length > 0){
            do {
                $.each(_this.layers, function (index,layerName) {
                    if(features[i].layer && features[i].layer.id.endsWith(layerName)){
                        // If the feature haven't an "interactive" property OR the interactive property is set and true then return the feature
                        if(features[i]['properties']['interactive'] === undefined || features[i]['properties']['interactive'] === 1){
                            feature = features[i];
                        }
                    }
                });
                i++;
            }while(!feature && i < features.length);
        }
        return feature;
    }
