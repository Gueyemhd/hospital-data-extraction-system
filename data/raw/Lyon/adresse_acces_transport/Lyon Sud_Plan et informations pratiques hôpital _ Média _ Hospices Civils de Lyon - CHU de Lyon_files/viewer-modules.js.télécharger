	createDirection(datas){
		// We don't need to clear + draw layers if the createDirection is called with the same datas
		if(this.previousDirection == undefined || this.previousDirection != datas){

			// Clear previous direction
			if(this.previousDirection) {
				this.removeDirection();
			}
			this.previousDirection = datas;


			// Add indoorRoute layers
			this.createDirection_indoorRoute(datas);

			// Add outdoorRoute layer
			this.createDirection_outdoorRoute(datas);

			// Add middleLineRoute layer
			this.createDirection_middleLineRoute(datas);

			// Update the layer 'direction-line'
			// this._update_layer_src('direction-line');

			//Create markers start & end
			this.createStartEndMarker(datas);
		}

		// Change to level corresponding of the first Leg
		let lvl = datas.startLevel;
		this.mapManager.controls['level-control']._setLevel(lvl,true);


		// let bearing = turf.bearing(turf.point(datas.geojson.geometries[0].coordinates[0]), turf.point(datas.geojson.geometries[0].coordinates[1]));
		let bearing = 0; // set to 2 for Johan approval

		// Set the map pitch & bearing
		this.map.setPitch(0);
		this.map.setBearing(bearing);

		// Zoom to have the direction displayed
    this.initialZoom = _ =>{
      let bbox = turf.bbox(datas.geojson)
      let padding = { top: $('#map').height()/2.5, bottom: $('#map').height()/2.5, left: $('#map').width()/2.5, right: $('#map').width()/2.5 };
      if ($(window).width() < 768) {
        padding =  { top: $('#map').height()/2.5, bottom: $('#map').height()/2.5, left: $('#map').width()/3, right: $('#map').width()/3};
      }
      this.map.fitBounds(bbox, {padding: padding,bearing:bearing});
      this.mapManager.controls['level-control']._setLevel(lvl,true);
    }
		this.initialZoom();
	}

	createDirection_indoorRoute(datas){
		let _this = this;

		if(datas.indoorRoute === undefined) return;
		$.each(datas.indoorRoute.routeLegs, function( index, value ) {
			let lvl = value.cluster.level == null ? 'all' : value.cluster.level;
			let feature = {"type":"Feature","properties":{"level":lvl},"geometry":value.geojson}
			feature['properties']['lvl_'+lvl] = true;
			_this.viewer.dataManager._addFeature(feature,'direction-line');

			if(value['go-to-lvl'] !== undefined) _this.createDirectionElevatorMarker(value,'go-to-lvl');
			if(value['go-from-lvl'] !==undefined) _this.createDirectionElevatorMarker(value,'go-from-lvl');
		});
	}
	createDirection_outdoorRoute(datas){
		if(datas.outdoorRoute !== undefined){
			let feature = {"type":"Feature","properties":{"level":"all"},"geometry":datas.outdoorRoute.geojson};
			feature['properties']['lvl_all'] = true;
      feature.properties["max-zoom"] = 24
      feature.properties["min-zoom"] = 0
			this.viewer.dataManager._addFeature(feature,'direction-line');
		}
	}
	createDirection_middleLineRoute(datas){
		let cluster = undefined;
		if(datas.middleLinestring !== undefined){
			// Cases:
			// indoor -> outdoor direction: middleLineRoute is added to the level of the last indoorRoute leg
			// outdoor -> indoor direction: middleLineRoute is added to the level of the first indoorRoute leg
			if(datas.routeOrder === 'indoor_first'){
				cluster = datas.indoorRoute.legs[datas.indoorRoute.legs.length-1].cluster;
			}else{
				cluster = datas.indoorRoute.legs[0].cluster;
			}
			let lvl = cluster.level == null ? 'all' : cluster.level;

			let feature = {"type":"Feature","properties":{"level":lvl},"geometry":datas.middleLinestring.geojson};
			feature['properties']['lvl_'+lvl] = true;
      feature.properties["max-zoom"] = 24
      feature.properties["min-zoom"] = 0
			this.viewer.dataManager._addFeature(feature,'direction-line');
		}
	}

	removeDirection() {
		let _this = this;


		// Empty sourceDirection features
		this.viewer.dataManager.sources['direction-line'] ={};
		// Update the layers 'direction-line' (there's direction-lin at each level
		$.each(_this.map.getStyle().layers, function( index, layer ) {
			if(layer.id.endsWith(`direction-line`)){
				_this._update_layer_src('sweepin_direction-point');
			}
		});


		// Empty sourceDirection features
		this.viewer.dataManager.sources['direction-point'] ={};
		// Update the layer 'direction-point'
		this._update_layer_src('sweepin_direction-point');
		this._update_layer_src('sweepin_direction-point-halo');

		// Remove start , end , stairs / elevators markers
		$(' .direction-end, .direction-start, .direction-go-from-lvl-up, .direction-go-from-lvl-down, .direction-go-to-lvl-up, .direction-go-to-lvl-down').remove();
		this._levelChangedEvent();
	}


	createDirectionElevatorMarker(datas,type){
		let _this = this;
		let targetLvl = datas[type];
		let lvl = datas.cluster.level;

		if(targetLvl === lvl || targetLvl === 'all' || lvl === 'all' || targetLvl == null || lvl == null){
			return;
		}

		var markerLatLng = null;
		switch(type){
			case 'go-to-lvl':
				markerLatLng = datas.geojson.geometries[datas.geojson.geometries.length-1].coordinates[datas.geojson.geometries[datas.geojson.geometries.length-1].coordinates.length-1];
				break;
			case 'go-from-lvl':
				markerLatLng = datas['go-from-lvl-lat-lng'];
				break;
			default:
				console.error(type);
		}

		let direction = datas.cluster.level < targetLvl ? 'up' : 'down' ;

		var el = document.createElement('div')
		el.dataset.targetLvl = targetLvl;
		el.dataset.level = datas.cluster.level;
		el.className = `direction-${type}-${direction}`;
		new mapboxgl.Marker(el).setLngLat(markerLatLng).addTo(this.mapManager.map);

		el.addEventListener('click',function(e){
			e.stopPropagation();
			e.preventDefault();
			_this.mapManager.controls['level-control']._setLevel($(this).data('target-lvl'));
		});
	}
	createStartEndMarker(datas){
		let start = null;
		let startLvl = null;
		let end = null;
		let endLvl = null;

		if(datas.routeOrder == 'outdoor_first'){
			// Outdoor => Indoor
			start = datas.outdoorStart.coordinates;
			startLvl = datas.outdoorStart.level;
			end = datas.indoorEnd.coordinates;
			endLvl = datas.indoorEnd.level;
		}else if(datas.routeOrder == 'indoor_first'){
			// Indoor => Outdoor
			start = datas.indoorStart.coordinates;
			startLvl = datas.indoorStart.level;
			end = datas.outdoorEnd.coordinates;
			endLvl = datas.outdoorEnd.level;
		}else if(datas.indoorRoute === undefined){
			// Outdoor => Outdoor
			start = datas.outdoorStart.coordinates;
			startLvl = datas.outdoorStart.level;
			end = datas.outdoorEnd.coordinates;
			endLvl = datas.outdoorEnd.level;
		}else{
			// Indoor => Indoor
			start = datas.indoorStart.coordinates;
			startLvl = datas.indoorStart.level;
			end = datas.indoorEnd.coordinates;
			endLvl = datas.indoorEnd.level;
		}
		if(!this.viewer.location){
			this._createMarker(start,startLvl,'start');
		}
		this._createMarker(end,endLvl,'end');
	}

	_createMarker(latLng,level,type){
		var el = document.createElement('div');
		el.dataset.level = level;
		el.className = `direction-${type}`;
		new mapboxgl.Marker(el).setLngLat(latLng).addTo(this.mapManager.map);
	}
}

'use strict';

class simulationManager {

    constructor(mapManager) {
        this.mapManager = mapManager;
        this.map = mapManager.map;
        this.mapManager.simulationManager = this;
    }

    simulateDirection(direction, from) {
        this.from = this.mapManager.viewer.modeManager.modes['direction'].from;
        this.to = this.mapManager.viewer.modeManager.modes['direction'].to;
        this.currentMilestone = this.mapManager.viewer.modeManager.modes['direction'].currentMilestone;
        this.milestones = this.mapManager.viewer.modeManager.modes['direction'].milestones;

        direction = direction['data'];
        this.qrCoordinates = [from.qrLng, from.qrLat]
        this.getDirectionRoute(direction);
    }

    getDirectionRoute(direction) {
        this.routeLegs = (direction && direction.indoorRoute) ? direction.indoorRoute.legs || [] : [];
        this.segmentDistance = 0.05;
        this.SegmentsCoordinates = this.getStepsFromLegs(this.routeLegs);
        this.outDoorSegmentsCoordinates = this.getStepsFromOutdoorLegs(direction);
        // Merge outdoor and indoor steps
        if (direction.routeOrder === "indoor_first") this.SegmentsCoordinates = this.SegmentsCoordinates.concat(this.outDoorSegmentsCoordinates);
        else this.SegmentsCoordinates = this.outDoorSegmentsCoordinates.concat(this.SegmentsCoordinates);

        this.nbStep = this.countInstructions();
        if (direction.routeOrder === "indoor_first" || this.routeLegs.length === 0) this.nbStep--;

        if (!(this.qrCoordinates[0] == null || this.qrCoordinates[1] == null || this.qrCoordinates[0] == undefined || this.qrCoordinates[1] == undefined)) {
            if ($(window).width() < 768) {
                this.firstInstruction();
                this.nbStep++;
            }
        }
    }

    getStepsFromOutdoorLegs(direction) {
        let data = [];

        // Process outdoorRoute steps
        direction?.outdoorRoute?.mapboxDirections?.routes[0]?.legs[0]?.steps?.forEach((instruction, index) => {

            const location = instruction.intersections[0].location;
            data.push({
                coordinates: location,
                lvl: 'all',
                outdoor: true,
                instruction: {
                    type: instruction.maneuver.type,
                    modifier: instruction.maneuver.modifier,
                    instruction: instruction.maneuver.instruction,
                    mainInstruction: instruction.maneuver.instruction,
                    mainVoiceInstruction: instruction.maneuver.instruction,
                    location: `POINT (${location[0]} ${location[1]})`,
                    identifier: `outdoor-${index}`,
                },
                objective: {
                    instruction: instruction.maneuver.instruction,
                    type: instruction.maneuver.type,
                },
                distance: instruction.distance,
            });
        });

        // remove last
        if (data.length > 0 && direction.routeOrder !== "indoor_first" && this.routeLegs.length > 0) {
            data.pop();
        }

        return data;
    }

    /** ***************************************** **/

    /*** FORMATTING DATAS FOR SIMULATION MANAGER ***/
    /** ***************************************** **/
    getStepsFromLegs(routeLegs) {
        let segmentsCoordinates = [];
        let _this = this;
        // For each indoor route legs
        $.each(routeLegs, function (index, indoorRouteLeg) {
            if (indoorRouteLeg.distance === 0) return;
            let geojson = indoorRouteLeg['geojson'];
            let lineStrings = geojson['geometries'];
            let lvl = indoorRouteLeg['cluster']['level'];
            let objective = indoorRouteLeg['goal'];
            let instruction = undefined;
            // For each line string representing the route leg
            $.each(lineStrings, function (i, lineString) {
                instruction = indoorRouteLeg['steps'][i]['maneuver'];
                instruction.identifier = index + '.' + i;
                //Get all the coordinates inside the lineString
                let coordinates = _this.getStepsFromLegs_getLineStringCoordinates(lineString, lvl, instruction, objective);
                segmentsCoordinates = segmentsCoordinates.concat(coordinates);
            });
        });
        return segmentsCoordinates;
    }


    getStepsFromLegs_getLineStringCoordinates(lineString, lvl, instruction, objective) {

        let line = turf.lineString(lineString["coordinates"]);
        let along = turf.lineChunk(line, this.segmentDistance, {units: 'meters'});
        let destination = lineString['coordinates'][1];
        let res = [];
        // coordinates.push(along.features[0].geometry.coordinates[0]); // We get the first coordinate of the first lineString returned by turf.
        res.push({
            'lvl': lvl,
            'coordinates': along.features[0].geometry.coordinates[0],
            'instruction': instruction,
            'objective': objective,
            'distance': Math.ceil(turf.distance(along.features[0].geometry.coordinates[0], destination, {units: 'meters'}))
        });


        // Then we get all last coordinate of the lineStrings returned by turf
        $.each(along.features, function (index, feature) {
            let data = {
                'lvl': lvl,
                'coordinates': feature.geometry.coordinates[1],
                'instruction': instruction,
                'objective': objective,
                'distance': Math.ceil(turf.distance(feature.geometry.coordinates[1], destination, {units: 'meters'}))
            };
            if (index < (along.features.length - 1)) {
                res.push(data);
            }
        });

        return res;
    }


    init_simulation() {
        this.index = 0;

        this.zoom = 21;
        this.pitch = 60;

        this.pause = true;
        this.stop = false;
        this.center_simulation();

        $('button.simulation-previous').off('click').click(() => {
            this.previous_instruction();
        });

        $('button.simulation-next').off('click').click(() => {
            this.next_instruction();
        });

        this.instructions = [];
        this.indexInstructionIndex = 1;

        $('span.simulation-step').text(`${translations['viewer_mode_simulation_step']}  ${this.indexInstructionIndex} / ${this.nbStep}`)

        this.init_camera_direction();
    }

    init_simulation_milestone() {
        this.index = 0;

        this.pitch = 60;

        this.pause = true;
        this.stop = false;

        this.init_camera_direction();
    }

    init_camera_direction() {

        let currentPoint = this.SegmentsCoordinates[this.index];
        let currentPointCoordinates = currentPoint.coordinates;
        let nextPointCoordinates = this.qrCoordinates[0] != null ? this.qrCoordinates : this.SegmentsCoordinates[this.index + 1].coordinates;
        let bearing = turf.bearing(turf.point(currentPointCoordinates), turf.point(nextPointCoordinates));

        let camera = {
            center: currentPointCoordinates,
            duration: 200,
            bearing: bearing,
            pitch: this.pitch,
            zoom: 20
        };
        this.drawDirectionPoint(currentPoint, bearing);
        this.map.flyTo(camera);

        setTimeout(() => {
            this.mapManager.viewer.modeManager.modes['simulation']._update_simulation_level()
        }, 500);
    }

    play_simulation() {
        this.pause = false;

        if (this.mapManager.viewer.modeManager.modes['simulation'].directionType === 'milestones') {
            this.mapManager.viewer.modeManager.modes['simulation'].currentMilestoneInstructionsContainer.collapse('show');
        }

        this.updateCamera();
        this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
    }

    pause_simulation() {
        this.pause = true;
    }

    stop_simulation() {
        this.stop = true;
        if (this.isAnimationRunning()) {
            this.cancelAnimation();
        }
        this.mapManager.renderManager.removeDirection();
    }

    center_simulation() {
        this.forceBearing = true;
        this.forcePitch = false;
        this.followPoint = true;
        this.simulate();
        this.updateCamera();
    }

    get_instruction() {
        return this.SegmentsCoordinates[this.index];
    }

    first_instruction_exists() {
        let instruction = this.get_instruction();
        return instruction.instruction.firstInstruction == 1;
    }

    changeLevel_simulation() {
        this.targetLevel = undefined;
    }


    simulate() {
        let currentPoint = this.SegmentsCoordinates[this.index];
        let nextPoint = this.SegmentsCoordinates[this.index + 1];

        // If there's a next point continue process
        if (nextPoint) {
            // Calculate the bearing if there's a nextPoints
            let bearing = turf.bearing(turf.point(currentPoint.coordinates), turf.point(nextPoint.coordinates));
            this.bearingBeforeLaunching = bearing;

            // Draw a point at lat/lng
            this.drawDirectionPoint(currentPoint, bearing);

            this.mapManager.viewer.modeManager.modes['simulation']._update_simulation();

        } else {
            if (this.currentMilestone != null && this.currentMilestone.idMapping != this.to.idMapping) {
                this.pause_simulation();
                // _this.index = 0; // set index to 0 otherwise, when start the next milestone, it's immediatly at the end
                this.mapManager.viewer.modeManager.modes['direction'].milestoneCompleteModal();
            } else {
                this.mapManager.viewer.modeManager.modes['simulation']._simulation_finished();
                this.mapManager.viewer.modeManager.modes['direction']._clear_direction();
            }
        }
    }

    simulate_pauseSimulationOnMilestone(index) {
        const _this = this;
        const currentPoint = this.SegmentsCoordinates[index];
        if (currentPoint === undefined) return;
        const lastPoint = this.SegmentsCoordinates[this.SegmentsCoordinates.length - 1];

        if (currentPoint.instruction.type === 'arrive' && lastPoint.instruction.location !== currentPoint.instruction.location) {
            this.pause_simulation();

            // Get current milestone
            $.each(this.milestones, function (key, milestone) {
                let milestoneCoordinates = [milestone.milestones[0].longitude, milestone.milestones[0].latitude];
                $('.card-control').hide();
                let milestoneContent = `<lottie-player src="${_this.mapManager.viewer.site}/ressources/front/js/viewers/json_animations/${milestone.type}.json" background="transparent" speed="1" class="w-75 h-auto" loop autoplay></lottie-player>` +
                    `<div class="h-100 d-flex align-items-center w-75"><p class="text-center font-weight-bold w-100">${milestone.textMilestone}</p></div>`;
                $('.milestone-complete .milestone-information').html(milestoneContent);
                $('.milestone-complete').show();
                $('[id*=milestone-instructions-]').collapse('hide');

                $.each($('i.fa-angle-up'), function (index, element) {
                    element.classList.replace('fa-angle-up', 'fa-angle-down');
                })
            });
        }
    }


    adaptingZoom(index = this.index) {
        let distance = this.SegmentsCoordinates[index]['distance']
        if (distance < 10) {
            this.zoom = 21;
        } else if (distance < 50 && distance > 10) {
            this.zoom = 20;
        } else {
            this.zoom = 19;
        }
        return this.zoom;
    }


    /** ***************************************** **/

    /***            SIMULATION RENDERING         ***/
    /** ***************************************** **/

    drawDirectionPoint(currentPoint, bearing) {
        let layerIds = ["sweepin_direction-point", "sweepin_direction-point-halo"];

        layerIds.forEach((layerId) => {
            let src = this.getDirectionPointSrc(currentPoint, bearing);
            if (this.mapManager.renderManager._checkIfLayerExist(layerId)) {
                let layer = this.mapManager.map.getSource(layerId);
                // @ts-ignore
                layer?.setData(src, bearing);
            }
        });
    }

    getDirectionPointSrc(currentPoint, bearing) {

        let feature = {
            'type': 'FeatureCollection',
            'features': [
                {
                    'type': 'Feature',
                    'properties': {
                        "bearing": bearing,
                        "level": currentPoint.lvl.toString()
                    },
                    'geometry': {
                        'type': 'Point',
                        'coordinates': currentPoint.coordinates
                    }
                }
            ]
        }

        feature.features[0].properties['lvl_' + currentPoint.lvl] = true;

        return feature;
    }

    firstInstruction() {

        let firstPoint = this.routeLegs[0]['geojson']['geometries'][0]['coordinates'][0];
        let bearingA = turf.bearing(firstPoint, this.qrCoordinates); // reverse bearing ( bearing while scanning the Qr code )
        let bearingB = this.SegmentsCoordinates[1]['instruction']['bearingBefore'];

        let diffBearing = bearingA - bearingB;
        let bearing = diffBearing;

        bearing = bearing < -180 ? 360 + bearing : bearing;
        bearing = bearing > 180 ? bearing - 360 : bearing;

        // bearingA = 360 - bearingA;
        this.bearingBeforeLaunching = bearingA;

        let firstInstruction = {
            'bearingAfter': 0,
            'bearingBefore': 0,
            'closeInstruction': 'null',
            'closeVoiceInstruction': "null",
            'icon': null,
            'location': "POINT (2.09487573310920 49.064533894020)",
            'mainInstruction': "null",
            'mainVoiceInstruction': "null",
            'modifier': "straight",
            'type': "turn",
            'firstInstruction': 1,
            'identifier': 'first-instruction'
        }

        /** First instruction is in front of user **/
        if ((bearing <= 35 && bearing > 0) || (bearing < 0 && bearing >= -35)) {
            firstInstruction['bearingAfter'] = bearingA
            firstInstruction['bearingBefore'] = 0
            firstInstruction['closeInstruction'] = translations['viewer_mode_simulation_first_instruction_straight_instruction']
            firstInstruction['closeVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_straight_instruction']
            firstInstruction['icon'] = 'turn_straight'
            firstInstruction['location'] = 'POINT (' + this.qrCoordinates[0] + ' ' + this.qrCoordinates[1] + ')'
            firstInstruction['mainInstruction'] = translations['viewer_mode_simulation_first_instruction_straight_instruction']
            firstInstruction['firstObjective'] = translations['viewer_mode_simulation_first_instruction_straight_objective']
            firstInstruction['mainVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_straight_instruction']
            firstInstruction['modifier'] = 'straight'
            firstInstruction['type'] = 'turn'

        }

        /** First instruction is on left of user **/
        if (bearing <= 135 && bearing > 35) {
            firstInstruction['bearingAfter'] = 0
            firstInstruction['bearingBefore'] = 0
            firstInstruction['closeInstruction'] = translations['viewer_mode_simulation_first_instruction_left_instruction']
            firstInstruction['closeVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_left_instruction']
            firstInstruction['icon'] = 'turn_left'
            firstInstruction['location'] = 'POINT (' + this.qrCoordinates[0] + ' ' + this.qrCoordinates[1] + ')'
            firstInstruction['mainInstruction'] = translations['viewer_mode_simulation_first_instruction_left_instruction']
            firstInstruction['firstObjective'] = translations['viewer_mode_simulation_first_instruction_left_objective']
            firstInstruction['mainVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_left_instruction']
            firstInstruction['modifier'] = 'left'
            firstInstruction['type'] = 'turn'

        }

        /** First instruction is behind of user **/
        if ((bearing <= 180 && bearing > 135) || (bearing < -135 && bearing >= -180)) {
            firstInstruction['bearingAfter'] = 0
            firstInstruction['bearingBefore'] = 0
            firstInstruction['closeInstruction'] = translations['viewer_mode_simulation_first_instruction_behind_instruction']
            firstInstruction['closeVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_behind_instruction']
            firstInstruction['icon'] = 'uturn'
            firstInstruction['location'] = 'POINT (' + this.qrCoordinates[0] + ' ' + this.qrCoordinates[1] + ')'
            firstInstruction['mainInstruction'] = translations['viewer_mode_simulation_first_instruction_behind_instruction']
            firstInstruction['firstObjective'] = translations['viewer_mode_simulation_first_instruction_behind_objective']
            firstInstruction['mainVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_behind_instruction']
            firstInstruction['modifier'] = 'behind'
            firstInstruction['type'] = 'turn'

        }

        /** First instruction is on right of user **/
        if (bearing < -35 && bearing >= -135) {
            firstInstruction['bearingAfter'] = 0
            firstInstruction['bearingBefore'] = 0
            firstInstruction['closeInstruction'] = translations['viewer_mode_simulation_first_instruction_right_instruction']
            firstInstruction['closeVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_right_instruction']
            firstInstruction['icon'] = 'turn_right'
            firstInstruction['location'] = 'POINT (' + this.qrCoordinates[0] + ' ' + this.qrCoordinates[1] + ')'
            firstInstruction['mainInstruction'] = translations['viewer_mode_simulation_first_instruction_right_instruction']
            firstInstruction['firstObjective'] = translations['viewer_mode_simulation_first_instruction_right_objective']
            firstInstruction['mainVoiceInstruction'] = translations['viewer_mode_simulation_first_instruction_right_instruction']
            firstInstruction['modifier'] = 'right'
            firstInstruction['type'] = 'turn'

        }


        // if(firstInstruction['modifier'] !== 'straight'){
        this.SegmentsCoordinates[0]['instruction'] = firstInstruction;
        // }
    }

    countInstructions() {
        let steps = 1;
        let index = 0;
        const totalSegments = this.SegmentsCoordinates.length;

        // Tant que l'on n'a pas parcouru tous les segments
        while (index < totalSegments) {
            steps++; // On compte une nouvelle étape
            const currentId = this.SegmentsCoordinates[index].instruction.identifier;

            // On avance tant que l'instruction reste identique
            while (
                index < totalSegments - 1 &&
                this.SegmentsCoordinates[index + 1].instruction.identifier === currentId
                ) {
                index++;
            }

            // Passage au segment suivant (première occurrence d'une nouvelle instruction)
            index++;
        }

        return steps;
    }


    // Met à jour la caméra et le point affiché en se basant sur this.index
    updateCamera() {
        const currentPoint = this.SegmentsCoordinates[this.index];
        let bearing = 0;
        if (this.index < this.SegmentsCoordinates.length - 1) {
            bearing = turf.bearing(
                turf.point(currentPoint.coordinates),
                turf.point(this.SegmentsCoordinates[this.index + 1].coordinates)
            );
        }
        this.drawDirectionPoint(currentPoint, bearing);
        this.mapManager.controls['level-control']._setLevel(currentPoint.lvl, true)
        this.map.easeTo({
            center: currentPoint.coordinates,
            bearing: bearing,
            pitch: this.pitch,
            zoom: this.adaptingZoom(),
            padding: {top: 500, bottom: 100, left: 100, right: 100},
            duration: 300
        });
    }

// Passe à l'instruction suivante dans SegmentsCoordinates
    next_instruction() {
        // On récupère l'identifiant de l'instruction actuelle
        const currentId = this.SegmentsCoordinates[this.index].instruction.identifier;
        const currentLvl = this.SegmentsCoordinates[this.index].lvl;
        let newIndex = this.index;
        let currentIndex = this.index;
        let push = true;

        if (this.isAnimationRunning()) {
            this.cancelAnimation();
            this.updateCamera();
            this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
            if (!this.secondHelpOverlay) {
                this.secondHelpOverlay = true;
                this.mapManager.viewer.modeManager.modes['simulation']._showHelpIfNeeded();
            }
            if (this.index === this.SegmentsCoordinates.length - 1) {
                this.indexInstructionIndex++;
                this.mapManager.viewer.modeManager.modes['simulation']._simulation_finished();
                this.mapManager.viewer.modeManager.modes['direction']._clear_direction();
            }
            return;
        }

        // Avance tant que l'instruction reste identique et qu'on n'est pas à la fin du tableau
        while (
            newIndex < this.SegmentsCoordinates.length - 1 &&
            this.SegmentsCoordinates[newIndex + 1].instruction.identifier === currentId
            ) {
            newIndex++;
        }

        const next = this.SegmentsCoordinates[newIndex + 1];
        const current = this.SegmentsCoordinates[currentIndex];

        if (next) {
            if (next.lvl !== currentLvl) {
                if (next.lvl !== 'all' && next.lvl != null && currentLvl != null && currentLvl !== 'all') {
                    this.targetLevel = next.lvl;

                    $('div.control-level,button.simulation-change-level').off('click.next_instruction').on('click.next_instruction', () => {
                        this.index++;
                        this.updateCamera();
                        this.mapManager.viewer.modeManager.modes['simulation']._update_simulation();
                        this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
                        setTimeout(() => {
                            this.mapManager.viewer.modeManager.modes['simulation']._update_simulation_level()
                        }, 500);
                    });
                    push = false;
                } else {
                    this.mapManager.controls['level-control']._setLevel(next.lvl === 'all' ? 0 : next.lvl, true);
                    this.mapManager.simulationManager.changeLevel_simulation();
                    newIndex = newIndex + 1;
                }
            } else {
                newIndex = newIndex + 1;
            }
        }

        this.simulate_pauseSimulationOnMilestone(newIndex);


        // Si possible, passer à la première occurrence de la prochaine instruction
        if (newIndex < this.SegmentsCoordinates.length - 1) {
            if (newIndex !== currentIndex) {
                const points = this.SegmentsCoordinates.slice(this.index, newIndex);
                this.index = newIndex;
                if (push) this.instructions.push(newIndex);
                this.indexInstructionIndex++;
                if (next.outdoor) {
                    this.updateCamera();
                    this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
                } else {
                    if(current.outdoor){
                        this.updateCamera();
                        this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
                    }else{
                        this.animateThroughPoints(points, currentIndex, 'next');
                    }
                }
            }
        } else {
            if (this.currentMilestone != null && this.currentMilestone.idMapping != this.to.idMapping) {
                this.pause_simulation();
                this.mapManager.viewer.modeManager.modes['direction'].milestoneCompleteModal();
            } else {
                const points = this.SegmentsCoordinates.slice(this.index, this.SegmentsCoordinates.length - 1);
                this.animateThroughPoints(points, currentIndex, 'next', () => {
                    this.mapManager.viewer.modeManager.modes['simulation']._simulation_finished();
                    this.mapManager.viewer.modeManager.modes['direction']._clear_direction();
                });
            }
            this.index = this.SegmentsCoordinates.length - 1;
        }
    }

    /**
     * Anime la caméra à travers une série de points à une vitesse constante de 5 km/h
     * @param {Array} points - Liste des points à animer (éléments de SegmentsCoordinates)
     * @param {Number} index - Index du point actuel
     * @param {String} next_or_back - 'next' ou 'back' pour savoir si on avance ou recule
     * @param {Function} finishedFn - Fonction à appeler lorsque l'animation est terminée
     */
    animateThroughPoints(points, index, next_or_back, finishedFn = null) {
        // Annuler l'animation précédente si elle existe
        this.cancelAnimation();

        // Mettre à jour l'état d'animation
        this.isAnimating = true;

        // Créer un nouveau jeton d'animation
        const token = {cancelled: false};
        this.animationToken = token;

        const totalSegments = points.length - 1;
        if (totalSegments <= 0) {
            this.isAnimating = false;
            return;
        }

        // Vitesse constante en km/h
        const speed = 5; // 5 km/h
        const speedMetersPerSecond = speed * 1000 / 3600; // Conversion en m/s

        // Calculer la longueur totale du chemin en mètres
        let totalDistance = 0;
        for (let i = 0; i < totalSegments; i++) {
            const from = points[i].coordinates;
            const to = points[i + 1].coordinates;
            const segmentDistance = turf.distance(turf.point(from), turf.point(to), {units: 'meters'});
            totalDistance += segmentDistance;
        }

        // Calculer les distances cumulées pour chaque segment
        const cumulativeDistances = [0];
        let cumulativeDistance = 0;
        for (let i = 0; i < totalSegments; i++) {
            const from = points[i].coordinates;
            const to = points[i + 1].coordinates;
            const segmentDistance = turf.distance(turf.point(from), turf.point(to), {units: 'meters'});
            cumulativeDistance += segmentDistance;
            cumulativeDistances.push(cumulativeDistance);
        }


        const startTime = performance.now();

        const animate = (currentTime) => {
            if (token.cancelled) {
                this.isAnimating = false;
                return;
            }

            const elapsed = currentTime - startTime;
            const distanceTraveled = (elapsed / 1000) * speedMetersPerSecond;

            // Si on a dépassé la distance totale, terminer l'animation
            if (distanceTraveled >= totalDistance) {
                this.updateCamera();
                this.isAnimating = false;
                this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
                if (!this.secondHelpOverlay) {
                    this.secondHelpOverlay = true;
                    this.mapManager.viewer.modeManager.modes['simulation']._showHelpIfNeeded();
                }
                finishedFn?.();
                return;
            }

            // Trouver le segment actuel
            let currentSegment = 0;
            while (currentSegment < totalSegments && cumulativeDistances[currentSegment + 1] < distanceTraveled) {
                currentSegment++;
            }

            // Calculer la progression dans le segment actuel
            const segmentStart = cumulativeDistances[currentSegment];
            const segmentEnd = cumulativeDistances[currentSegment + 1];
            const segmentDistance = segmentEnd - segmentStart;
            const segmentProgress = segmentDistance > 0 ?
                (distanceTraveled - segmentStart) / segmentDistance : 0;

            const startPoint = points[currentSegment];
            const endPoint = points[currentSegment + 1];

            // Vérification que les points et leurs coordonnées existent
            if (!startPoint || !startPoint.coordinates || !endPoint || !endPoint.coordinates) {
                console.error(`Point manquant pour le segment ${currentSegment}:`, startPoint, endPoint);
                this.isAnimating = false;
                return;
            }

            // Interpolation de la position
            const currentLng = startPoint.coordinates[0] +
                (endPoint.coordinates[0] - startPoint.coordinates[0]) * segmentProgress;
            const currentLat = startPoint.coordinates[1] +
                (endPoint.coordinates[1] - startPoint.coordinates[1]) * segmentProgress;
            const currentCoordinates = [currentLng, currentLat];

            // Calcul de l'orientation (bearing)
            let bearing;
            if (next_or_back === 'next') {
                bearing = turf.bearing(
                    turf.point(startPoint.coordinates),
                    turf.point(endPoint.coordinates)
                );
            } else if (next_or_back === 'back') {
                bearing = turf.bearing(
                    turf.point(endPoint.coordinates),
                    turf.point(startPoint.coordinates)
                );
            }

            // Mise à jour de la caméra
            this.map.flyTo({
                center: currentCoordinates,
                bearing: bearing,
                pitch: this.pitch,
                zoom: this.adaptingZoom(index),
                duration: 0 // frame par frame
            });

            // Dessin du point de direction
            this.drawDirectionPoint({coordinates: currentCoordinates, lvl: startPoint.lvl}, bearing);

            // Continuer l'animation
            this.animationFrameId = requestAnimationFrame(animate);
        };

        this.animationFrameId = requestAnimationFrame(animate);
    }

    /**
     * Annule l'animation en cours si elle existe
     */
    cancelAnimation() {
        if (this.animationToken) {
            this.animationToken.cancelled = true;
        }

        if (this.animationFrameId) {
            cancelAnimationFrame(this.animationFrameId);
            this.animationFrameId = null;
        }

        // Mettre à jour l'état d'animation
        this.isAnimating = false;
    }

    /**
     * Vérifie si une animation est en cours
     * @returns {boolean} true si une animation est en cours, false sinon
     */
    isAnimationRunning() {
        return this.isAnimating === true;
    }


// Revient à l'instruction précédente
    previous_instruction() {

        if (this.isAnimationRunning()) {
            this.cancelAnimation();
        }

        if (this.instructions.length > 1) {
            let current;
            if (this.instructions[this.instructions.length - 1] === this.index) {
                current = this.instructions.pop();
            } else {
                current = this.index;
            }
            this.index = this.instructions[this.instructions.length - 1];

            const currentLvl = this.SegmentsCoordinates[current].lvl;
            const previousLvl = this.SegmentsCoordinates[this.index].lvl;

            const points = this.SegmentsCoordinates.slice(this.index, current);
            points.reverse();

            // si la precedente instruction est sur un autre etage en pop le dernier pour ne pas affichier la dialog
            if (currentLvl !== previousLvl && previousLvl != null && currentLvl != null) {
                this.index = this.instructions[this.instructions.length - 1];
                const level = this.SegmentsCoordinates[this.index].lvl === 'all' ? 0 : this.SegmentsCoordinates[this.index].lvl;
                this.mapManager.controls['level-control']._setLevel(level, true);
                this.mapManager.simulationManager.changeLevel_simulation();
                this.updateCamera();
                setTimeout(() => {
                    this.mapManager.viewer.modeManager.modes['simulation']._update_simulation_level()
                }, 500);
            } else {
                // this.animateThroughPoints(points,current,'back');
                this.updateCamera();
            }
            this.indexInstructionIndex--;
        } else {
            if (this.index !== 0) {
                this.indexInstructionIndex--;
            }
            this.index = 0;
            this.updateCamera();
        }
        this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
    }

    instructionfromLatLong(lat, long) {

        if (this.isAnimationRunning()) {
            this.cancelAnimation();
        }

        const currentLvl = this.SegmentsCoordinates[this.index].lvl;

        let identifier = 0;
        let identifierIndex = [];
        const instruction = this.SegmentsCoordinates.find((element, i) => {
            if (element.instruction.identifier !== identifier) {
                identifier = element.instruction.identifier;
                identifierIndex.push(i);
            }
            return element.coordinates[0] === lat && element.coordinates[1] === long;
        });

        if (instruction === undefined) {
            return;
        }

        identifierIndex.pop();
        this.index = identifierIndex[identifierIndex.length - 1];
        this.indexInstructionIndex = identifierIndex.length + 1;

        const nowLvl = instruction.lvl;

        // si la precedente instruction est sur un autre etage en pop le dernier pour ne pas affichier la dialog
        if (currentLvl !== nowLvl) {
            this.mapManager.controls['level-control']._setLevel(this.SegmentsCoordinates[this.index].lvl, true);
            this.mapManager.simulationManager.changeLevel_simulation();
        }

        this.updateInstructionText(this.SegmentsCoordinates[this.index].instruction);
        this.updateCamera();
        this.mapManager.viewer.modeManager.modes['simulation']._update_simulation();
    }

    updateInstructionText(instruction) {
        this.mapManager.viewer.modeManager.modes['simulation']._update_simulation();

        if(instruction === undefined) instruction = this.SegmentsCoordinates[this.index].instruction;

        let identifier = 0;
        let identifierCounter = 1;
        for (const elt of this.SegmentsCoordinates) {
            if (elt.instruction.identifier !== identifier) {
                identifier = elt.instruction.identifier;
                if (identifier === instruction.identifier) {
                    $('span.simulation-step').text(`${translations['viewer_mode_simulation_step']}  ${identifierCounter} / ${this.nbStep}`)
                    break;
                }
                identifierCounter++;
            }
        }
    }

}

