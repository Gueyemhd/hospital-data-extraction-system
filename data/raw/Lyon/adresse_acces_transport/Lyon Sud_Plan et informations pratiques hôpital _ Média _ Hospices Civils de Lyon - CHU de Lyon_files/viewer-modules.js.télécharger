	add_Direction_SymbolLayer(varId,id){
		let _this = this;
		let layerId = `sweepin_${id}`;
        const haloLayerId = `sweepin_${id}-halo`;

        let src = _this.getSrcFromDataManager(layerId);
		if(!this._checkIfLayerExist(layerId)){
            this.map.addLayer({
                id: haloLayerId,
                source: {
                    type: 'geojson',
                    data: src,
                    generateId: true
                },
                type: 'circle',
                paint: {
                    'circle-radius': 30, // larger for halo effect
                    'circle-color': '#4285F4',
                    'circle-opacity': 0.6, // reduced opacity for halo effect
                    'circle-blur': 0.5, // blur for the halo
                    'circle-stroke-width': 0
                }
            });

            // Then add the main point layer ON TOP of the halo
            this.map.addLayer({
                id: layerId,
                source: {
                    type: 'geojson',
                    data: src,
                    generateId: true
                },
                type: 'circle',
                paint: {
                    'circle-radius': 15,
                    'circle-color': '#4285F4',
                    'circle-stroke-color': 'white',
                    'circle-stroke-width': 2,
                    'circle-opacity': 1,
                    'circle-blur': 0.1,
                    'circle-stroke-opacity': 1
                }
            });
        }

		if(this._checkIfLayerExist(layerId)){
			// _this.map.moveLayer(layerId,`sweepin_lvl_${this.mapManager.level}_walls`);
			_this.map.moveLayer(layerId);
			_this.map.moveLayer(haloLayerId, layerId);

			let filter = ['any',
					['!',["has", "level"]],
					['has','lvl_'+_this.mapManager.level],
					['has','lvl_all']
				];
			this.map.setFilter(layerId,filter);
            this.map.setFilter(haloLayerId,filter);
		}
	}

	getLayerFilter(){
		let _this = this;
		let filter =
			['all',
				["any",
					['!',['has','max-zoom']],
					["<", ['zoom'], ['get','max-zoom']]
				],
				["any",
					['!',['has','min-zoom']],
					[">=", ['zoom'], ['get','min-zoom']]
				]
			];
		return filter;
	}

