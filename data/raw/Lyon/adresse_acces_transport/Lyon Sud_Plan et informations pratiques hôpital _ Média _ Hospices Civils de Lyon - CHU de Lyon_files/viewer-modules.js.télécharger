                    'data-geometries': ipsTriggerInfo.geometries[a],
                    'data-geometries-levels': ipsTriggerInfo.geometriesLevels[a]
                });

                if (ipsTriggerInfo['ipsTriggerInfoIcon']) {
                    result.find('img').attr('src', ipsTriggerInfo['ipsTriggerInfoIcon']['icon']);
                } else {
                    result.find('img').attr('src', _this.site + '/ressources/front/js/viewers/icons/ips_triggers_icons/' + ipsTriggerInfo['icon'] + '.svg');
                }

                result.find('.infos .title').html(ipsTriggerInfo.name);
                result.find('.infos .text').html(displayLvl);


                // if(lvl === 'all'){
                //     poiId = 'all';
                //     poiName = translations['viewers_mode_search_outside-groupe-title'];
                // }


                if (pois[poiId] == undefined) {
                    pois[poiId] = {
                        "name": poiName,
                        "results": [],
                        "shortcuts": []
                    }
                }

                if (ipsTriggerInfo.type === "building") {
                    if (pois[poiId]['buildings'] === undefined) pois[poiId]['buildings'] = {};
                    if (pois[poiId]['buildings'][ipsTriggerInfo.id] === undefined) {
                        pois[poiId]['buildings'][ipsTriggerInfo.id] = {
                            "name": _this.viewer.dataManager.ipsTriggersInfos[ipsTriggerInfo.id].name,
                            "results": []
                        }
                    }
                }


                if(Object.keys(ipsTriggerInfo.parents).length !==0 || ipsTriggerInfo.type==="building"){
                    $.each(ipsTriggerInfo.parents, function (k,v) {

                        if(_this.viewer.dataManager.ipsTriggersInfos[k] != undefined){
                            if(pois[poiId]['buildings'] === undefined) pois[poiId]['buildings'] = {};
                            if(pois[poiId]['buildings'][k] === undefined){
                                pois[poiId]['buildings'][k] = {
                                    "name":_this.viewer.dataManager.ipsTriggersInfos[k].name,
                                    "results":[]
                                }
                            }
                            pois[poiId]['buildings'][k]['results'].push(result);
                        }
                    })
                } else {
                    if (!ipsTriggerInfo.shortcut && ipsTriggerInfo.alias == '') {
                        if (lvl === 'all') {

                            if (pois[poiId]['all'] === undefined) {
                                pois[poiId]['all'] = {
                                    "name": translations['viewers_mode_search_outside-groupe-title'],
                                    "results": []
                                }
                            }
                            pois[poiId]['all']['results'].push(result);

                        } else {
                            pois[poiId]['results'].push(result);
                        }
                    } else {
                        if (!ipsTriggerInfo.shortcut) {
                            if (pois[poiId]['buildings'] === undefined) pois[poiId]['buildings'] = {};
                            if (pois[poiId]['buildings'][ipsTriggerInfo.id]) {
                                pois[poiId]['buildings'][ipsTriggerInfo.id]['results'].push(result)
                            } else {
                                pois[poiId]['buildings'][ipsTriggerInfo.id] = {
                                    "name": _this.viewer.dataManager.ipsTriggersInfos[ipsTriggerInfo.id].name,
                                    "results": [result] // todo: ajouter le poi parent lui-même
                                }
                            }
                        }

                    }
                }

                if (ipsTriggerInfo.shortcut) {
                    pois[poiId]['shortcuts'].push(result);
                }
            }
            ;
        }
        ;

        for (var [key, poi] of Object.entries(pois)) {

            // Create poiGrpResult
            let resultGrpPoi = $(_this.resultGroupTemplate.html());
            resultGrpPoi.find('.group-name').html(poi.name);

            if (this.viewer.type != 'viewer-partner' && poi['buildings']) poi['buildings'] = Object.values(poi['buildings']).sort((a, b) => (a.name > b.name) ? 1 : ((b.name > a.name) ? -1 : 0))


            // Add shortcuts
            poi['shortcuts'].forEach((res) => {
                resultGrpPoi.find('.card-body:first').append(res[0].outerHTML);
            });

            // Add buildings

            poi['buildings'] = poi['buildings'] ? poi['buildings'] : {};
            poi['buildings'] = Object.values(poi['buildings']);
            poi['buildings'].sort(function (a, b) {
                return (a.name.localeCompare(b.name));
            });

            $.each(poi['buildings'], function (k, building) {

                let resultGrpPoiBuilding = $(_this.resultBuildingGroupTemplate.html());
                resultGrpPoiBuilding.find('.group-name').html(building.name);

                // Add building ipsTriggersInfos
                building['results'].forEach((res) => {
                    resultGrpPoiBuilding.find('.card-body:first').append(res[0].outerHTML);
