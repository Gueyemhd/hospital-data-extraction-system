      row.attr('data-lvl', instruction.level);
      row.find('img').attr('src', _this.site + "/vendors/mapbox/svg/" + instruction.icon + ".svg");
      let txt = instruction.instruction.charAt(0).toUpperCase() + instruction.instruction.slice(1);
      row.find('.title').text(txt);
