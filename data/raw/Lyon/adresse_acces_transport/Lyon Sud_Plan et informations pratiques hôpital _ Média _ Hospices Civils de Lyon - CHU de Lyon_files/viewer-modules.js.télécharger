        this.pitch = this.parameters['pitch'];
        this.bearing = this.parameters['bearing'];

        this.styleMapbox = this.parameters['style-mapbox'] ?? 1;

        this.mapboxAccessToken = this.parameters['mapbox-key'] ?? 'pk.eyJ1IjoiY2VyaXNlMjMiLCJhIjoiY2l5YmRlMmxsMDA2ejMycWprOW5mcnlubSJ9.J_1ohXFkAbwwwX-7--vaww';

