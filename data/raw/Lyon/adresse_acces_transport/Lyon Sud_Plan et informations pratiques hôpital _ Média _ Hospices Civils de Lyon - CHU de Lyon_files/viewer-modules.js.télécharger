    manageLocationmarker(){
        if(this.viewer.location){
            let b = this.map.getBounds();
            let bboxPolygon = [[b._ne.lng,b._sw.lat],[b._ne.lng,b._ne.lat],[b._sw.lng,b._ne.lat],[b._sw.lng,b._sw.lat],[b._ne.lng,b._sw.lat]];
            let locationIsInSight = turf.booleanPointInPolygon([this.viewer.location.lng,this.viewer.location.lat], turf.polygon([bboxPolygon]));

            locationIsInSight = (this.viewer.location.lvl == this.level && locationIsInSight);
            if(locationIsInSight){
                this.viewer.container.removeClass('location-out')
            } else{
                this.viewer.container.addClass('location-out')
            }

        }
    }

