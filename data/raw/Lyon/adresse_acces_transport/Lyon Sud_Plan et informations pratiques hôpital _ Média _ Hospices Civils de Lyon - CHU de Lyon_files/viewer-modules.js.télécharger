    /** Called after the loading of datas **/
    refreshDatas(){
        let _this = this;
        /* Set the min and max level */
        Object.keys(this.viewer.dataManager.levels).forEach(function(lvl) {
            lvl = parseInt(lvl) ;
            _this.min_level = (lvl < _this.min_level) || (_this.min_level === undefined) ? lvl : _this.min_level;
            _this.max_level = (lvl > _this.max_level) || (_this.max_level === undefined) ? lvl : _this.max_level;
        });
        if(_this.max_level !== undefined && _this.min_level !== undefined){
            /* Generate the levels of the level-control */
            this.controls['level-control']._generateOptions();
            /* Display the level-control */
            this.controls['level-control'].show();
        }
    }
    /** Called by the level-control after a select change event **/
    levelChangedEvent(){
        /* Propagate the "level changed" event to the render manager */

        // console.log('levelChangedEvent')
        this.renderManager._levelChangedEvent();
        this.manageLocationmarker();
    }

    /** Called by the mode, propagate the event to the render manager **/
    _feature_hovered_event(feature, applyToFeaturesIds = undefined){
        let _this = this;
        if(feature){
            _this.renderManager._set_feature_state_hover(feature, applyToFeaturesIds);
        }else{
            _this.renderManager._set_feature_state_hover(null);
        }
    }

    /** Called by the mode, propagate the event to the render manager and also to the mode itself **/
    _feature_selected_event(feature, applyToFeaturesIds = undefined){
        let _this = this;
        if(!feature || !_this.map.selectedFeature || _this.map.selectedFeature.id !== feature.id){
            _this.renderManager._set_feature_state_selected(feature, applyToFeaturesIds);
            _this.viewer.modeManager.mode._feature_selected_event(feature);
        }
        else if(feature && _this.map.selectedFeature && _this.map.selectedFeature.id === feature.id){
            _this.renderManager._set_feature_state_selected(feature, applyToFeaturesIds);
            _this.viewer.modeManager.mode._feature_selected_event(feature);
        }
    }
    /** Called by the renderManager after a _feature_selected_event(see above) , propagate the event to the mode **/
    _feature_unselected_event(feature){
        let _this = this;
        // console.log(feature)
        _this.viewer.modeManager.mode._feature_unselected_event(feature);
    }

    goTo(lvl,coordinates,marker= true, zoom = 18, removeGoToMarkers = true,bearing = null, pitch = null){
		this.controls['level-control']._setLevel(lvl);
		let options={};
		options['center'] = coordinates;
		if(zoom !== null) options['zoom'] = zoom;
		if(bearing !== null) options['bearing'] = bearing;
		if(pitch !== null) options['pitch'] = pitch;
		this.map.easeTo(options);
	    if(removeGoToMarkers){
	    	this.removeGoToMarkers();
	    }
	    if(marker === true){
		    var el = document.createElement('div');
        	el.dataset.level = lvl;
		    el.className = 'go-to-marker';
	  		new mapboxgl.Marker(el).setLngLat(coordinates).addTo(this.map);
	    }
	}
	removeGoToMarkers(){
		$('.go-to-marker').remove();
	}
}

'use strict';


class DataManager {

    constructor(viewer, parameters){
    	this.parameters = parameters;
        this.viewer = viewer;
		this.features = {}; // features stored by id
		this.sources = {}; // features stored by "type" => "id" , used by renderManager for rendering each component (areas,surfaces,walls,etc...)

        this.levels = new Int8Array(); // Numeric array containing "real" level (-2,-1,0,1,2,etc...) properly ordered

		this.displayLevels = {}; // Object containing key=value of a level ex: {-1="ss 1", -2="ss 2", 2="étage2"} (we need to use array+object because js doesn't handle key ordering properly)
		this.displayLevelsId = null; // id of the displayLevels list, can be "default" or the id of the display_level_area feature, this list can change depending on the center of the map

		this.levelAreas = {}; // display_level_area features stored by id

		this.appId = parameters.appId;

		this.partners = {};
		this.pois = {};
		this.ipsTriggersInfos = {};
		this.ipsTriggersInfoIcons = {};
		this.ipsTriggers = {};

		this.ipsProfiles = {};
		this.ipsProfile = undefined;

		this.poiId = parameters.poiId;
		this.partnerId = parameters.partnerId;
		this.geoJson = parameters.geoJson;
        this.inBox = [];
        this.indoors = [];

		this.viewer.dataManager = this;

		this.site = this.viewer.site === undefined ? '' : this.viewer.site;

		this.globalViewZoom = this.viewer.viewerParameters['global-view-zoom'] !== undefined ? this.viewer.viewerParameters['global-view-zoom'] : 17;
		this.farViewZoom = this.viewer.viewerParameters['far-view-zoom'] !== undefined ? this.viewer.viewerParameters['far-view-zoom'] : 15;

		this.main();
	}

    main(){

    	this._managePois(); // This function get partners (passed by parameters) and fill the "partners" & "pois" global variables

		this._manageIpsProfiles();

		this._loadMappingDatas(); // This function get the osm related data features (3d, display_levels area, etc...)

        this.applyObjectZoomProps();

		this._load_ips_triggers_datas(); // This function get the ipsTriggersInfos & ipsTriggers and fill the required global variables (ipsTriggersInfos & ipsTriggers)

		// Now that the data are loaded, we'll manage the displayLevel
		this.manageDisplayLevel({'lat':this.viewer.mapManager.lat,'lng':this.viewer.mapManager.lng});

		this.viewer.mapManager.refreshDatas();

    }

    _managePois(){
    	let _this = this;
		$.each(this.parameters.partners, function( key, partner ) {
			let pois ={};
			$.each(partner.pois, function( k, poi ) {

				if(poi.levels !== null && poi.ipdMapping !== ""){

					pois[poi.id] = poi.id;
					poi['partner'] = partner.id;
					_this.pois[poi.id] = poi;
					let feature = _this._create_geoJsonPoint_from_poi(poi);
					_this._addFeature(feature,'pois');
				}
			});
			partner['pois'] = pois;
			_this.partners[partner.id] = partner;
		});

		// Create feature for each pois




		// console.log(this)
	}
	_create_geoJsonPoint_from_poi(poi){

		let newGeoJsonPoint =
		{
			"id": poi['id'],
			"type": "Feature",
			"geometry": {
				"type": "Point",
				"coordinates": [poi.longitude,poi.latitude]
			},
			"properties": {
				"name":poi.name,
				"displayName":1,
				"icon": "pois",
				"min-zoom": 0,
				"max-zoom": this.farViewZoom,
				"level": 'all',
				"type": 'poi',
				"interactive": 1,
				"parameters": poi.parameters ? poi.parameters : {}

			}
		};

		return newGeoJsonPoint;

    }

    _manageIpsProfiles(){

		let selectedProfileRef = this.viewer.viewerParameters['ips-profile'];
		let selectedProfile = undefined;
		let _this = this;
		$.each(this.viewer.viewerParameters['ipsProfiles'], function(index, value){
			_this.ipsProfiles[value['id']] = value;
			if(value['isDefault']) _this.ipsProfile = value;
			if(value['ref'] == selectedProfileRef) selectedProfile = value;
		});
		if(_this.ipsProfile == undefined && Object.keys(_this.ipsProfiles) != 0) _this.ipsProfile = Object.values(_this.ipsProfiles)[0];

		if(selectedProfile){
			_this.ipsProfile = selectedProfile;
		}
	}
	_loadMappingDatas(){
        let _this = this;

        let url = null;

		_this._mapping_splitGeoJson(this.geoJson);

		// if(this.viewer.type === 'viewer-poi'){ url = this.viewer.site+'/viewers/get-mapping-datas?poiId='+Object.values(this.pois)[0].id+'&appId='+this.appId}
		// if(this.viewer.type === 'viewer-partner'){ url = this.viewer.site+'/viewers/get-mapping-datas?partnerId='+Object.values(this.partners)[0].id+'&appId='+this.appId}
		// if(this.viewer.type === 'viewer-api'){ url = this.viewer.site+'/viewers/get-mapping-datas?appId='+this.appId}
        // $.ajax({
		// 	url: url,
        //     data: {
		// 		'reload-data': this.viewer.reloadData,
		// 		'timestamp':new Date().getTime()
        //     },
		// 	async: false,
		// 	success: function(geoJson){
		// 	    geoJson = JSON.parse(geoJson);
		// 		_this._mapping_splitGeoJson(geoJson);
		// 		// Refresh the mapManager datas
		// 		// _this.viewer.mapManager.refreshDatas();
		// 	}
		// });
    }

    _mapping_splitGeoJson(geoJson){
		let _this = this;
		// Pre-processing of features

		// Get levelAreas
		_this._mapping_splitGeoJson_levelAreas(geoJson);

		// Parse features and dispatch them depending on their properties
		_this._mapping_splitFeatures(geoJson);

    }

    _mapping_splitGeoJson_levelAreas(geoJson){
    	let _this = this;
		$.each(geoJson.features, function( k, feature ) {
			// Get only display_level_area features
        	if(feature.properties && feature.properties.type && feature.properties.type === 'display_level_area' && feature.properties.data_level){
				feature.properties.displayLevels = {};
				let levels = feature.properties.data_level.split(";");
				$.each(levels, function( key, value ) {
					let a = value.split("=");
					feature.properties.displayLevels[a[0]] = a[1];  //Correct form, uncomment and remove line below after dev
				});
				_this.levelAreas[feature.id] = feature;
			}
		});
	}

    _mapping_splitFeatures(geoJson){
    	let _this = this;
		$.each(geoJson.features, function( k, v ) {
			_this._mapping_dispatchFeature(k,v);
		});
	}

    _mapping_dispatchFeature(k,v){
        let _this = this;
        if(v.properties){
            switch (true) {
				case v.properties.type === 'objectAllLevels' || v.properties.type === 'object':
					_this._mapping_feature_indoor(k,v);
					break;
                case v.properties.hasOwnProperty('indoor'):
                    _this._mapping_feature_indoor(k,v);
                    break;
                case v.properties.hasOwnProperty('ips'):
                    _this._mapping_feature_ips(k,v);
					break;
				case v.properties.hasOwnProperty('building'):
					_this._mapping_feature_building(k,v);
					break;
                default:
            }
        }
    }


    _mapping_feature_indoor(k,v){
        let _this = this;

        if(v.geometry.type === "Point" && (v.properties.type !== 'objectAllLevels' && v.properties.type !== 'object')) {
            return;
        }

		if(v.geometry.type == "LineString") {
			//console.log("CHECK:"+v.properties.id);
			return;
		}

        if(v.properties.type === 'object') {
            _this._mapping_objects_feature(k,v);
        }
        if(v.properties.type === 'objectAllLevels') {
            _this._mapping_objectsAllLevels_feature(k,v);
        }
		switch(v.properties.indoor){
			case 'surface':
                if(!v.properties.outdoor && v.properties.id.includes('way')){
                    this.indoors.push(v);
                }
				_this._mapping_feature_indoor_Surface(k,v);
				break;
			case 'wall':
				_this._mapping_feature_indoor_Wall(k,v);
				break;
			case 'area':
				if(v.properties.outdoor){
					_this._mapping_feature_indoor_Surface(k,v);
				}else{
					_this._mapping_feature_indoor_Area(k,v);
				}
				break;
			default:
		}
    }

    _mapping_objects_feature(k,v) {
        this.applyObjectZoomProps(k,v);
        this._addFeature(v, 'objects');
    }
    _mapping_objectsAllLevels_feature(k,v) {
        this.applyObjectZoomProps(k,v);
        this._addFeature(v, 'objectsAllLevels');
    }
    _mapping_feature_indoor_Surface(k,v){
		this._addFeature(v,'surfaces');
    }
    _mapping_feature_indoor_Wall(k,v){
		this._addFeature(v,'walls');
    }
    _mapping_feature_indoor_Area(k,v){
		this._addFeature(v,'areas');
    }
    _mapping_feature_ips(k,v){
    	// if(v.properties.type !== "display_level_area"){
		// 	this._addFeature(v,'ips');
		// }
      if(v.properties.amenity === 'hospital'){
        this.inBox.push(v);
        if(v.properties.min_level !== undefined && v.properties.max_level !== undefined){
          this.inBoxMaster = v;
        }
      }
    }
    _mapping_feature_building(k,v){
    	if(v.properties.hasOwnProperty('building:indoor')){
			this._addFeature(v,'buildings-indoor');
		}else{
			this._addFeature(v,'buildings');
		}
    }

	_addFeature(feature,type,lvl = undefined){
		let _this = this;

    	// The feature doesn't have properties, set it
		if(feature.properties === undefined) feature.properties = {};

		// The lvl is provided, add it to the feature properties
		if(lvl !== undefined) feature.properties.level = lvl;

		// The lvl isn't provided and the feature doesn't have an level property, set it level to "all"
		if(lvl === undefined && feature.properties.level === undefined) feature.properties.level = 'all';

		// Ensure that lvl is a string
		feature.properties.level = feature.properties.level.toString();

		let levels = feature.properties.level.split(';');
		// Split feature with multiple levels
		if(feature.properties.level.includes(';')) feature.properties.level = levels;

		$.each( levels, function( key, value ) {
			feature.properties['lvl_'+value] = true;
        });

		// The feature have ref so we need to split it into a properties "ipsProfiles"
		if(feature.properties.ref && typeof feature.properties.ref === 'string') feature.properties.ipsProfiles = feature.properties.ref.split(';');

		// If the feature doesn't have an id, we'll generate one (feature must have an id for working)
		if(feature.id === undefined) do{ feature.id = Math.random()*-1000;}while(this.features[feature.id] !== undefined);

		// if feature have height, we need to insure that it's a float
		if(feature.properties.height !== undefined) feature.properties.height = parseFloat(feature.properties.height);
		// if feature have base, we need to insure that it's a float
		if(feature.properties.base !== undefined) feature.properties.base = parseFloat(feature.properties.base);

		// feature must have min/max zoom properties set for being displayed in global / detailled view
		if(feature.properties['max-zoom'] === undefined) feature.properties['max-zoom'] = 24;
		if(feature.properties['min-zoom'] === undefined) feature.properties['min-zoom'] = this.farViewZoom;

		// set feature priority
		if(feature.properties['priority'] === undefined) feature.properties['priority'] = 1;

		// set feature interactive
		if(feature.properties['interactive'] === undefined) feature.properties['interactive'] = 0;


		// If the dataType doesn't exists, initialize it
		if(!this.sources[type]) this.sources[type] = {};

		// for each level add it to the correct source

		$.each( levels, function( key, lvl ) {
			// If the dataType level doesn't exists, initialize it
			if(!_this.sources[type][lvl]) _this.sources[type][lvl] = {};
			// Store the feature also in the dataType list
			_this.sources[type][lvl][feature.id] = feature;
        });

		// Store the feature in the data list
		this.features[feature.id] = feature;
	}

	getIpsTriggerDisplayLevel(ipsTrigger){
		let _this = this;

		if(ipsTrigger.level === 'all') ipsTrigger.displayLevel = 'all';
        let centerLngLat =[ipsTrigger.longitude,ipsTrigger.latitude];
        let point = turf.point(centerLngLat);
		$.each(_this.levelAreas,function(key,feature){
            if(turf.booleanWithin(point, feature.geometry)){
                let displayLevels = feature.properties.displayLevels;
                ipsTrigger.displayLevel = displayLevels[ipsTrigger.level] ? displayLevels[ipsTrigger.level] : ipsTrigger.displayLevel;
            }
        });
	}


