'use strict';

class RenderManager {
	constructor(mapManager){
		this.mapManager = mapManager;
		this.map = mapManager.map;
		this.mapManager.renderManager = this;
		this.directionLayers = {};
		this.viewer = this.mapManager.viewer;
		this.site = this.viewer.site == undefined ? '' : this.viewer.site;
		this.loaded = false;
		this.level = this.mapManager.level;
    this.SidePanelManager = this.viewer.sidePanelManager;
        this.routingColor = "#008fd5";
        if(this.viewer.viewerParameters['routing-color']){
            if(this.viewer.viewerParameters['routing-color'].length === 7)
                this.routingColor = this.viewer.viewerParameters['routing-color'];
        }
		this.loadParameters();

		this.main();
	}

	loadParameters(){
		this.parameters = this.viewer.viewerParameters['renderManager'] ?? {};
		this.parameters['maxIndoorZoom'] = this.parameters['maxIndoorZoom'] ?? 13;
		this.parameters['maxZoom'] = this.parameters['maxZoom'] ?? 13;


		let globalViewZoom = this.viewer.viewerParameters['global-view-zoom'] ? this.viewer.viewerParameters['global-view-zoom'] : 17;
		let farViewZoom = this.viewer.viewerParameters['far-view-zoom'] ? this.viewer.viewerParameters['far-view-zoom'] : 15;
		this.parameters['max-zoom'] = 24;
		this.parameters['min-zoom'] = 0;
		this.parameters['global-view-zoom'] = globalViewZoom;
		this.parameters['far-view-zoom'] = farViewZoom;
		this.parameters['min-view-zoom'] = 0;

		// console.log(this.parameters)
	}

	main(){
		let _this = this;
		this.init_loadIcons();
		this.map.on('load',function () {
			_this.loaded = true;
		})
		this.render(this.mapManager.level)
	}

	getLevels() {
		return this.parameters['levels'];
	}

	init_loadIcons(){
		let _this = this;
		_this.map.on('load', function () {
			$.each(_this.viewer.dataManager.ipsTriggersInfoIcons, function (k, v) {
				_this.map.loadImage(v.icon, function (error, image) {

					// If an error occurs, throw it.
					// if (error) throw error;
					if (error) return;

					// Add the image to the map style if it doesn't already exists
					if (!_this.map.hasImage(v.id + '-' + v.name)) {
						_this.map.addImage(v.id + '-' + v.name, image, {pixelRatio:10});
					}

				});
			});

			_this.map.loadImage(_this.site+'/ressources/front/js/viewers/icons/gps-device.png', function (error, image) {
					if (error) throw error;
					_this.map.addImage('direction-icon', image,{pixelRatio:0.75});
				}
			);

			_this.map.loadImage(_this.site+'/ressources/front/js/viewers/icons/pois.png', function (error, image) {
					if (error) throw error;
					_this.map.addImage('pois', image,{pixelRatio:10});
				}
			);

			_this.map.loadImage(_this.site+'/ressources/front/js/viewers/icons/default.png', function (error, image) {
					if (error) throw error;
					_this.map.addImage('default', image,{pixelRatio:10});
				}
			);
		});
	}


	render(){
		/** Mapbox Layers ordering **/
			// 3D mapping, in order: Surfaces | Walls | Areas | Buildings | Building_Indoor
			// IpsTriggers mapping in order: display_common | display-search_common | display | display-search | global
			// Direction mapping in order : direction-line | direction-point
		let _this = this;
		if(_this.map.loaded()){

			_this.render_3dMapping();
            _this.render_ModelObjects();
            _this.render_ModelObjectsAllLevels();

			if (!this.viewer.doNotRenderIpsTriggers) {
				_this.render_IpsTriggers();
				_this.render_Direction_Layers();
				_this.render_Location_Marker();
			}

			_this.manageLayers();

			_this.loaded = true;
		}else{
			setTimeout(function(e){
				_this.render();
			},200);
		}
	}


	manageLayers(){
		let lvl = this.mapManager.level;
		let _this = this;
		$.each(_this.map.getStyle().layers, function( index, layer ) {

			if(layer.id.startsWith(`sweepin_lvl`)){
				if(layer.id.startsWith(`sweepin_lvl_${lvl}_`) || layer.id.startsWith(`sweepin_lvl_all`)){
					_this.map.setLayoutProperty(layer.id, 'visibility', 'visible');
				}else{
					_this.map.setLayoutProperty(layer.id, 'visibility', 'none');
				}
			}
		});
	}

	render_3dMapping(){
		this.render_Surfaces();
		this.render_Walls();
		this.render_Areas();
		this.render_Buildings();
		this.render_Building_Indoor();
	}

    render_ModelObjects(visibility = "visible") {
		this.add_ModelObjectsLayer('objects','objects',visibility,1,this.parameters['maxIndoorZoom']);
	}
    render_ModelObjectsAllLevels(visibility = "visible") {
        this.add_ModelObjectsAllLevelsLayer('objectsAllLevels','objectsAllLevels',visibility,1,this.parameters['maxIndoorZoom']);
    }
	render_Areas(visibility = "visible"){
		this.add_3dMapping_FillExtrusionLayer('areas','areas',visibility,'#aaa',2,0,1,this.parameters['maxIndoorZoom']);
	}
	render_Surfaces(visibility = "visible"){
		this.add_3dMapping_FillExtrusionLayer('surfaces','surfaces',visibility,'#ccc',0,0,1,this.parameters['maxIndoorZoom']);
	}
	render_Walls(visibility = "visible"){
		this.add_3dMapping_FillExtrusionLayer('walls','walls',visibility,'#999',2,0,1,this.parameters['maxIndoorZoom']);
	}
	render_Buildings(visibility = "visible"){
		this.add_3dMapping_FillExtrusionLayer('buildings','buildings',visibility,'#999999',2,0,1,this.parameters['maxZoom']);
	}
	render_Building_Indoor(visibility = "visible"){
		this.add_3dMapping_FillExtrusionLayer('buildings-indoor','buildings-indoor',visibility,'#999',2,0,1,this.parameters['maxZoom'],this.parameters['maxIndoorZoom']);
	}
	render_Direction_LineLayer(visibility = "visible"){
		this.add_Direction_LineLayer('direction-line','direction-line',visibility);
	}
	render_Direction_IconLayer(visibility = "visible"){
		this.add_Direction_SymbolLayer('direction-point','direction-point');
	}

	render_IpsTriggers(visibility = "visible"){
		// this.add_IpsTriggers_SymbolLayer("ips-triggers-display_common","ips-triggers-display_common",visibility,"#FDFDFD",this.parameters['global-view-zoom'], this.parameters['max-zoom']);
		// this.add_IpsTriggers_SymbolLayer("ips-triggers-display-search_common","ips-triggers-display-search_common",visibility,"#FDFDFD",this.parameters['global-view-zoom'], this.parameters['max-zoom']);
		//
		// this.add_IpsTriggers_SymbolLayer("ips-triggers-display","ips-triggers-display",visibility,"#FDFDFD",this.parameters['global-view-zoom'], this.parameters['max-zoom']);
		// this.add_IpsTriggers_SymbolLayer("ips-triggers-display-search","ips-triggers-display-search",visibility,"#FDFDFD",this.parameters['global-view-zoom'], this.parameters['max-zoom']);
		// this.add_IpsTriggers_SymbolLayer("ips-triggers-global","ips-triggers-global",visibility,"#FDFDFD", this.parameters['far-view-zoom'], this.parameters['global-view-zoom']);


		this.add_IpsTriggers_SymbolLayer("ips-triggers","ips-triggers",visibility,"#FDFDFD",this.parameters['far-view-zoom'], this.parameters['max-zoom']);

		this.add_IpsTriggers_SymbolLayer("pois","pois",visibility,"#FDFDFD", this.parameters['min-view-zoom'], this.parameters['far-view-zoom']);
	}

	render_Direction_Markers(){
		let _this = this;
		// Hide or displays directions markers
		$.each($('.go-to-marker, .direction-end, .direction-start, .direction-go-from-lvl-up, .direction-go-from-lvl-down, .direction-go-to-lvl-up, .direction-go-to-lvl-down'), function( index, value ) {
			if($(value).data('level') === _this.mapManager.level || $(value).data('level') === 'all'){
				$(value).show();
			}else {
				$(value).hide();
			}
		});
	}

	render_Direction_Layers(){
		this.render_Direction_LineLayer();
		this.render_Direction_IconLayer();
		this.render_Direction_Markers();

		// this.map.moveLayer('direction-line',`sweepin_walls`);

		// _this.manageDirectionLayers();
		// _this.manageSimulationLayers();
	}

	_checkIfLayerExist(layerId){
		return this.map.getLayer(layerId) !== undefined ;
	}

	getSrcFromDataManager(type) {
		let src = {'type':'FeatureCollection','features':[]};
		if(this.viewer.dataManager.sources[type]) {
			if(this.viewer.dataManager.sources[type][this.viewer.mapManager.level]){
				src.features = src.features.concat(Object.values(this.viewer.dataManager.sources[type][this.viewer.mapManager.level]));
			}
			if(this.viewer.dataManager.sources[type]['all']){
				src.features = src.features.concat(Object.values(this.viewer.dataManager.sources[type]['all']));
			}
		}
		return src;
	}

	render_Location_Marker(){

		/** Location Marker **/
		if(this.viewer.location !== undefined){

			if(this.locationMarker === undefined){
				let el = document.createElement('div');
				el.className = 'location-marker';
				this.locationMarker = new mapboxgl.Marker(el).setLngLat([this.viewer.location.lng,this.viewer.location.lat]);
			}
			if(this.viewer.location.lvl === this.mapManager.level || this.viewer.location.lvl === 'all'){
				this.locationMarker.addTo(this.map);
			}else{
				this.locationMarker.remove();
			}
		}
	}

	_set_feature_state_hover(feature, applyToFeaturesIds = undefined, overlay = true){
		let _this = this;
		_this.map.getCanvas().style.cursor = '';
		if(_this.map.hoveredFeature){
			_this.map.setFeatureState({source: _this.map.hoveredFeature.source, id: _this.map.hoveredFeature.id}, { hover: false});
		}
		if(_this.map.hoveredFeaturesIds){
			$.each(_this.map.hoveredFeaturesIds, function(index, value){
				_this.map.setFeatureState({source: _this.map.hoveredFeature.source, id: value}, { hover: false});
			});
		}
		_this.map.hoveredFeature = null;
		_this.map.hoveredFeaturesIds = null;

		if(feature){
			if(overlay){
				_this.map.setFeatureState({source: feature.source, id: feature.id}, { hover: true});
				if(applyToFeaturesIds){
					$.each(applyToFeaturesIds, function(index, value){
						if(_this.map.hoveredFeaturesIds === null) _this.map.hoveredFeaturesIds = [];
						_this.map.hoveredFeaturesIds.push(value);
						_this.map.setFeatureState({source: feature.source, id: value}, { hover: true});
					});
				}
			}
			_this.map.hoveredFeature = feature;
			_this.map.getCanvas().style.cursor = 'pointer';
		}
	}


	_set_feature_state_selected(feature, applyToFeaturesIds = undefined){
		let _this = this;
		let previousSelectedFeature = _this.map.selectedFeature;
		let previousApplySelectedFeaturesIds = _this.map.selectedFeaturesIds;
		let nbSelected = _this.map.nbSelected;

		_this.map.selectedFeature = null;
		_this.map.selectedFeaturesIds = null;
		_this.map.nbSelected = null;

		_this.map.selectedFeature = feature;
		_this._set_feature_state_hover(feature, applyToFeaturesIds);

		if(previousSelectedFeature && (!feature || previousSelectedFeature.id !== feature.id)){
			_this.map.setFeatureState({source: previousSelectedFeature.source, id: previousSelectedFeature.id}, { selected: false});
			_this.mapManager._feature_unselected_event(previousSelectedFeature);
		}
		if(previousApplySelectedFeaturesIds){
			$.each(previousApplySelectedFeaturesIds, function(index, value){
				_this.map.setFeatureState({source: previousSelectedFeature.source, id: value}, { selected: false});
				_this.mapManager._feature_unselected_event(value);
			});
		}

		if(feature){
			_this.map.setFeatureState({source: feature.source, id: feature.id}, { selected: true});
			if(applyToFeaturesIds){
				$.each(applyToFeaturesIds, function(index, value){
					if(_this.map.selectedFeaturesIds === null){
						_this.map.selectedFeaturesIds = [];
					}
					if(value !== feature.id){
						_this.map.selectedFeaturesIds.push(value);
						_this.map.setFeatureState({source: feature.source, id: value}, { selected: true});
					}
				});
			}
			if(!previousSelectedFeature){
				_this.map.nbSelected = 1;
			}
			else{
				if(feature.id === previousSelectedFeature.id){
					_this.map.nbSelected = nbSelected+1;
				}
				else{
					_this.map.nbSelected = 1;
				}

			}
		}

	}

	_update_layer_src(layerId, src = undefined){
		src = src !== undefined ? src : this.getSrcFromDataManager(layerId);
		if(this._checkIfLayerExist(layerId)){
			let layer = this.map.getSource(layerId);
			layer.setData(src);
		}else{
			console.error(`${layerId} doesn't exists`);
		}
	}


	_levelChangedEvent(){
		let _this = this;
		this.level = _this.mapManager.level;
		this.render();
	}


	_set_layer_opacity(layer, opacity){
		opacity = (opacity === null && layer.old_opacity) ? layer.old_opacity : opacity;
		if(opacity === null) return false;
		switch (layer.type) {
			case "fill-extrusion":
				layer.old_opacity = layer.paint["fill-extrusion-opacity"];
				this.map.setPaintProperty(layer.id, "fill-extrusion-opacity", opacity);
				break;
			case "line":
				layer.old_opacity = layer.paint["line-opacity"];
				this.map.setPaintProperty(layer.id, "line-opacity", opacity);
				break;
			case "symbol":
				if(layer.id.includes("ips-triggers")){
					layer.old_opacity = layer.paint["icon-opacity"];
					this.map.setPaintProperty(layer.id, "icon-opacity", opacity);
					layer.old_opacity = layer.paint["text-opacity"];
					this.map.setPaintProperty(layer.id, "text-opacity", opacity);
				}
				break;
			default:
				break;
		}
	}

	////////////////////////////////////////////////////////////
	//////////////// MAPBOX LAYERS INITIALIZATION///////////////
	////////////////////////////////////////////////////////////

	add_3dMapping_FillExtrusionLayer(varId,id,visibility,color,height,base = 0,opacity = 1, minzoom = 12, maxzoom = 24){
		let _this = this;
		let layerId = `sweepin_lvl_${this.mapManager.level}_${id}`;
		let src = _this.getSrcFromDataManager(id);
		if(! this._checkIfLayerExist(layerId)){
			height += base;

			// let buffer = _this.viewer.showStyle ? 0 : 512;
			let buffer = 64;
			_this.map.addLayer({
				'id': layerId,
				'type': 'fill-extrusion',
				'interactive':true,
				'source': {
					'type': 'geojson',
					'data': src,
					'tolerance': 0,
					'buffer':buffer,
					'dynamic': false
				},
				'minzoom': minzoom,
				'maxzoom': maxzoom,
				'layout':{
					"visibility": visibility
				},
				'paint': {
					'fill-extrusion-vertical-gradient': false,
					'fill-extrusion-color':[
						"case",
						["has", "colour"],
						["get","colour"],
						color
					],
					'fill-extrusion-height':[
						"case",
						['has', 'height'],
						['get', 'height'],
						height
					],
					'fill-extrusion-base': [
						"case",
						["has", "base"],
						['get', 'base'],
						base
					],
					'fill-extrusion-opacity': opacity
				}
			});
		}


		if(this._checkIfLayerExist(layerId)){
			let filter = this.getLayerFilter();
			this.map.setFilter(layerId,filter);
		}
	}

	add_ModelObjectsLayer(varId, id, visibility, opacity = 1, minzoom = 12, maxzoom = 24) {
		let _this = this;
		let layerId = `sweepin_lvl_${this.mapManager.level}_${id}`;
		if(!this._checkIfLayerExist(layerId)){
			let src = _this.getSrcFromDataManager(id);
			_this.map.addLayer({
				'id': layerId,
				'type': 'model',
				'minzoom': minzoom,
				'maxzoom': maxzoom,
				'source': {
					'type': 'geojson',
					'data': src
				},
				'layout':{
					'visibility': visibility,
					'model-id': ['get', 'modelURI']
				},
				'paint': {
					'model-translation': ['get', 'translation'],
					'model-rotation': ['get', 'rotation'],
					'model-scale': ['get', 'scale'],
					'model-opacity': opacity
				}
			});
		}
		if(this._checkIfLayerExist(layerId)){
			let filter = this.getLayerFilter();
			let ref = _this.viewer.dataManager.ipsProfile ? _this.viewer.dataManager.ipsProfile.ref : '';
			let specificFilter = ['any',
				['!',["has", "ipsProfiles"]],
				['==',['get','ipsProfiles'], ''],
				["in", ref, ["get", "ipsProfiles"]],
			];
			filter.push(specificFilter)

			this.map.setFilter(layerId,filter);
		}
	}

